          "title": "Terminal (second key)",
          "keys": "MOD+T",
          "dispatcher": "exec",
          "args": "{{CMD_TERMINAL}}"
        },
        {
          "id": "terminal-ctrl-alt",
          "title": "Terminal (Ctrl+Alt+T)",
          "keys": "CTRL+ALT+T",
          "dispatcher": "exec",
          "args": "{{CMD_TERMINAL}}"
        },
        {
