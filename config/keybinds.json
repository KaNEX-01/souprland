          "title": "Next track",
          "keys": "MOD+SHIFT+N",
          "dispatcher": "exec",
          "args": "playerctl next",
          "flags": "l",
          "require": "HAS_AUDIO_TOOLS"
        },
        {
          "id": "media-prev-key",
          "title": "Previous track",
          "keys": "MOD+SHIFT+B",
          "dispatcher": "exec",
          "args": "playerctl previous",
          "flags": "l",
          "require": "HAS_AUDIO_TOOLS"
        },
        {
          "id": "media-play-key",
          "title": "Play/pause",
          "keys": "MOD+SHIFT+P",
          "dispatcher": "exec",
          "args": "playerctl play-pause",
          "flags": "l",
          "require": "HAS_AUDIO_TOOLS"
        },
        {
          "id": "volume-mute-key",
          "title": "Toggle mute",
          "keys": "MOD+SHIFT+M",
          "dispatcher": "exec",
          "args": "{{CMD_VOLUME_MUTE}}",
          "flags": "l",
          "require": "HAS_AUDIO_TOOLS || HAS_SWAYOSD"
        },
        {
          "id": "mic-mute-key",
          "title": "Toggle microphone mute",
          "keys": "MOD+ALT+M",
          "dispatcher": "exec",
          "args": "{{CMD_MIC_MUTE}}",
          "flags": "l",
          "require": "HAS_AUDIO_TOOLS || HAS_SWAYOSD"
        },
        {
          "id": "brightness-up",
          "title": "Brightness up",
          "keys": "XF86MonBrightnessUp",
          "dispatcher": "exec",
          "args": "{{CMD_BRIGHTNESS_UP}}",
          "flags": "el",
          "require": "HAS_BRIGHTNESS || HAS_SWAYOSD"
        },
        {
          "id": "brightness-down",
          "title": "Brightness down",
          "keys": "XF86MonBrightnessDown",
          "dispatcher": "exec",
          "args": "{{CMD_BRIGHTNESS_DOWN}}",
          "flags": "el",
          "require": "HAS_BRIGHTNESS || HAS_SWAYOSD"
        },
        {
          "id": "night-mode",
          "title": "Toggle night light",
          "keys": "MOD+ALT+N",
          "dispatcher": "exec",
          "args": "pgrep hyprsunset && pkill hyprsunset || hyprsunset -t {{NIGHT_TEMP}}",
          "require": "HAS_HYPRSUNSET"
        },
        {
          "id": "screen-shader",
          "title": "Screen filter menu",
          "keys": "MOD+SHIFT+G",
          "dispatcher": "exec",
          "args": "~/.config/hypr/scripts/shader.sh",
          "require": "HAS_HYPRLAND_EXTRAS"
        },
        {
          "id": "zoom-out",
          "title": "Zoom out",
          "keys": "MOD+minus",
          "dispatcher": "exec",
          "args": "hyprctl -q keyword cursor:zoom_factor $(hyprctl getoption cursor:zoom_factor | awk '/float/ {z=$2-0.3; print (z<1?1:z)}')",
          "flags": "e"
        },
        {
          "id": "zoom-in",
          "title": "Zoom in",
          "keys": "MOD+equal",
          "dispatcher": "exec",
          "args": "hyprctl -q keyword cursor:zoom_factor $(hyprctl getoption cursor:zoom_factor | awk '/float/ {print $2+0.3}')",
          "flags": "e"
        }
      ]
    }
  ]
}
