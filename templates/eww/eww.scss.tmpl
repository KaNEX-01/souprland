{{! require: HAS_EWW }}
{{! target: eww/eww.scss }}
/* Generated by hyprsetup.
 *
 * ASCII ONLY -- do NOT use non-ASCII characters in this file. If eww's SCSS
 * compiler (grass) sees a non-ASCII character in its input it prepends
 * `@charset "UTF-8";` to the output, which GTK's CSS parser does not know,
 * so every startup logs an "unknown @ rule" error. Hence comments here are
 * ASCII only.
 *
 * Font sizes are pre-multiplied by WIDGET_SCALE (QML side uses Item.scale
 * instead; GTK has no scale transform) -- see render.py:_widget_vars.
 * Box transparency is baked into the color (WIDGET_BG_CSS): GTK "opacity"
 * would fade the text along with the box. */
* {
  all: unset;
  font-family: "{{FONT_FAMILY}}";
}

.clock-box, .sysinfo-box, .battery-box, .calendar-box, .music-box,
.network-box, .volume-box, .brightness-box, .uptime-box, .disk-box,
.temperature-box, .worldclock-box, .kblayout-box, .fetch-mini-box,
.workspace-box {
  background-color: {{WIDGET_BG_CSS}};
  border: 2px solid {{HEX_ACCENT}};
  border-radius: {{WIDGET_RADIUS_VALUE}}px;
  padding: {{WIDGET_PAD_V}}px {{WIDGET_PAD_H}}px;
}

.clock-time {
  color: {{HEX_ACCENT}};
  font-size: {{WIDGET_FS_TITLE}}px;
  font-weight: bold;
}

.clock-date {
  color: {{HEX_SUBTEXT}};
  font-size: {{WIDGET_FS_SMALL}}px;
}

.sysinfo-row,
.battery-row,
.network-row,
.volume-row,
.brightness-row,
.disk-row,
.temperature-row,
.kblayout-row {
  color: {{HEX_FG}};
  font-size: {{WIDGET_FS_BODY}}px;
}

.calendar {
  color: {{HEX_FG}};
}

.music-row,
.uptime-row,
.worldclock-row,
.fetch-mini-row {
  color: {{HEX_FG}};
  font-size: {{WIDGET_FS_SMALL}}px;
}

.fetch-mini-host {
  color: {{HEX_ACCENT}};
  font-size: {{WIDGET_FS_BODY}}px;
  font-weight: bold;
}

.workspace-row {
  color: {{HEX_ACCENT}};
  font-size: {{WIDGET_FS_TITLE}}px;
  font-weight: bold;
}
