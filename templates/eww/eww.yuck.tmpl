{{! require: HAS_EWW }}
{{! target: eww/eww.yuck }}
;; generated by hyprsetup — only the window/definition blocks for the widgets
;; you picked on the Widget Sets page are included here.
;; To add a new widget, update templates/eww/eww.yuck.tmpl instead of editing
;; this file by hand — otherwise your change is lost on the next install.
;;
;; LAYERS: the :stacking value comes from the WIDGET_LAYER setting.
;;   bt (bottom) -> above the wallpaper, BELOW WINDOWS. On a tiling desktop
;;      the screen is almost always covered, so in practice widgets only
;;      show on an empty workspace.
;;   fg (top)    -> above windows. Not meant to stay open all the time, but to
;;      be toggled with MOD+W (hypr/scripts/widgets.sh).
;; This setting is the answer to "I turned the widgets on but see nothing".
;; :windowtype only matters on X11; on Wayland :stacking decides.
;;
;; :monitor comes from WIDGET_MONITOR (empty = 0 = first display); eww accepts
;; both an index and a display name ("DP-1").

{{#if HAS_WIDGET_CLOCK}}
(defwidget clock-widget []
  (box :orientation "vertical" :space-evenly false :class "clock-box"
    (label :class "clock-time" :text "${formattime(EWW_TIME, "%H:%M:%S")}")
    (label :class "clock-date" :text "${formattime(EWW_TIME, "%A, %d %B")}")))

(defwindow clock
           :monitor {{WIDGET_MONITOR_EWW}}
           :geometry (geometry :x "{{WG_CLOCK_X}}px"
                               :y "{{WG_CLOCK_Y}}px"
                               :width "{{WG_CLOCK_W}}px"
                               :height "{{WG_CLOCK_H}}px"
                               :anchor "{{WG_CLOCK_ANCHOR}}")
           :stacking "{{WIDGET_STACKING_EWW}}"
           :windowtype "desktop"
           :exclusive false
           :focusable false
  (clock-widget))
{{/if}}

{{#if HAS_WIDGET_SYSINFO}}
(defwidget sysinfo-widget []
  (box :orientation "vertical" :space-evenly true :class "sysinfo-box"
    (label :class "sysinfo-row" :text "CPU  ${round(EWW_CPU.avg, 0)}%")
    (label :class "sysinfo-row" :text "RAM  ${round(EWW_RAM.used_mem_perc, 0)}%")))

(defwindow sysinfo
           :monitor {{WIDGET_MONITOR_EWW}}
           :geometry (geometry :x "{{WG_SYSINFO_X}}px"
                               :y "{{WG_SYSINFO_Y}}px"
                               :width "{{WG_SYSINFO_W}}px"
                               :height "{{WG_SYSINFO_H}}px"
                               :anchor "{{WG_SYSINFO_ANCHOR}}")
           :stacking "{{WIDGET_STACKING_EWW}}"
           :windowtype "desktop"
           :exclusive false
           :focusable false
  (sysinfo-widget))
{{/if}}

{{#if HAS_WIDGET_BATTERY}}
;; Battery percentage is read from sysfs, NOT from eww's EWW_BATTERY "magic"
;; variable: on a machine without a battery EWW_BATTERY is an empty string and
;; field access on it (even with ?.) raised
;; "Failed to turn `` into a value of type json-value" on every redraw.
;; The Quickshell version reads the same path — both engines show the same
;; number; without a battery both quietly say "--".
(defpoll battery-capacity :interval "30s" :initial ""
  "bash -c 'cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1'")
(defpoll battery-status :interval "30s" :initial ""
  "bash -c 'cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n1'")
(defwidget battery-widget []
  (box :orientation "vertical" :space-evenly false :class "battery-box"
    (label :class "battery-row"
           :text {battery-capacity == "" ? "🔋 --" : "🔋 " + battery-capacity + "% " + battery-status})))

(defwindow battery
           :monitor {{WIDGET_MONITOR_EWW}}
           :geometry (geometry :x "{{WG_BATTERY_X}}px"
                               :y "{{WG_BATTERY_Y}}px"
                               :width "{{WG_BATTERY_W}}px"
                               :height "{{WG_BATTERY_H}}px"
                               :anchor "{{WG_BATTERY_ANCHOR}}")
           :stacking "{{WIDGET_STACKING_EWW}}"
           :windowtype "desktop"
           :exclusive false
           :focusable false
  (battery-widget))
{{/if}}

