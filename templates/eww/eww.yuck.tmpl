{{#if HAS_WIDGET_TEMPERATURE}}
;; Temperature is read from the script shared by both engines
;; (hyprsetup/cpu-temp.sh): /sys/class/thermal does not exist on every
;; machine — on AMD systems the sensor lives under /sys/class/hwmon, and this
;; widget stayed silently empty there.
(defpoll cpu-temperature :interval "10s" :initial ""
  "bash -c '$HOME/.config/hyprsetup/cpu-temp.sh'")
(defwidget temperature-widget []
  (box :orientation "vertical" :space-evenly false :class "temperature-box"
    (label :class "temperature-row"
           :text {cpu-temperature == "" ? "🌡 --" : "🌡 " + cpu-temperature + "°C"})))

(defwindow temperature
           :monitor {{WIDGET_MONITOR_EWW}}
           :geometry (geometry :x "{{WG_TEMPERATURE_X}}px"
                               :y "{{WG_TEMPERATURE_Y}}px"
                               :width "{{WG_TEMPERATURE_W}}px"
                               :height "{{WG_TEMPERATURE_H}}px"
                               :anchor "{{WG_TEMPERATURE_ANCHOR}}")
           :stacking "{{WIDGET_STACKING_EWW}}"
           :windowtype "desktop"
           :exclusive false
           :focusable false
  (temperature-widget))
{{/if}}

{{#if HAS_WIDGET_WORLDCLOCK}}
(defpoll clock-london :interval "30s" :initial "" "bash -c 'TZ=Europe/London date +%H:%M'")
(defpoll clock-tokyo :interval "30s" :initial "" "bash -c 'TZ=Asia/Tokyo date +%H:%M'")
(defpoll clock-newyork :interval "30s" :initial "" "bash -c 'TZ=America/New_York date +%H:%M'")
(defwidget worldclock-widget []
  (box :orientation "vertical" :space-evenly true :class "worldclock-box"
    (label :class "worldclock-row" :text "London  ${clock-london}")
    (label :class "worldclock-row" :text "Tokyo   ${clock-tokyo}")
    (label :class "worldclock-row" :text "New York ${clock-newyork}")))

(defwindow worldclock
           :monitor {{WIDGET_MONITOR_EWW}}
           :geometry (geometry :x "{{WG_WORLDCLOCK_X}}px"
                               :y "{{WG_WORLDCLOCK_Y}}px"
                               :width "{{WG_WORLDCLOCK_W}}px"
                               :height "{{WG_WORLDCLOCK_H}}px"
                               :anchor "{{WG_WORLDCLOCK_ANCHOR}}")
           :stacking "{{WIDGET_STACKING_EWW}}"
           :windowtype "desktop"
           :exclusive false
           :focusable false
  (worldclock-widget))
{{/if}}

{{#if HAS_WIDGET_KBLAYOUT}}
(defpoll kb-layout :interval "3s" :initial ""
  "bash -c 'hyprctl devices -j 2>/dev/null | jq -r \".keyboards[0].active_keymap // empty\"'")
(defwidget kblayout-widget []
  (box :orientation "vertical" :space-evenly false :class "kblayout-box"
    ;; The layout name can be long ("English (US, intl., with dead keys)") and
    ;; when it did not fit, the screen showed "English (…"; the part before the
    ;; parenthesis is distinctive enough.
    (label :class "kblayout-row" :limit-width 16
           :text {kb-layout == "" ? "⌨ --"
                  : "⌨ " + replace(kb-layout, " *\\(.*", "")})))

(defwindow kblayout
           :monitor {{WIDGET_MONITOR_EWW}}
           :geometry (geometry :x "{{WG_KBLAYOUT_X}}px"
                               :y "{{WG_KBLAYOUT_Y}}px"
                               :width "{{WG_KBLAYOUT_W}}px"
                               :height "{{WG_KBLAYOUT_H}}px"
                               :anchor "{{WG_KBLAYOUT_ANCHOR}}")
           :stacking "{{WIDGET_STACKING_EWW}}"
           :windowtype "desktop"
           :exclusive false
           :focusable false
  (kblayout-widget))
{{/if}}

