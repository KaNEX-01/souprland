{{#if HAS_WIDGET_MUSIC}}
;; playerctl's "--format" flag uses its own double-curly-brace field names
;; (artist/title) — hyprsetup's template engine uses the same double-brace
;; syntax, so --format is NOT used here (every {{ }} in this file is
;; processed by hyprsetup first). Instead, artist/title are fetched separately
;; as plain subcommands with "playerctl metadata artist" / "playerctl metadata
;; title" and joined in the shell.
(defpoll music-now-playing :interval "3s" :initial ""
  "bash -c 'a=$(playerctl metadata artist 2>/dev/null); t=$(playerctl metadata title 2>/dev/null); [ -n \"$t\" ] && echo \"$a - $t\" || echo \"\"'")
(defwidget music-widget []
  (box :orientation "vertical" :space-evenly false :class "music-box"
    (label :class "music-row" :limit-width 30
           :text {music-now-playing == "" ? "▷ Nothing playing" : music-now-playing})))

(defwindow music
           :monitor {{WIDGET_MONITOR_EWW}}
           :geometry (geometry :x "{{WG_MUSIC_X}}px"
                               :y "{{WG_MUSIC_Y}}px"
                               :width "{{WG_MUSIC_W}}px"
                               :height "{{WG_MUSIC_H}}px"
                               :anchor "{{WG_MUSIC_ANCHOR}}")
           :stacking "{{WIDGET_STACKING_EWW}}"
           :windowtype "desktop"
           :exclusive false
           :focusable false
  (music-widget))
{{/if}}

{{#if HAS_WIDGET_NETWORK}}
(defpoll network-status :interval "5s" :initial ""
  "nmcli -t -f NAME connection show --active 2>/dev/null | head -1")
(defwidget network-widget []
  (box :orientation "vertical" :space-evenly false :class "network-box"
    (label :class "network-row"
           :text {network-status == "" ? "󰤭 Not connected" : "󰤨 " + network-status})))

(defwindow network
           :monitor {{WIDGET_MONITOR_EWW}}
           :geometry (geometry :x "{{WG_NETWORK_X}}px"
                               :y "{{WG_NETWORK_Y}}px"
                               :width "{{WG_NETWORK_W}}px"
                               :height "{{WG_NETWORK_H}}px"
                               :anchor "{{WG_NETWORK_ANCHOR}}")
           :stacking "{{WIDGET_STACKING_EWW}}"
           :windowtype "desktop"
           :exclusive false
           :focusable false
  (network-widget))
{{/if}}

;; ==========================================================================
;; The nine widgets below used to exist ONLY on the Quickshell side: their
;; files sat under presets/widget/ and their switches showed in the UI, but
;; the default engine (eww) did not know them, so nothing happened when they
;; were turned on. Data sources match the Quickshell ones exactly (see
;; templates/quickshell/shell.qml.tmpl) — both engines show the same widget
;; with the same number.
;; ==========================================================================

{{#if HAS_WIDGET_VOLUME}}
(defpoll volume-level :interval "2s" :initial ""
  ;; CAREFUL: do NOT use ${...} in the command string — yuck takes it for its
  ;; own interpolation syntax and fails to parse, and a single bad line brings
  ;; down the WHOLE config (no widget opens).
  "bash -c 'm=$(pamixer --get-mute 2>/dev/null); v=$(pamixer --get-volume 2>/dev/null); if [ \"$m\" = \"true\" ]; then echo muted; else echo \"$v\"; fi'")
(defwidget volume-widget []
  (box :orientation "vertical" :space-evenly false :class "volume-box"
    (label :class "volume-row"
           :text {volume-level == "muted" ? "󰝟 Muted" : "󰕾 " + volume-level + "%"})))

(defwindow volume
           :monitor {{WIDGET_MONITOR_EWW}}
           :geometry (geometry :x "{{WG_VOLUME_X}}px"
                               :y "{{WG_VOLUME_Y}}px"
                               :width "{{WG_VOLUME_W}}px"
                               :height "{{WG_VOLUME_H}}px"
                               :anchor "{{WG_VOLUME_ANCHOR}}")
           :stacking "{{WIDGET_STACKING_EWW}}"
           :windowtype "desktop"
           :exclusive false
           :focusable false
  (volume-widget))
{{/if}}

{{#if HAS_WIDGET_BRIGHTNESS}}
(defpoll brightness-level :interval "5s" :initial ""
  "bash -c 'brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d %'")
(defwidget brightness-widget []
  (box :orientation "vertical" :space-evenly false :class "brightness-box"
    (label :class "brightness-row"
           :text {brightness-level == "" ? "󰃞 --" : "󰃞 " + brightness-level + "%"})))

(defwindow brightness
           :monitor {{WIDGET_MONITOR_EWW}}
           :geometry (geometry :x "{{WG_BRIGHTNESS_X}}px"
                               :y "{{WG_BRIGHTNESS_Y}}px"
                               :width "{{WG_BRIGHTNESS_W}}px"
                               :height "{{WG_BRIGHTNESS_H}}px"
                               :anchor "{{WG_BRIGHTNESS_ANCHOR}}")
           :stacking "{{WIDGET_STACKING_EWW}}"
           :windowtype "desktop"
           :exclusive false
           :focusable false
  (brightness-widget))
{{/if}}

