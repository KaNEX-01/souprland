{{! require: DESKTOP_TERMINAL }}
{{! target: xdg-terminals.list }}
# xdg-terminals.list — generated by hyprsetup
#
# Decides which terminal anything that says "Open in terminal" launches (file
# manager, Terminal=true in .desktop entries, xdg-terminal-exec).
# mimeapps.list cannot make a terminal the default — terminals have no MIME
# type — so freedesktop defines a separate file for it.
#
# The source is TERMINAL in settings.conf; the GUI that opens the install
# window reads the same value (see python/hyprsetup/gui/app.py →
# _resolve_terminal), so the terminal opened during installation is the same
# one MOD+Return opens afterwards.
{{DESKTOP_TERMINAL}}
