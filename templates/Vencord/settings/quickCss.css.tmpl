{{! require: HAS_DISCORD_THEME }}
/*
 * quickCss.css — Discord (Vencord / Equicord / Vesktop) theme
 * generated by hyprsetup · theme: {{THEME}}
 *
 * Vencord reads this file automatically and applies it as soon as it is saved;
 * no Discord restart needed. "Enable Custom CSS" must be on in its settings.
 *
 * Manual edits are lost the next time the script runs.
 */

/* Override Discord's own variables — instead of writing per-component
   selectors (Discord changes class names on every update, so that is fragile)
   we hook into the theme's variable layer. */
.theme-dark,
.theme-light {
    --background-primary: {{HEX_BG}};
    --background-secondary: {{HEX_BG_DARK}};
    --background-secondary-alt: {{HEX_BG_DARK}};
    --background-tertiary: {{HEX_BG_DARK}};
    --background-accent: {{HEX_ACCENT}};
    --background-floating: {{HEX_SURFACE}};

    --channeltextarea-background: {{HEX_SURFACE}};
    --background-modifier-hover: {{HEX_SURFACE}};
    --background-modifier-active: {{HEX_SURFACE}};
    --background-modifier-selected: {{HEX_SURFACE}};

    --text-normal: {{HEX_FG}};
    --text-muted: {{HEX_SUBTEXT}};
    --text-link: {{HEX_ACCENT}};
    --header-primary: {{HEX_FG}};
    --header-secondary: {{HEX_SUBTEXT}};
    --interactive-normal: {{HEX_SUBTEXT}};
    --interactive-hover: {{HEX_FG}};
    --interactive-active: {{HEX_FG}};
    --interactive-muted: {{HEX_SURFACE}};

    --brand-experiment: {{HEX_ACCENT}};
    --brand-experiment-560: {{HEX_ACCENT}};
    --button-positive-background: {{HEX_GREEN}};
    --button-danger-background: {{HEX_RED}};

    --scrollbar-thin-thumb: {{HEX_SURFACE}};
    --scrollbar-auto-thumb: {{HEX_SURFACE}};
    --scrollbar-auto-track: {{HEX_BG_DARK}};
}

/* Code blocks use the same monospace family as the terminal. */
code,
pre {
    font-family: "{{FONT_MONO}}", monospace !important;
}
