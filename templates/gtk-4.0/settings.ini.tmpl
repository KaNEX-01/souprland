# settings.ini — GTK4 · theme: {{THEME}} · generated by hyprsetup
#
# GTK4/libadwaita apps do not use theme engines; colors come from the accent
# variables in the gtk.css next to this file.
#
# Note: gtk-application-prefer-dark-theme is deliberately NOT here. That key
# is a GTK3 leftover; libadwaita apps read dark/light mode through
# AdwStyleManager instead, which reads the org.gnome.desktop.interface
# color-scheme gsettings key (set by modules/theme.sh:theme_apply_color_scheme
# from COLOR_SCHEME, unconditionally and independent of component selection).
# If both are set here, libadwaita apps print a "Using
# GtkSettings:gtk-application-prefer-dark-theme ... unsupported" warning at
# startup.

[Settings]
{{#if SYSTEM_IS_LIGHT}}
gtk-theme-name=Adwaita
{{/if}}
{{#unless SYSTEM_IS_LIGHT}}
gtk-theme-name=Adwaita-dark
{{/unless}}
gtk-icon-theme-name={{ICON_THEME_NAME}}
gtk-cursor-theme-name={{CURSOR_THEME}}
gtk-cursor-theme-size={{CURSOR_SIZE}}
gtk-font-name={{FONT_FAMILY}} {{FONT_SIZE}}
gtk-enable-animations=1
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
