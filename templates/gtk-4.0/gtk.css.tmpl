/* gtk.css — GTK4 / libadwaita colors · theme: {{THEME}}
 *
 * libadwaita apps (Nautilus, Settings, GNOME tools, nwg-look…) do not use
 * GTK theme engines; they take their colors from these variables.
 * generated by hyprsetup — for your own additions, create
 * ~/.config/gtk-4.0/gtk-custom.css and @import it at the bottom.
 */

@define-color accent_color {{HEX_ACCENT}};
@define-color accent_bg_color {{HEX_ACCENT}};
@define-color accent_fg_color {{HEX_BG_DARK}};

@define-color destructive_color {{HEX_RED}};
@define-color destructive_bg_color {{HEX_RED}};
@define-color destructive_fg_color {{HEX_BG_DARK}};

@define-color success_color {{HEX_GREEN}};
@define-color success_bg_color {{HEX_GREEN}};
@define-color success_fg_color {{HEX_BG_DARK}};

@define-color warning_color {{HEX_YELLOW}};
@define-color warning_bg_color {{HEX_YELLOW}};
@define-color warning_fg_color {{HEX_BG_DARK}};

@define-color error_color {{HEX_RED}};
@define-color error_bg_color {{HEX_RED}};
@define-color error_fg_color {{HEX_BG_DARK}};

@define-color window_bg_color {{HEX_BG}};
@define-color window_fg_color {{HEX_FG}};
@define-color view_bg_color {{HEX_BG_DARK}};
@define-color view_fg_color {{HEX_FG}};
@define-color headerbar_bg_color {{HEX_SURFACE}};
@define-color headerbar_fg_color {{HEX_FG}};
@define-color headerbar_border_color {{HEX_SURFACE}};
@define-color headerbar_backdrop_color @window_bg_color;
@define-color headerbar_shade_color rgba(0, 0, 0, 0.36);

@define-color card_bg_color {{HEX_SURFACE}};
@define-color card_fg_color {{HEX_FG}};
@define-color card_shade_color rgba(0, 0, 0, 0.36);

@define-color dialog_bg_color {{HEX_SURFACE}};
@define-color dialog_fg_color {{HEX_FG}};

@define-color popover_bg_color {{HEX_SURFACE}};
@define-color popover_fg_color {{HEX_FG}};

@define-color sidebar_bg_color {{HEX_BG_DARK}};
@define-color sidebar_fg_color {{HEX_FG}};
@define-color sidebar_backdrop_color {{HEX_BG}};
@define-color sidebar_border_color rgba(0, 0, 0, 0.36);
@define-color sidebar_shade_color rgba(0, 0, 0, 0.36);

@define-color thumbnail_bg_color {{HEX_SURFACE}};
@define-color thumbnail_fg_color {{HEX_FG}};

@define-color shade_color rgba(0, 0, 0, 0.36);
@define-color scrollbar_outline_color rgba(0, 0, 0, 0.5);

/* Make window corners match Hyprland's rounding */
window.csd {
    border-radius: {{ROUNDING}}px;
}
