{{! require: TERMINAL==ghostty && HAS_GHOSTTY }}
# ghostty config — theme: {{THEME}} · generated by hyprsetup
# Docs: ghostty +show-config --default --docs

font-family = {{FONT_MONO}}
font-size = {{TERM_FONT_SIZE_VALUE}}
adjust-cell-height = 10%

background = {{COL_BG}}
foreground = {{COL_FG}}
cursor-color = {{COL_ACCENT}}
cursor-style = {{TERM_CURSOR_GHOSTTY}}
cursor-style-blink = {{TERM_BLINK}}
selection-background = {{COL_SURFACE}}
selection-foreground = {{COL_FG}}

# ANSI paleti
palette = 0={{HEX_BG_DARK}}
palette = 1={{HEX_RED}}
palette = 2={{HEX_GREEN}}
palette = 3={{HEX_YELLOW}}
palette = 4={{HEX_ACCENT}}
palette = 5={{HEX_ACCENT2}}
palette = 6={{HEX_CYAN}}
palette = 7={{HEX_FG}}
palette = 8={{HEX_SUBTEXT}}
palette = 9={{HEX_RED}}
palette = 10={{HEX_GREEN}}
palette = 11={{HEX_YELLOW}}
palette = 12={{HEX_ACCENT}}
palette = 13={{HEX_ACCENT2}}
palette = 14={{HEX_CYAN}}
palette = 15={{HEX_FG}}

scrollback-limit = {{TERM_SCROLLBACK_BYTES}}
background-opacity = {{TERM_OPACITY_VALUE}}
background-blur-radius = {{BLUR_SIZE}}
window-padding-x = {{TERM_PADDING_VALUE}}
window-padding-y = {{TERM_PADDING_VALUE}}
{{#if TERM_BG_ON}}
# Background image (Ghostty 1.2+); the image darkens as opacity drops.
background-image = {{TERM_BG_PATH}}
background-image-fit = {{TERM_BG_GHOSTTY_FIT}}
background-image-position = {{TERM_BG_GHOSTTY_POSITION}}
background-image-repeat = {{TERM_BG_GHOSTTY_REPEAT}}
background-image-opacity = {{TERM_BG_GHOSTTY_OPACITY}}
{{/if}}
window-decoration = false
window-theme = ghostty
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
shell-integration = detect
