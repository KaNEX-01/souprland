{{! require: HAS_YAZI }}
# yazi theme: {{THEME}} · generated by hyprsetup
# Docs: https://yazi-rs.github.io/docs/configuration/theme

[manager]
cwd = { fg = "{{HEX_CYAN}}" }

hovered         = { fg = "{{HEX_BG_DARK}}", bg = "{{HEX_ACCENT}}" }
preview_hovered = { underline = true }

find_keyword  = { fg = "{{HEX_YELLOW}}", italic = true }
find_position = { fg = "{{HEX_ACCENT2}}", bg = "reset", italic = true }

marker_copied   = { fg = "{{HEX_GREEN}}",  bg = "{{HEX_GREEN}}" }
marker_cut      = { fg = "{{HEX_RED}}",    bg = "{{HEX_RED}}" }
marker_marked   = { fg = "{{HEX_CYAN}}",   bg = "{{HEX_CYAN}}" }
marker_selected = { fg = "{{HEX_YELLOW}}", bg = "{{HEX_YELLOW}}" }

count_copied   = { fg = "{{HEX_BG_DARK}}", bg = "{{HEX_GREEN}}" }
count_cut      = { fg = "{{HEX_BG_DARK}}", bg = "{{HEX_RED}}" }
count_selected = { fg = "{{HEX_BG_DARK}}", bg = "{{HEX_YELLOW}}" }

border_symbol = "│"
border_style  = { fg = "{{HEX_SUBTEXT}}" }

[mode]
normal_main = { fg = "{{HEX_BG_DARK}}", bg = "{{HEX_ACCENT}}", bold = true }
normal_alt  = { fg = "{{HEX_ACCENT}}",  bg = "{{HEX_SURFACE}}" }
select_main = { fg = "{{HEX_BG_DARK}}", bg = "{{HEX_GREEN}}",  bold = true }
select_alt  = { fg = "{{HEX_GREEN}}",   bg = "{{HEX_SURFACE}}" }
unset_main  = { fg = "{{HEX_BG_DARK}}", bg = "{{HEX_ACCENT2}}", bold = true }
unset_alt   = { fg = "{{HEX_ACCENT2}}", bg = "{{HEX_SURFACE}}" }

[status]
progress_label  = { fg = "{{HEX_FG}}", bold = true }
progress_normal = { fg = "{{HEX_ACCENT}}", bg = "{{HEX_SURFACE}}" }
progress_error  = { fg = "{{HEX_RED}}",    bg = "{{HEX_SURFACE}}" }

[input]
border   = { fg = "{{HEX_ACCENT}}" }
title    = {}
value    = {}
selected = { reversed = true }

[pick]
border   = { fg = "{{HEX_ACCENT}}" }
active   = { fg = "{{HEX_ACCENT2}}", bold = true }
inactive = {}

[confirm]
border     = { fg = "{{HEX_ACCENT}}" }
title      = { fg = "{{HEX_ACCENT}}" }
content    = {}
list       = {}
btn_yes    = { reversed = true }
btn_no     = {}

[tasks]
border  = { fg = "{{HEX_ACCENT}}" }
title   = {}
hovered = { fg = "{{HEX_ACCENT2}}", underline = true }

[which]
mask            = { bg = "{{HEX_SURFACE}}" }
cand            = { fg = "{{HEX_CYAN}}" }
rest            = { fg = "{{HEX_SUBTEXT}}" }
desc            = { fg = "{{HEX_ACCENT2}}" }
separator       = "  "
separator_style = { fg = "{{HEX_SUBTEXT}}" }

[help]
on      = { fg = "{{HEX_CYAN}}" }
run     = { fg = "{{HEX_ACCENT2}}" }
hovered = { reversed = true, bold = true }
footer  = { fg = "{{HEX_SURFACE}}", bg = "{{HEX_FG}}" }

[filetype]
rules = [
    { mime = "image/*", fg = "{{HEX_YELLOW}}" },
    { mime = "video/*", fg = "{{HEX_ACCENT2}}" },
    { mime = "audio/*", fg = "{{HEX_ACCENT2}}" },
    { mime = "application/zip", fg = "{{HEX_RED}}" },
    { mime = "application/gzip", fg = "{{HEX_RED}}" },
    { mime = "application/x-tar", fg = "{{HEX_RED}}" },
    { mime = "application/x-7z-compressed", fg = "{{HEX_RED}}" },
    { mime = "application/pdf", fg = "{{HEX_RED}}" },
    { name = "*/", fg = "{{HEX_ACCENT}}" },
    { name = "*", fg = "{{HEX_FG}}" },
]
