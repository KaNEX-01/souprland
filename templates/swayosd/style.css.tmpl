{{! require: HAS_SWAYOSD }}
/*
 * swayosd style.css — volume / brightness / CapsLock indicator
 * generated by hyprsetup · theme: {{THEME}}
 *
 * Manual edits are lost the next time the script runs
 * (the old version is backed up automatically).
 */

window#osd {
    padding: 12px 20px;
    border-radius: {{BAR_RADIUS}}px;
    border: 1px solid {{HEX_SURFACE}};
    background-color: alpha({{HEX_BG_DARK}}, {{BAR_OPACITY}});
    /* Same font family as the bar, so the indicator does not look "detached". */
    font-family: "{{FONT_FAMILY}}";
}

window#osd image {
    color: {{HEX_ACCENT}};
}

window#osd label {
    color: {{HEX_FG}};
    font-size: {{FONT_SIZE}}pt;
}

/* Filling bar */
window#osd progressbar {
    min-height: 6px;
    border-radius: 999px;
    background-color: {{HEX_SURFACE}};
}

window#osd progressbar trough {
    min-height: 6px;
    border-radius: 999px;
    border: none;
    background-color: {{HEX_SURFACE}};
}

window#osd progressbar progress {
    min-height: 6px;
    border-radius: 999px;
    background-color: {{HEX_ACCENT}};
}

/* Muted / off state: dim text color instead of the accent.
   Otherwise the "muted" and "sound on" indicators would look the same. */
window#osd.muted progressbar progress,
window#osd.muted image {
    color: {{HEX_SUBTEXT}};
    background-color: {{HEX_SUBTEXT}};
}
