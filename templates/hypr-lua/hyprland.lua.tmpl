            render_titles = {{GROUPBAR_RENDER_TITLES}},
            rounding = {{GROUPBAR_ROUNDING}},
            gradient_rounding = {{GROUPBAR_ROUNDING}},
            text_color = "{{GROUPBAR_TEXT}}",
            text_color_inactive = "{{GROUPBAR_TEXT_INACTIVE}}",
            col = {
                active = "{{RGBA_ACCENT}}",
                inactive = "{{RGBA_SURFACE}}",
                locked_active = "{{RGBA_RED}}",
                locked_inactive = "{{RGBA_SURFACE}}",
            },
        },
    },

    animations = {
        enabled = {{ANIMATIONS}},
    },
})

-- --------------------------------------------------------- animations ----
{{ANIMATION_LINES}}

-- ------------------------------------------------------------ layouts ----
hl.config({
    dwindle = {
        -- Note: 'pseudotile' is no longer an option, only a dispatcher —
        -- used via the MOD+ALT+P keybinding in keybinds.lua.
        preserve_split = {{DWINDLE_PRESERVE_SPLIT}},
        smart_split = {{DWINDLE_SMART_SPLIT}},
        smart_resizing = {{DWINDLE_SMART_RESIZING}},
    },

    master = {
        new_status = "{{MASTER_NEW_STATUS}}",
        mfact = {{MASTER_MFACT}},
    },

    -- -------------------------------------------------------------- input ----
    input = {
        kb_layout = "{{KB_LAYOUT}}",
        kb_variant = "{{KB_VARIANT}}",
        kb_options = "{{KB_OPTIONS}}",

        repeat_delay = {{REPEAT_DELAY}},
        repeat_rate = {{REPEAT_RATE}},
        numlock_by_default = {{NUMLOCK}},

        follow_mouse = {{FOLLOW_MOUSE}},
        sensitivity = {{SENSITIVITY}},
{{#if ACCEL_PROFILE}}
        accel_profile = "{{ACCEL_PROFILE}}",
{{/if}}
        off_window_axis_events = {{OFF_WINDOW_AXIS_EVENTS}},

        touchpad = {
            natural_scroll = {{NATURAL_SCROLL}},
            tap_to_click = {{TOUCHPAD_TAP}},
            disable_while_typing = {{TOUCHPAD_DWT}},
            clickfinger_behavior = {{TOUCHPAD_CLICKFINGER}},
            scroll_factor = {{TOUCHPAD_SCROLL_FACTOR}},
        },
    },

    -- -------------------------------------------------------- keybindings ---
    binds = {
        scroll_event_delay = {{SCROLL_EVENT_DELAY}},
        hide_special_on_workspace_change = {{HIDE_SPECIAL_ON_WS_CHANGE}},
    },

    -- ------------------------------------------------------------ cursor -----
    cursor = {
        no_hardware_cursors = {{NO_HARDWARE_CURSORS}},
        inactive_timeout = {{CURSOR_INACTIVE_TIMEOUT}},
        hotspot_padding = {{CURSOR_HOTSPOT_PADDING}},
        hide_on_key_press = false,
        sync_gsettings_theme = true,
    },

    -- -------------------------------------------------------------- misc -----
    misc = {
        disable_hyprland_logo = true,
        disable_splash_rendering = true,
        -- The script writes the config to many files in a row and triggers
        -- its own reload at the end; Hyprland's inotify-based auto reload can
        -- catch a half-written file during that and replace the config with
        -- its own STUB. So it is kept off — manual reload with MOD+CTRL+R is
        -- unaffected.
        disable_autoreload = true,
        force_default_wallpaper = 0,
        background_color = "{{RGBA_BG_DARK}}",

        vrr = {{VRR}},

        focus_on_activate = {{FOCUS_ON_ACTIVATE}},
        animate_manual_resizes = {{ANIMATE_MANUAL_RESIZES}},
        mouse_move_enables_dpms = {{DPMS_ON_INPUT}},
        key_press_enables_dpms = {{DPMS_ON_INPUT}},

        enable_swallow = {{ENABLE_SWALLOW}},
        swallow_regex = "{{SWALLOW_REGEX}}",

        -- What happens when focusing another window while one is fullscreen
        -- (0 close, 1 drop fullscreen, 2 send it behind)
        on_focus_under_fullscreen = {{ON_FOCUS_UNDER_FULLSCREEN}},

        -- To be able to rescue the session if the lock screen crashes
        allow_session_lock_restore = true,
    },

    -- Reduces screenshot/scaling issues
    xwayland = {
        force_zero_scaling = true,
    },
})

-- ----------------------------------------------------------- gestures ----
