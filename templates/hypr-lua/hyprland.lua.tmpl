{{GESTURE_LINES}}

hl.config({
    gestures = {
        workspace_swipe_distance = {{SWIPE_DISTANCE}},
        workspace_swipe_cancel_ratio = {{SWIPE_CANCEL_RATIO}},
        workspace_swipe_create_new = {{SWIPE_CREATE_NEW}},
        workspace_swipe_direction_lock = {{SWIPE_DIRECTION_LOCK}},
    },
})

-- Your personal settings — read last, can override everything above.
-- The installer never touches this file. ~/.config/hypr/custom.lua is
-- created empty on first install (see modules/hypr.sh) — otherwise
-- require() fails, just as custom.conf has to exist in conf mode.
require("custom")
{{#if RICE_HYPR_LUA}}

-- Hyprland extras of the active profile (python -m hyprsetup rice status):
-- lines that start the author's own windows, and their keybindings.
require("rice")
-- Your keybindings come after the author's (see the hyprland.conf template).
pcall(require, "hyprsetup_keybinds")
{{/if}}
{{#if MIX_HYPR_LUA}}

-- Parts of the mix (python -m hyprsetup mix show): startup commands.
require("mix")
{{/if}}
