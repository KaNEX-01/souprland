{{! require: MANAGE_HYPR_CONFIGS && HYPR_LANG==lua }}
{{! target: hypr/hyprland.lua }}
----------------------------------------------------------------------
-- hyprland.lua — generated by hyprsetup (Lua config)
--
-- On Hyprland's 'main' branch heading for 0.57, the old hyprlang .conf parser
-- was removed entirely; this file replaces it. This project can still
-- produce hyprlang .conf too (templates/hypr/) — HYPR_LANG (auto|conf|lua)
-- decides which one is used, see the README.
--
-- CAREFUL: This template was written against Hyprland's NOT YET officially
-- RELEASED Lua config API (based on example/hyprland.lua on the hyprwm/Hyprland
-- 'main' branch and end-4/dots-hyprland, 2026-07-28). The API may differ
-- slightly once the release is out; if you see errors, run
-- ./install.sh --doctor first, then see https://wiki.hypr.land/Configuring/Start/
--
-- Every value here can be set through settings.conf; manual changes
-- are lost the next time the script runs
-- (the old version is backed up automatically).
--
-- For your personal additions: ~/.config/hypr/custom.lua
----------------------------------------------------------------------

-- ------------------------------------------------------------- modules ----
{{#if MANAGE_MONITORS}}
require("hyprland.monitors")
{{/if}}
{{#unless MANAGE_MONITORS}}
-- Monitors are left to a tool like nwg-displays (MANAGE_MONITORS=0); load its
-- ~/.config/hypr/monitors.lua like the conf mode sources monitors.conf.
pcall(require, "monitors")
{{/unless}}
{{#if WORKSPACE_MONITOR_MAP}}
require("hyprland.workspaces")
{{/if}}
{{#unless WORKSPACE_MONITOR_MAP}}
pcall(require, "workspaces")
{{/unless}}
require("hyprland.env")
require("hyprland.autostart")
require("hyprland.keybinds")
require("hyprland.windowrules")

-- ------------------------------------------------------------ general -----
hl.config({
    general = {
        gaps_in = {{GAPS_IN}},
        gaps_out = {{GAPS_OUT}},
        gaps_workspaces = {{GAPS_WORKSPACES}},
        border_size = {{BORDER_SIZE}},

        col = {
            active_border = { colors = { "{{RGBA_ACCENT}}", "{{RGBA_ACCENT2}}" }, angle = {{BORDER_ANGLE}} },
            inactive_border = "{{RGBA_SURFACE}}",
        },

        resize_on_border = {{RESIZE_ON_BORDER}},
        no_focus_fallback = {{NO_FOCUS_FALLBACK}},
        allow_tearing = {{ALLOW_TEARING}},
        layout = "{{LAYOUT}}",

        snap = {
            enabled = {{SNAP}},
            window_gap = {{SNAP_WINDOW_GAP}},
            monitor_gap = {{SNAP_MONITOR_GAP}},
            respect_gaps = true,
        },
    },

    -- --------------------------------------------------- decoration ----
    decoration = {
        rounding = {{ROUNDING}},
        -- 2 = circle, 4 = pronounced squircle
        rounding_power = {{ROUNDING_POWER}},

        active_opacity = {{ACTIVE_OPACITY}},
        inactive_opacity = {{INACTIVE_OPACITY}},

        dim_inactive = {{DIM_INACTIVE}},
        dim_strength = {{DIM_STRENGTH}},
        dim_special = {{DIM_SPECIAL}},

        blur = {
            enabled = {{BLUR}},
            size = {{BLUR_SIZE}},
            passes = {{BLUR_PASSES}},
            xray = {{BLUR_XRAY}},
            special = {{BLUR_SPECIAL}},
            popups = {{BLUR_POPUPS}},
            noise = {{BLUR_NOISE}},
            contrast = {{BLUR_CONTRAST}},
            brightness = {{BLUR_BRIGHTNESS}},
            vibrancy = {{BLUR_VIBRANCY}},
            new_optimizations = true,
            ignore_opacity = true,
        },

        shadow = {
            enabled = {{SHADOW}},
            range = {{SHADOW_RANGE}},
            render_power = {{SHADOW_RENDER_POWER}},
            offset = {{SHADOW_OFFSET_LUA}},
            color = "{{RGBA_BG_DARK_AA}}",
        },
    },

    -- ---------------------------------------------- window groups ----
    group = {
        col = {
            border_active = { colors = { "{{RGBA_ACCENT}}", "{{RGBA_ACCENT2}}" }, angle = {{BORDER_ANGLE}} },
            border_inactive = "{{RGBA_SURFACE}}",
            border_locked_active = "{{RGBA_RED}}",
            border_locked_inactive = "{{RGBA_SURFACE}}",
        },
        groupbar = {
            enabled = {{GROUPBAR}},
