{{! require: MANAGE_HYPR_CONFIGS && HYPR_LANG==lua }}
{{! target: hypr/hyprland/env.lua }}
----------------------------------------------------------------------
-- hyprland/env.lua — environment variables
----------------------------------------------------------------------

-- --------------------------------------------------------------- cursor --
hl.env("XCURSOR_THEME", "{{CURSOR_THEME}}")
hl.env("XCURSOR_SIZE", "{{CURSOR_SIZE}}")
hl.env("HYPRCURSOR_THEME", "{{CURSOR_THEME}}")
hl.env("HYPRCURSOR_SIZE", "{{CURSOR_SIZE}}")

-- ------------------------------------------------------------- session --
hl.env("XDG_CURRENT_DESKTOP", "Hyprland")
hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("XDG_SESSION_DESKTOP", "Hyprland")
{{#if XDG_MENU_PREFIX}}
hl.env("XDG_MENU_PREFIX", "{{XDG_MENU_PREFIX}}")
{{/if}}
{{#if FLATPAK_DIRS}}
-- Make Flatpak apps' .desktop files and icons visible
hl.env("XDG_DATA_DIRS", "$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share")
{{/if}}

-- ----------------------------------------------------------- toolkits ----
hl.env("GDK_BACKEND", "wayland,x11")
hl.env("SDL_VIDEODRIVER", "wayland")
hl.env("CLUTTER_BACKEND", "wayland")
hl.env("MOZ_ENABLE_WAYLAND", "1")
hl.env("ELECTRON_OZONE_PLATFORM_HINT", "auto")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("QT_WAYLAND_DISABLE_WINDOWDECORATION", "1")
hl.env("QT_AUTO_SCREEN_SCALE_FACTOR", "1")
{{#if QT_PLATFORM_THEME}}
hl.env("QT_QPA_PLATFORMTHEME", "{{QT_PLATFORM_THEME}}")
{{/if}}

{{#if HAS_NVIDIA}}
-- --------------------------------------------------------------- NVIDIA --
-- These variables are required together with nvidia_drm.modeset=1.
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("GBM_BACKEND", "nvidia-drm")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
hl.env("NVD_BACKEND", "direct")
-- If you get screen tearing/blackouts, try the following:
-- hl.env("WLR_DRM_NO_ATOMIC", "1")
{{/if}}

{{#if HAS_AMD}}
-- ------------------------------------------------------------------ AMD --
hl.env("LIBVA_DRIVER_NAME", "radeonsi")
hl.env("VDPAU_DRIVER", "radeonsi")
{{/if}}

-- --------------------------------------------------------- applications --
hl.env("TERMINAL", "{{CMD_TERMINAL}}")
hl.env("BROWSER", "{{BROWSER}}")
{{#if EDITOR_CMD}}
hl.env("EDITOR", "{{EDITOR_CMD}}")
hl.env("VISUAL", "{{EDITOR_CMD}}")
{{/if}}

{{#if EXTRA_ENV_LINES}}
-- ------------------------------------------------- user-defined ----------
{{EXTRA_ENV_LINES}}
{{/if}}
