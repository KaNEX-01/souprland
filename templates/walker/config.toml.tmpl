{{! require: LAUNCHER==walker && HAS_WALKER }}
{{! target: walker/config.toml }}
# walker config — generated by hyprsetup
#
# Only TWO things are set here: the theme to use (colors are written to
# walker/themes/default/style.css) and the enabled providers.
# walker's other defaults (key bindings, window behavior) are left as they
# are — every key we do not override keeps the program's own default.
#
# PROVIDERS (settings.conf → LAUNCHER_PROVIDERS): walker does not gather data
# itself; it gets it from the "elephant" service, and each source is a
# separate elephant plugin. Writing a name in the list here is not enough, its
# package has to be installed too — both come from the walker component in
# config/components.json and the python/hyprsetup/render.py:LAUNCHER_PROVIDERS
# table.

theme = "default"

[providers]
# Sources queried without a prefix: as soon as the user types, their results
# show alongside the apps. The list is short on purpose — putting every
# source here would mix file, bookmark and package results in with the apps
# when typing "fi".
default = {{LAUNCHER_PROVIDERS_DEFAULT}}
# With an empty query box only apps are listed.
empty = ["desktopapplications"]
max_results = {{LAUNCHER_LINES_VALUE}}
{{#if LAUNCHER_HAS_PROVIDERS}}

# Prefixes: a query starting with this character switches to that source
# (e.g. "=12*8" calculator, ":" clipboard history). Enabled sources without
# a prefix are reached via ";" (the source list).
{{LAUNCHER_PROVIDERS_PREFIXES}}
{{/if}}
