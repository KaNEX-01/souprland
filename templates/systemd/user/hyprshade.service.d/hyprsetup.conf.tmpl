{{! require: MANAGE_HYPR_CONFIGS && HAS_HYPRLAND_EXTRAS }}
# generated by hyprsetup — runs hyprshade (timer: night light schedule) with
# the hyprctl shim first in PATH; hyprshade 5 only speaks Lua, the shim lets
# it work in a conf session (see ~/.config/hypr/scripts/hyprctl-compat/hyprctl).
[Service]
Environment=PATH=%h/.config/hypr/scripts/hyprctl-compat:/usr/local/bin:/usr/bin:/bin
