{{! require: NOTIFIER==dunst && HAS_DUNST }}
# dunstrc — theme: {{THEME}} · generated by hyprsetup

[global]
    monitor = 0
    follow = mouse
    width = {{NOTIFY_WIDTH_VALUE}}
    height = (0, 200)
    origin = {{NOTIFY_ANCHOR}}
    offset = ({{NOTIFY_MARGIN_VALUE}}, {{NOTIFY_MARGIN_VALUE}})
    scale = 0
    notification_limit = {{NOTIFY_MAX_VISIBLE_VALUE}}

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = {{NOTIFY_PROGRESS_MAX}}

    separator_height = 2
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "{{HEX_ACCENT}}"
    corner_radius = {{ROUNDING}}
    gap_size = 6

    font = {{FONT_FAMILY}} {{FONT_SIZE}}
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle

    icon_position = left
    min_icon_size = 32
    max_icon_size = {{NOTIFY_ICON_SIZE_VALUE}}
    icon_theme = "{{ICON_THEME_NAME}}"
    enable_recursive_icon_lookup = true

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "{{HEX_BG}}"
    foreground = "{{HEX_SUBTEXT}}"
    frame_color = "{{HEX_SUBTEXT}}"
    timeout = {{NOTIFY_TIMEOUT_LOW_SEC}}

[urgency_normal]
    background = "{{HEX_BG}}"
    foreground = "{{HEX_FG}}"
    frame_color = "{{HEX_ACCENT}}"
    timeout = {{NOTIFY_TIMEOUT_SEC}}

[urgency_critical]
    background = "{{HEX_BG}}"
    foreground = "{{HEX_RED}}"
    frame_color = "{{HEX_RED}}"
    timeout = {{NOTIFY_TIMEOUT_CRIT_SEC}}
