{{! require: HAS_CAVA }}
{{! target: cava/config }}
# cava — console audio visualizer
# generated by hyprsetup · theme: {{THEME}}
#
# Manual edits are lost the next time the script runs
# (the old version is backed up automatically).
#
# To run:  cava
# Docs:    https://github.com/karlstav/cava

[general]
# Automatic: the bar count is picked from the terminal width.
bars = 0
bar_width = 2
bar_spacing = 1
framerate = 60
# Automatic sensitivity: bars still show on quiet tracks.
autosens = 1
sensitivity = 100

[input]
# PipeWire provides the PulseAudio API, so 'pulse' is the right choice;
# the 'pipewire' backend may not be compiled into some cava builds.
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
# Colors come from the theme palette. cava expects hex values quoted and
# with a leading '#'.
background = '{{HEX_BG}}'
foreground = '{{HEX_ACCENT}}'

# Gradient along the height: accent at the bottom, secondary accent at the top.
# That way the visualizer uses the same palette as the bar/terminal.
gradient = 1
gradient_count = 4
gradient_color_1 = '{{HEX_ACCENT}}'
gradient_color_2 = '{{HEX_CYAN}}'
gradient_color_3 = '{{HEX_ACCENT2}}'
gradient_color_4 = '{{HEX_RED}}'

[smoothing]
# Fall-off speed: a higher value gives "stickier" peaks.
noise_reduction = 77
