{{! require: HAS_CAVA && HAS_WAYBAR }}
{{! target: cava/waybar }}
# cava — SEPARATE config for the Waybar module (raw output mode)
# generated by hyprsetup
#
# Why a separate file: ~/.config/cava/config is in ncurses mode for cava run
# in a terminal and contains colors/gradients. The Waybar module needs cava's
# raw mode that emits NUMBERS (each line = the current bar heights); the two
# cannot share one file.
#
# Used by: ~/.config/hypr/scripts/cava-bar.sh

[general]
# Number of bars = number of characters in the bar. More bloats the bar.
bars = 12
framerate = 60
autosens = 1

[input]
method = pulse
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
# The 0-7 range maps one-to-one onto the script's 8 block characters.
ascii_max_range = 7

[smoothing]
noise_reduction = 55
