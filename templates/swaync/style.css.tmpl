{{! require: NOTIFIER==swaync && HAS_SWAYNC }}
/* swaync theme: {{THEME}} · generated by hyprsetup */

* {
    font-family: "{{FONT_FAMILY}}";
    font-size: {{FONT_SIZE}}pt;
}

.notification-row {
    outline: none;
}

.notification {
    border-radius: {{ROUNDING}}px;
    margin: 6px 10px;
    padding: 0;
    background: alpha({{HEX_BG}}, {{BAR_OPACITY}});
    border: {{BORDER_SIZE}}px solid {{HEX_SURFACE}};
}

.notification.critical {
    border-color: {{HEX_RED}};
}

.notification-content {
    padding: 10px 12px;
    color: {{HEX_FG}};
}

.summary {
    color: {{HEX_FG}};
    font-weight: bold;
}

.time {
    color: {{HEX_SUBTEXT}};
}

.body {
    color: {{HEX_SUBTEXT}};
}

.close-button {
    background: transparent;
    color: {{HEX_SUBTEXT}};
    border-radius: {{ROUNDING}}px;
    margin: 6px;
    padding: 2px 8px;
}

.close-button:hover {
    background: {{HEX_RED}};
    color: {{HEX_BG_DARK}};
}

.notification-action,
.notification-default-action {
    background: transparent;
    border-radius: {{ROUNDING}}px;
    color: {{HEX_FG}};
}

.notification-action:hover {
    background: {{HEX_SURFACE}};
}

/* --------------------------------------------------- bildirim merkezi --- */
.control-center {
    background: alpha({{HEX_BG}}, {{BAR_OPACITY}});
    border-radius: {{BAR_RADIUS}}px;
    border: {{BORDER_SIZE}}px solid {{HEX_SURFACE}};
    padding: 10px;
    color: {{HEX_FG}};
}

.control-center .notification {
    background: {{HEX_SURFACE}};
}

.widget-title {
    color: {{HEX_FG}};
    font-size: 1.2em;
    padding: 6px 8px;
}

.widget-title > button {
    background: {{HEX_SURFACE}};
    color: {{HEX_FG}};
    border-radius: {{BAR_RADIUS}}px;
    padding: 4px 12px;
}

.widget-title > button:hover {
    background: {{HEX_ACCENT}};
    color: {{HEX_BG_DARK}};
}

.widget-dnd {
    color: {{HEX_FG}};
    padding: 6px 8px;
}

.widget-dnd > switch {
    background: {{HEX_SURFACE}};
    border-radius: {{BAR_RADIUS}}px;
}

.widget-dnd > switch:checked {
    background: {{HEX_ACCENT}};
}

.widget-mpris,
.widget-volume {
    background: {{HEX_SURFACE}};
    border-radius: {{BAR_RADIUS}}px;
    padding: 8px;
    margin: 6px 0;
    color: {{HEX_FG}};
}

.widget-buttons-grid {
    background: {{HEX_SURFACE}};
    border-radius: {{BAR_RADIUS}}px;
    padding: 8px;
    margin: 6px 0;
}

.widget-buttons-grid > flowbox > flowboxchild > button {
    background: transparent;
    border-radius: {{BAR_RADIUS}}px;
    color: {{HEX_FG}};
    padding: 8px 10px;
    font-size: 1.3em;
}

.widget-buttons-grid > flowbox > flowboxchild > button:hover {
    background: {{HEX_ACCENT}};
    color: {{HEX_BG_DARK}};
}

progressbar, progress, trough {
    border-radius: {{BAR_RADIUS}}px;
}

progress {
    background: {{HEX_ACCENT}};
}

trough {
    background: {{HEX_BG_DARK}};
}
