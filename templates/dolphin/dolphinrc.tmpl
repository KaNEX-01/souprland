{{! require: FILEMANAGER==dolphin && HAS_DOLPHIN }}
{{! target: dolphinrc }}
# dolphinrc — generated by hyprsetup
#
# Colors come from ~/.config/kdeglobals. The settings here only control
# Dolphin's behavior; changes you make in its UI are written to this file when
# Dolphin closes and are reset the next time the script runs
# (the old file is backed up).

[General]
ShowFullPath=true
ShowFullPathInTitlebar=false
RememberOpenedTabs=false
BrowseThroughArchives=true
ShowSelectionToggle=true
SplitView=false
ConfirmClosingMultipleTabs=false
ConfirmClosingTerminalRunningProgram=true
GlobalViewProps=true
UseTabForSwitchingSplitView=true
FilterBar=false
Version=202

[DetailsMode]
PreviewSize=22
SidePadding=10
UseShortRelativeDates=true

[IconsMode]
PreviewSize=64
TextWidthIndex=2

[PreviewSettings]
Plugins=appimagethumbnail,audiothumbnail,blenderthumbnail,comicbookthumbnail,cursorthumbnail,djvuthumbnail,ebookthumbnail,exrthumbnail,directorythumbnail,fontthumbnail,imagethumbnail,jpegthumbnail,kraorathumbnail,windowsexethumbnail,windowsimagethumbnail,mobithumbnail,opendocumentthumbnail,gsthumbnail,rawthumbnail,svgthumbnail,textthumbnail,ffmpegthumbs

[KFileDialog Settings]
Places Icons Auto-resize=false
Places Icons Static Size=22

[MainWindow]
MenuBar=Disabled

[Notification Messages]
ConfirmEmptyTrash=true
ConfirmTrash=false
ConfirmDelete=true

[Search]
Location=Everywhere

[VersionControl]
enabledPlugins=Git
