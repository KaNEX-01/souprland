{{! require: TERMINAL==kitty && HAS_KITTY }}
# kitty.conf — theme: {{THEME}} · generated by hyprsetup

# ----------------------------------------------------------------- font ---
font_family      {{FONT_MONO}}
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        {{TERM_FONT_SIZE_VALUE}}.0
disable_ligatures cursor

# -------------------------------------------------------------- window ---
window_padding_width {{TERM_PADDING_VALUE}}
confirm_os_window_close 0
background_opacity {{TERM_OPACITY_VALUE}}
dynamic_background_opacity yes
{{#if TERM_BG_ON}}
# Background image: darkened with the theme's background color (background_tint).
background_image {{TERM_BG_PATH}}
background_image_layout {{TERM_BG_KITTY_LAYOUT}}
background_tint {{TERM_BG_KITTY_TINT}}
{{/if}}
hide_window_decorations yes
remember_window_size no
initial_window_width 110c
initial_window_height 30c

# ---------------------------------------------------------------- tabs ---
tab_bar_edge bottom
tab_bar_style powerline
tab_powerline_style slanted
tab_title_template "{index}: {title}"

# -------------------------------------------------------------- cursor ---
cursor_shape {{TERM_CURSOR}}
cursor_blink_interval {{TERM_BLINK_KITTY}}
mouse_hide_wait 2.0

# ----------------------------------------------------------- scrolling ---
scrollback_lines {{TERM_SCROLLBACK_LINES}}
wheel_scroll_multiplier 3.0

# ---------------------------------------------------------------- bell ---
enable_audio_bell no
visual_bell_duration 0.1

# -------------------------------------------------------------- colors ---
foreground              {{HEX_FG}}
background              {{HEX_BG}}
selection_foreground    {{HEX_BG}}
selection_background    {{HEX_ACCENT}}

cursor                  {{HEX_ACCENT}}
cursor_text_color       {{HEX_BG}}

url_color               {{HEX_ACCENT2}}

active_border_color     {{HEX_ACCENT}}
inactive_border_color   {{HEX_SURFACE}}

active_tab_foreground   {{HEX_BG}}
active_tab_background   {{HEX_ACCENT}}
inactive_tab_foreground {{HEX_SUBTEXT}}
inactive_tab_background {{HEX_SURFACE}}

# normal
color0 {{HEX_SURFACE}}
color1 {{HEX_RED}}
color2 {{HEX_GREEN}}
color3 {{HEX_YELLOW}}
color4 {{HEX_ACCENT}}
color5 {{HEX_ACCENT2}}
color6 {{HEX_CYAN}}
color7 {{HEX_FG}}
# bright
color8  {{HEX_SUBTEXT}}
color9  {{HEX_RED}}
color10 {{HEX_GREEN}}
color11 {{HEX_YELLOW}}
color12 {{HEX_ACCENT}}
color13 {{HEX_ACCENT2}}
color14 {{HEX_CYAN}}
color15 {{HEX_FG}}

# --------------------------------------------------------- keybindings ---
map ctrl+shift+c copy_to_clipboard
map ctrl+shift+v paste_from_clipboard
map ctrl+shift+enter new_window
map ctrl+shift+t new_tab
map ctrl+plus  change_font_size all +1.0
map ctrl+minus change_font_size all -1.0
map ctrl+0     change_font_size all 0
