{{! require: HAS_QT_THEME }}
; Qt color scheme — theme: {{THEME}} · generated by hyprsetup
; Shows up as "hyprsetup" in qt6ct → Appearance → Color scheme.
; Order follows the QPalette roles: WindowText, Button, Light, Midlight, Dark,
; Mid, Text, BrightText, ButtonText, Base, Window, Shadow, Highlight,
; HighlightedText, Link, LinkVisited, AlternateBase, NoRole, ToolTipBase,
; ToolTipText, PlaceholderText
;
; IMPORTANT: qt6ct expects exactly 21 values per line (including
; PlaceholderText, added to QPalette in Qt6) — with 20 values the line is
; rejected outright, qt6ct falls back to its own default (blue) palette and
; no theme color is applied. Reference: /usr/share/qt6ct/colors/*.conf (21 values).
[ColorScheme]
active_colors=#ff{{COL_FG}}, #ff{{COL_SURFACE}}, #ff{{COL_SURFACE}}, #ff{{COL_SURFACE}}, #ff{{COL_BG_DARK}}, #ff{{COL_BG_DARK}}, #ff{{COL_FG}}, #ff{{COL_RED}}, #ff{{COL_FG}}, #ff{{COL_BG_DARK}}, #ff{{COL_BG}}, #ff{{COL_BG_DARK}}, #ff{{COL_ACCENT}}, #ff{{COL_BG_DARK}}, #ff{{COL_ACCENT2}}, #ff{{COL_ACCENT2}}, #ff{{COL_SURFACE}}, #ff{{COL_BG}}, #ff{{COL_SURFACE}}, #ff{{COL_FG}}, #80{{COL_SUBTEXT}}
disabled_colors=#ff{{COL_SUBTEXT}}, #ff{{COL_SURFACE}}, #ff{{COL_SURFACE}}, #ff{{COL_SURFACE}}, #ff{{COL_BG_DARK}}, #ff{{COL_BG_DARK}}, #ff{{COL_SUBTEXT}}, #ff{{COL_RED}}, #ff{{COL_SUBTEXT}}, #ff{{COL_BG}}, #ff{{COL_BG}}, #ff{{COL_BG_DARK}}, #ff{{COL_SURFACE}}, #ff{{COL_SUBTEXT}}, #ff{{COL_SUBTEXT}}, #ff{{COL_SUBTEXT}}, #ff{{COL_SURFACE}}, #ff{{COL_BG}}, #ff{{COL_SURFACE}}, #ff{{COL_SUBTEXT}}, #80{{COL_SUBTEXT}}
inactive_colors=#ff{{COL_FG}}, #ff{{COL_SURFACE}}, #ff{{COL_SURFACE}}, #ff{{COL_SURFACE}}, #ff{{COL_BG_DARK}}, #ff{{COL_BG_DARK}}, #ff{{COL_FG}}, #ff{{COL_RED}}, #ff{{COL_FG}}, #ff{{COL_BG_DARK}}, #ff{{COL_BG}}, #ff{{COL_BG_DARK}}, #ff{{COL_SURFACE}}, #ff{{COL_FG}}, #ff{{COL_ACCENT2}}, #ff{{COL_ACCENT2}}, #ff{{COL_SURFACE}}, #ff{{COL_BG}}, #ff{{COL_SURFACE}}, #ff{{COL_FG}}, #80{{COL_SUBTEXT}}
