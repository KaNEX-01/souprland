{{! require: HAS_PORTAL }}
# hyprland-portals.conf — generated by hyprsetup
#
# Decides which portal backend handles which job. Without this file, when
# several portals are installed (gtk, gnome, kde) the choice is random and
# screen sharing may break: the screen picker never opens or a black image
# is shared.
#
# ScreenCast/Screenshot → hyprland backend (the right screen picker)
# File chooser          → gtk (dialog consistent with GTK apps)

[preferred]
default = hyprland;gtk
org.freedesktop.impl.portal.FileChooser = gtk
org.freedesktop.impl.portal.Settings = hyprland;gtk
{{#if GNOME_KEYRING}}
org.freedesktop.impl.portal.Secret = gnome-keyring
{{/if}}
