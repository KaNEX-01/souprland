{{! require: HAS_DOLPHIN || HAS_QT_THEME }}
{{! target: kdeglobals }}
# kdeglobals — color scheme for KDE/Qt apps · theme: {{THEME}}
# generated by hyprsetup. KDE Frameworks apps such as Dolphin, Ark and
# Gwenview use the colors in this file and the Breeze widget style FULLY only
# with QT_QPA_PLATFORMTHEME=kde — run under qt6ct/qt5ct, their Qt palette
# comes from the qt6ct/qt5ct settings and this file is largely ignored (the
# real reason Dolphin "always opened in default colors"). So dolphin.exec
# (see config/components.json) starts Dolphin directly with
# QT_QPA_PLATFORMTHEME=kde, even if the rest of the desktop uses another Qt theme.
# The condition accepts HAS_QT_THEME as well as HAS_DOLPHIN: Dolphin may be
# installed without being the FILEMANAGER, and this file has to be refreshed
# whenever the Qt theme changes — otherwise it stays frozen in an old theme's
# colors (the tokyo-night leftover bug).

[General]
ColorScheme=hyprsetup-{{THEME}}
Name=hyprsetup {{THEME}}
# Some parts of the Breeze style (e.g. the accent of the selected entry in the
# Places panel) use this AccentColor key directly, not [Colors:Selection] —
# without it Plasma 6 falls back to default blue, whatever the theme.
AccentColor={{RGB_ACCENT}}
shadeSortColumn=true
XftAntialias=true
XftHintStyle=hintslight
XftSubPixel=rgb
font={{FONT_FAMILY}},{{FONT_SIZE}},-1,5,50,0,0,0,0,0
fixed={{FONT_FAMILY}},{{FONT_SIZE}},-1,5,50,0,0,0,0,0
menuFont={{FONT_FAMILY}},{{FONT_SIZE}},-1,5,50,0,0,0,0,0
smallestReadableFont={{FONT_FAMILY}},{{FONT_SIZE}},-1,5,50,0,0,0,0,0
toolBarFont={{FONT_FAMILY}},{{FONT_SIZE}},-1,5,50,0,0,0,0,0

[ColorEffects:Disabled]
Color={{RGB_SURFACE}}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{RGB_SURFACE}}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

