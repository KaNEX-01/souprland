{{! require: TERMINAL==wezterm && HAS_WEZTERM }}
{{! target: wezterm/wezterm.lua }}
-- wezterm.lua — theme: {{THEME}} · generated by hyprsetup
-- Docs: https://wezterm.org/config/lua/config/
--
-- Unlike the other three terminals, WezTerm reads a script returning Lua
-- rather than plain key=value; so the template produces .lua too. Do NOT
-- add your own changes to this file — it is overwritten the next time the
-- script runs. For permanent changes: ~/.config/wezterm/custom.lua (read below).

local wezterm = require('wezterm')
local config = wezterm.config_builder()

-- ------------------------------------------------------------------ font ---
config.font = wezterm.font('{{FONT_MONO}}')
config.font_size = {{TERM_FONT_SIZE_VALUE}}

-- ----------------------------------------------------------------- colors ---
-- HEX_* is used, not COL_*: COL_* comes without the leading '#' (as fuzzel
-- wants), while WezTerm expects '#rrggbb' and rejects values without '#'.
config.colors = {
  foreground = '{{HEX_FG}}',
  background = '{{HEX_BG}}',
  cursor_bg = '{{HEX_ACCENT}}',
  cursor_border = '{{HEX_ACCENT}}',
  cursor_fg = '{{HEX_BG}}',
  selection_bg = '{{HEX_SURFACE}}',
  selection_fg = '{{HEX_FG}}',
  -- ANSI 0-7 / bright 8-15 — same order as the palette in the ghostty template.
  ansi = {
    '{{HEX_BG_DARK}}', '{{HEX_RED}}', '{{HEX_GREEN}}', '{{HEX_YELLOW}}',
    '{{HEX_ACCENT}}', '{{HEX_ACCENT2}}', '{{HEX_CYAN}}', '{{HEX_FG}}',
  },
  brights = {
    '{{HEX_SUBTEXT}}', '{{HEX_RED}}', '{{HEX_GREEN}}', '{{HEX_YELLOW}}',
    '{{HEX_ACCENT}}', '{{HEX_ACCENT2}}', '{{HEX_CYAN}}', '{{HEX_FG}}',
  },
}

-- ----------------------------------------------------------------- window ---
config.window_background_opacity = {{TERM_OPACITY_VALUE}}
{{#if TERM_BG_ON}}
-- Background image. When config.background is set, window_background_opacity
-- is ignored; opacity moves to the layer's opacity.
config.background = {
  {
    source = { File = '{{TERM_BG_PATH}}' },
    width = {{TERM_BG_WEZTERM_SIZE}},
    height = {{TERM_BG_WEZTERM_SIZE}},
    repeat_x = {{TERM_BG_WEZTERM_REPEAT}},
    repeat_y = {{TERM_BG_WEZTERM_REPEAT}},
    horizontal_align = 'Center',
    vertical_align = 'Middle',
    hsb = { brightness = {{TERM_BG_WEZTERM_BRIGHTNESS}} },
    opacity = {{TERM_OPACITY_VALUE}},
  },
}
{{/if}}
-- Hyprland draws its own border/shadow; keep WezTerm's from stacking on top.
config.window_decorations = 'NONE'
config.window_padding = {
  left = {{TERM_PADDING_VALUE}},
  right = {{TERM_PADDING_VALUE}},
  top = {{TERM_PADDING_VALUE}},
  bottom = {{TERM_PADDING_VALUE}},
}

-- --------------------------------------------------------------- behavior ---
config.scrollback_lines = {{TERM_SCROLLBACK_LINES}}
config.default_cursor_style = '{{TERM_CURSOR_WEZTERM}}'
config.hide_mouse_cursor_when_typing = true
config.audible_bell = 'Disabled'
-- The tab bar is drawn only with more than one tab: with a single tab it sits
-- like a second strip below Hyprland's own bar.
config.hide_tab_bar_if_only_one_tab = true
config.use_fancy_tab_bar = false
config.check_for_updates = false

-- The user's own additions (if any) are read last and override the above.
local ok, custom = pcall(require, 'custom')
if ok and type(custom) == 'function' then
  custom(config, wezterm)
end

return config
