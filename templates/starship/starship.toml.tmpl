{{! require: HAS_STARSHIP }}
# starship.toml — shell prompt
# generated by hyprsetup · theme: {{THEME}}
#
# Manual edits are lost the next time the script runs
# (the old version is backed up automatically).
#
# Colors come from the theme palette; terminal, bar and prompt share the
# same palette. Docs: https://starship.rs/config/

# Two-line prompt: long paths and git branches do not squeeze the command.
format = """
[](fg:{{HEX_SURFACE}})\
$directory\
$git_branch\
$git_status\
[](fg:{{HEX_SURFACE}})\
$fill\
$c$rust$golang$nodejs$python$java\
$cmd_duration\
$line_break\
$character"""

# Fill that pushes right — language/duration info is aligned to the line end.
[fill]
symbol = " "

[directory]
style = "fg:{{HEX_FG}} bg:{{HEX_SURFACE}}"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"
read_only = " 󰌾"

[git_branch]
symbol = ""
style = "fg:{{HEX_ACCENT}} bg:{{HEX_SURFACE}}"
format = "[ $symbol $branch ]($style)"

[git_status]
style = "fg:{{HEX_YELLOW}} bg:{{HEX_SURFACE}}"
format = "[$all_status$ahead_behind ]($style)"

# Show only if the command took over 2 seconds — no noise for short commands.
[cmd_duration]
min_time = 2000
style = "fg:{{HEX_SUBTEXT}}"
format = "[ 󱎫 $duration]($style)"

[character]
success_symbol = "[❯](bold fg:{{HEX_GREEN}})"
error_symbol = "[❯](bold fg:{{HEX_RED}})"
vimcmd_symbol = "[❮](bold fg:{{HEX_ACCENT2}})"

# --------------------------------------------------- language indicators ---
# Shown only when the matching project file exists.
[c]
symbol = " "
style = "fg:{{HEX_CYAN}}"
format = "[ $symbol($version) ]($style)"

[rust]
symbol = "󱘗 "
style = "fg:{{HEX_RED}}"
format = "[ $symbol($version) ]($style)"

[golang]
symbol = " "
style = "fg:{{HEX_CYAN}}"
format = "[ $symbol($version) ]($style)"

[nodejs]
symbol = " "
style = "fg:{{HEX_GREEN}}"
format = "[ $symbol($version) ]($style)"

[python]
symbol = " "
style = "fg:{{HEX_YELLOW}}"
format = "[ $symbol($version) ]($style)"

[java]
symbol = " "
style = "fg:{{HEX_ACCENT2}}"
format = "[ $symbol($version) ]($style)"
