{{! require: HAS_FIREFOX_THEME }}
/*
 * userChrome.css — Firefox UI theme
 * generated by hyprsetup · theme: {{THEME}}
 *
 * This file is not used directly: hook_firefox_theme (modules/desktop.sh)
 * copies it into the chrome/ directory of every Firefox profile it finds.
 * Firefox profile directories carry a random prefix (e.g.
 * "a1b2c3d4.default-release"), so the template engine cannot know the target.
 *
 * It needs this setting to take effect (the hook writes it too):
 *     toolkit.legacyUserProfileCustomizations.stylesheets = true
 *
 * Manual edits are lost the next time the script runs.
 */

:root {
    --hs-bg: {{HEX_BG}};
    --hs-bg-dark: {{HEX_BG_DARK}};
    --hs-surface: {{HEX_SURFACE}};
    --hs-fg: {{HEX_FG}};
    --hs-subtext: {{HEX_SUBTEXT}};
    --hs-accent: {{HEX_ACCENT}};
    --hs-radius: {{ROUNDING}}px;
}

/* Override Firefox's own color variables, so the whole browser takes the
   palette without writing rules one by one. */
:root:root {
    --toolbar-bgcolor: var(--hs-bg) !important;
    --toolbar-color: var(--hs-fg) !important;
    --tab-selected-bgcolor: var(--hs-surface) !important;
    --tab-selected-textcolor: var(--hs-fg) !important;
    --toolbarbutton-hover-background: var(--hs-surface) !important;
    --toolbarbutton-active-background: var(--hs-surface) !important;
    --lwt-accent-color: var(--hs-bg-dark) !important;
    --lwt-text-color: var(--hs-fg) !important;
    --arrowpanel-background: var(--hs-bg) !important;
    --arrowpanel-color: var(--hs-fg) !important;
    --arrowpanel-border-color: var(--hs-surface) !important;
    --urlbar-box-bgcolor: var(--hs-surface) !important;
    --urlbar-box-text-color: var(--hs-fg) !important;
}

/* ---------------------------------------------------------------- tabs --- */
#TabsToolbar {
    background-color: var(--hs-bg-dark) !important;
}

.tabbrowser-tab .tab-background {
    border-radius: var(--hs-radius) !important;
    margin-block: 3px !important;
}

.tabbrowser-tab[selected] .tab-background {
    background: var(--hs-surface) !important;
    /* Mark the selected tab with the accent color — the background difference
       alone is not distinct enough in dark themes. */
    box-shadow: inset 0 -2px 0 0 var(--hs-accent) !important;
}

.tabbrowser-tab:not([selected]):hover .tab-background {
    background: color-mix(in srgb, var(--hs-surface) 60%, transparent) !important;
}

/* --------------------------------------------------------- address bar --- */
#navigator-toolbox {
    background-color: var(--hs-bg) !important;
    border-bottom: 1px solid var(--hs-surface) !important;
}

#urlbar-background {
    background-color: var(--hs-bg-dark) !important;
    border: 1px solid var(--hs-surface) !important;
    border-radius: var(--hs-radius) !important;
}

#urlbar[focused="true"] > #urlbar-background {
    border-color: var(--hs-accent) !important;
}

/* Address bar dropdown */
.urlbarView-row[selected] > .urlbarView-row-inner,
.urlbarView-row:hover > .urlbarView-row-inner {
    background-color: var(--hs-surface) !important;
    border-radius: var(--hs-radius) !important;
}

/* ------------------------------------------------------------- sidebar ---- */
#sidebar-box,
#sidebar-header {
    background-color: var(--hs-bg-dark) !important;
    color: var(--hs-fg) !important;
}

/* Prevent the white flash of the new tab page: in a dark theme this is the
   only glaring spot when opening a tab. */
#tabbrowser-tabbox,
browser[type="content-primary"] {
    background-color: var(--hs-bg) !important;
}
