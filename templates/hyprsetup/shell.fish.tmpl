{{! require: HAS_CLI_TOOLS }}
{{! target: hyprsetup/shell.fish }}
# shell.fish — fish integration for the installed terminal tools
# generated by hyprsetup
#
# Usage (the installer offers to add this for you):
#     test -f ~/.config/hyprsetup/shell.fish; and source ~/.config/hyprsetup/shell.fish
#
# Put your own aliases in ~/.config/fish/config.fish, not here;
# this file is regenerated the next time the script runs.
#
# NOTE: fish is NOT POSIX-compatible — "export X=y", "$(...)" and "[ ... ]"
# do not work here. That is why this is a separate file, not a translation
# of shell.sh.

# --------------------------------------------------------------- zoxide ----
# "z <dir-fragment>" jumps to directories you use often.
if type -q zoxide
    zoxide init fish | source
end

# ------------------------------------------------------------------ fzf ----
# CTRL+R history search, CTRL+T file picker.
if type -q fzf
    # fzf 0.48+ generates its fish key bindings itself; older versions use
    # the file shipped by the distribution.
    if fzf --fish >/dev/null 2>&1
        fzf --fish | source
    else if test -f /usr/share/fish/vendor_functions.d/fzf_key_bindings.fish
        fzf_key_bindings
    end

    # Make previews match the theme colors
    set -gx FZF_DEFAULT_OPTS "--height 40% --layout=reverse --border \
--color=bg+:{{HEX_SURFACE}},bg:{{HEX_BG}},spinner:{{HEX_ACCENT2}},hl:{{HEX_ACCENT}} \
--color=fg:{{HEX_FG}},header:{{HEX_ACCENT}},info:{{HEX_ACCENT2}},pointer:{{HEX_ACCENT2}} \
--color=marker:{{HEX_GREEN}},fg+:{{HEX_FG}},prompt:{{HEX_ACCENT2}},hl+:{{HEX_ACCENT}}"

    if type -q fd
        set -gx FZF_DEFAULT_COMMAND 'fd --type f --hidden --follow --exclude .git'
        set -gx FZF_CTRL_T_COMMAND $FZF_DEFAULT_COMMAND
    end
end

# ------------------------------------------------------------------ eza ----
if type -q eza
    alias ls 'eza --group-directories-first --icons'
    alias ll 'eza -l --group-directories-first --icons --git'
    alias la 'eza -la --group-directories-first --icons --git'
    alias lt 'eza --tree --level=2 --icons'
end

# ------------------------------------------------------------------ bat ----
if type -q bat
    alias cat 'bat --style=plain --paging=never'
    # BAT_THEME="ansi" ON PURPOSE: bat uses the terminal's ANSI 0-15 colors,
    # which are already generated from the theme palette (see kitty.conf.tmpl →
    # color0-15). That way bat INSTANTLY follows the palette extracted from the
    # wallpaper with THEME="auto", or CUSTOM_COLORS. Generating a separate
    # .tmTheme would break this: it would need regenerating on every palette change.
    set -gx BAT_THEME "ansi"
    set -gx MANPAGER "sh -c 'col -bx | bat -l man -p'"
end

{{#if HAS_YAZI}}
# ----------------------------------------------------------------- yazi ----
# "y" opens yazi; on exit, cd to the directory you were in.
function y
    set -l tmp (mktemp -t yazi-cwd.XXXXXX)
    yazi $argv --cwd-file="$tmp"
    if set -l cwd (cat -- "$tmp" 2>/dev/null); and test -n "$cwd"; and test "$cwd" != "$PWD"
        cd -- "$cwd"
    end
    rm -f -- "$tmp"
end
{{/if}}

{{#if HAS_STARSHIP}}
# ------------------------------------------------------------- starship ----
if type -q starship
    starship init fish | source
end
{{/if}}

# ------------------------------------------------------------- shortcuts ---
alias hypr-reload 'hyprctl reload'
alias hypr-errors 'hyprctl configerrors'
{{#if TERM_FETCH_ON}}

# ------------------------------------------------------ startup screen ---
# Take over fish's greeting function: some distros (CachyOS) already run
# fastfetch there; a second call printed it twice.
function fish_greeting
    if not set -q HYPRSETUP_FETCH_SHOWN; and type -q fastfetch
        set -gx HYPRSETUP_FETCH_SHOWN 1
        fastfetch
    end
end
{{/if}}
{{#if TERM_FETCH_OFF}}

# Startup screen off: the distro's greeting (fastfetch) is silenced too.
function fish_greeting
end
{{/if}}
