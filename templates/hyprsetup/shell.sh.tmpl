{{! require: HAS_CLI_TOOLS }}
{{! target: hyprsetup/shell.sh }}
# shell.sh — shell integration for the installed terminal tools
# generated by hyprsetup · works with bash and zsh
#
# Usage (the installer offers to add this for you):
#     [ -f ~/.config/hyprsetup/shell.sh ] && . ~/.config/hyprsetup/shell.sh
#
# Put your own aliases in ~/.bashrc or ~/.zshrc, not here;
# this file is regenerated the next time the script runs.

# --------------------------------------------------------------- zoxide ----
# "z <dir-fragment>" jumps to directories you use often.
if command -v zoxide >/dev/null 2>&1; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(zoxide init zsh)"
    else
        eval "$(zoxide init bash)"
    fi
fi

# ------------------------------------------------------------------ fzf ----
# CTRL+R history search, CTRL+T file picker.
if command -v fzf >/dev/null 2>&1; then
    if [ -n "$ZSH_VERSION" ]; then
        [ -f /usr/share/fzf/key-bindings.zsh ] && . /usr/share/fzf/key-bindings.zsh
        [ -f /usr/share/fzf/completion.zsh ]   && . /usr/share/fzf/completion.zsh
    else
        [ -f /usr/share/fzf/key-bindings.bash ] && . /usr/share/fzf/key-bindings.bash
        [ -f /usr/share/fzf/completion.bash ]   && . /usr/share/fzf/completion.bash
    fi
    # Make previews match the theme colors
    export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border \
--color=bg+:{{HEX_SURFACE}},bg:{{HEX_BG}},spinner:{{HEX_ACCENT2}},hl:{{HEX_ACCENT}} \
--color=fg:{{HEX_FG}},header:{{HEX_ACCENT}},info:{{HEX_ACCENT2}},pointer:{{HEX_ACCENT2}} \
--color=marker:{{HEX_GREEN}},fg+:{{HEX_FG}},prompt:{{HEX_ACCENT2}},hl+:{{HEX_ACCENT}}"
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    fi
fi

# ------------------------------------------------------------------ eza ----
if command -v eza >/dev/null 2>&1; then
    alias ls='eza --group-directories-first --icons'
    alias ll='eza -l --group-directories-first --icons --git'
    alias la='eza -la --group-directories-first --icons --git'
    alias lt='eza --tree --level=2 --icons'
fi

# ------------------------------------------------------------------ bat ----
if command -v bat >/dev/null 2>&1; then
    alias cat='bat --style=plain --paging=never'
    # BAT_THEME="ansi" ON PURPOSE: bat uses the terminal's ANSI 0-15 colors,
    # which are already generated from the theme palette (see kitty.conf.tmpl →
    # color0-15). That way bat INSTANTLY follows the palette extracted from the
    # wallpaper with THEME="auto", or CUSTOM_COLORS. Generating a separate
    # .tmTheme would break this: it would need regenerating on every palette change.
    export BAT_THEME="ansi"
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

# ----------------------------------------------------------------- yazi ----
{{#if HAS_YAZI}}
# "y" opens yazi; on exit, cd to the directory you were in.
y() {
    tmp="$(mktemp -t yazi-cwd.XXXXXX)"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp" 2>/dev/null)" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd" || true
    fi
    rm -f -- "$tmp"
}
{{/if}}

{{#if HAS_STARSHIP}}
# ------------------------------------------------------------- starship ----
# Initialized LAST: starship installs its PROMPT_COMMAND/precmd hook and takes
# over any prompt set earlier. Placed higher up, the rest of this file or the
# remainder of .bashrc could override it.
if command -v starship >/dev/null 2>&1; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(starship init zsh)"
    else
        eval "$(starship init bash)"
    fi
fi
{{/if}}

# ------------------------------------------------------------- shortcuts ---
alias hypr-reload='hyprctl reload'
alias hypr-errors='hyprctl configerrors'
{{#if TERM_FETCH_ON}}

# ------------------------------------------------------ startup screen ---
# Logo and system info in a new terminal window (fastfetch; setting:
# Terminal › Startup screen). Interactive shells only; the exported flag
# keeps it from repeating in nested shells opened inside the window.
case $- in
    *i*)
        if [ -z "$HYPRSETUP_FETCH_SHOWN" ] && command -v fastfetch >/dev/null 2>&1; then
            export HYPRSETUP_FETCH_SHOWN=1
            fastfetch
        fi
        ;;
esac
{{/if}}
