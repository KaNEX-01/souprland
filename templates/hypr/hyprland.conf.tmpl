{{! require: MANAGE_HYPR_CONFIGS && HYPR_LANG==conf }}
####################################################################
#  hyprland.conf — generated by hyprsetup
#
#  Every value here can be set through settings.conf; manual changes
#  are lost the next time the script runs
#  (the old version is backed up automatically).
#
#  For your personal additions: ~/.config/hypr/custom.conf
#  Docs: https://wiki.hypr.land/Configuring/
####################################################################

# ------------------------------------------------------------- modules ----
# monitors.conf and workspaces.conf are always sourced: with MANAGE_MONITORS=0
# / WORKSPACE_MONITOR_MAP="" the script never touches their CONTENTS (they are
# left to a tool like nwg-displays), but if the files were not sourced,
# Hyprland would never read that tool's settings. When the script does not
# generate these files, hook_hyprland (modules/hypr.sh) leaves a placeholder,
# so the source never fails.
source = ~/.config/hypr/monitors.conf
source = ~/.config/hypr/workspaces.conf
source = ~/.config/hypr/env.conf
source = ~/.config/hypr/autostart.conf
source = ~/.config/hypr/keybinds.conf
source = ~/.config/hypr/windowrules.conf
{{#if HAS_ANY_PLUGIN}}
# hyprpm plugin settings — generated only if at least one plugin is selected.
# If the plugin build breaks after a Hyprland update, these settings are
# silently ignored; "hyprpm update && hyprpm reload" is needed.
source = ~/.config/hypr/plugins.conf
{{/if}}

# ------------------------------------------------------------ general -----
general {
    gaps_in = {{GAPS_IN}}
    gaps_out = {{GAPS_OUT}}
    gaps_workspaces = {{GAPS_WORKSPACES}}
    border_size = {{BORDER_SIZE}}

    col.active_border = {{RGBA_ACCENT}} {{RGBA_ACCENT2}} {{BORDER_ANGLE}}deg
    col.inactive_border = {{RGBA_SURFACE}}

    resize_on_border = {{RESIZE_ON_BORDER}}
    no_focus_fallback = {{NO_FOCUS_FALLBACK}}
    allow_tearing = {{ALLOW_TEARING}}
    layout = {{LAYOUT}}

    snap {
        enabled = {{SNAP}}
        window_gap = {{SNAP_WINDOW_GAP}}
        monitor_gap = {{SNAP_MONITOR_GAP}}
        respect_gaps = true
    }
}

# --------------------------------------------------------- decoration ----
decoration {
    rounding = {{ROUNDING}}
    # 2 = circle, 4 = pronounced squircle
    rounding_power = {{ROUNDING_POWER}}

    active_opacity = {{ACTIVE_OPACITY}}
    inactive_opacity = {{INACTIVE_OPACITY}}

    dim_inactive = {{DIM_INACTIVE}}
    dim_strength = {{DIM_STRENGTH}}
    dim_special = {{DIM_SPECIAL}}

    blur {
        enabled = {{BLUR}}
        size = {{BLUR_SIZE}}
        passes = {{BLUR_PASSES}}
        xray = {{BLUR_XRAY}}
        special = {{BLUR_SPECIAL}}
        popups = {{BLUR_POPUPS}}
        noise = {{BLUR_NOISE}}
        contrast = {{BLUR_CONTRAST}}
        brightness = {{BLUR_BRIGHTNESS}}
        vibrancy = {{BLUR_VIBRANCY}}
        new_optimizations = true
        ignore_opacity = true
    }

    shadow {
        enabled = {{SHADOW}}
        range = {{SHADOW_RANGE}}
        render_power = {{SHADOW_RENDER_POWER}}
        offset = {{SHADOW_OFFSET}}
        color = {{RGBA_BG_DARK_AA}}
    }
}

# ---------------------------------------------------- window groups ----
# Tabbed windows merged with MOD+G. Colors come from the theme; settings in
# MOD+I → Behavior → Window groups.
group {
    col.border_active = {{RGBA_ACCENT}} {{RGBA_ACCENT2}} {{BORDER_ANGLE}}deg
    col.border_inactive = {{RGBA_SURFACE}}
    col.border_locked_active = {{RGBA_RED}}
    col.border_locked_inactive = {{RGBA_SURFACE}}

    groupbar {
        enabled = {{GROUPBAR}}
        height = {{GROUPBAR_HEIGHT_VALUE}}
        font_size = {{GROUPBAR_FONT_SIZE_VALUE}}
        font_family = {{FONT_FAMILY}}
        gradients = {{GROUPBAR_GRADIENTS}}
        render_titles = {{GROUPBAR_RENDER_TITLES}}
        rounding = {{GROUPBAR_ROUNDING}}
        gradient_rounding = {{GROUPBAR_ROUNDING}}
        text_color = {{GROUPBAR_TEXT}}
        text_color_inactive = {{GROUPBAR_TEXT_INACTIVE}}
        col.active = {{RGBA_ACCENT}}
        col.inactive = {{RGBA_SURFACE}}
        col.locked_active = {{RGBA_RED}}
        col.locked_inactive = {{RGBA_SURFACE}}
    }
}

# --------------------------------------------------------- animations ----
animations {
    enabled = {{ANIMATIONS}}

{{ANIMATION_LINES}}
}

# ------------------------------------------------------------ layouts ----
dwindle {
    # Note: 'pseudotile' is no longer an option, only a dispatcher —
    # used via the MOD+P keybinding in keybinds.conf.
    preserve_split = {{DWINDLE_PRESERVE_SPLIT}}
    smart_split = {{DWINDLE_SMART_SPLIT}}
    smart_resizing = {{DWINDLE_SMART_RESIZING}}
}

master {
    new_status = {{MASTER_NEW_STATUS}}
    mfact = {{MASTER_MFACT}}
}

# -------------------------------------------------------------- input ----
input {
    kb_layout = {{KB_LAYOUT}}
    kb_variant = {{KB_VARIANT}}
    kb_options = {{KB_OPTIONS}}

    repeat_delay = {{REPEAT_DELAY}}
    repeat_rate = {{REPEAT_RATE}}
    numlock_by_default = {{NUMLOCK}}

    follow_mouse = {{FOLLOW_MOUSE}}
    sensitivity = {{SENSITIVITY}}
{{#if ACCEL_PROFILE}}
    accel_profile = {{ACCEL_PROFILE}}
{{/if}}
    off_window_axis_events = {{OFF_WINDOW_AXIS_EVENTS}}

    touchpad {
        natural_scroll = {{NATURAL_SCROLL}}
        tap-to-click = {{TOUCHPAD_TAP}}
        disable_while_typing = {{TOUCHPAD_DWT}}
        clickfinger_behavior = {{TOUCHPAD_CLICKFINGER}}
        scroll_factor = {{TOUCHPAD_SCROLL_FACTOR}}
    }
}

# ----------------------------------------------------------- gestures ----
# Hyprland 0.51+ syntax
{{GESTURE_LINES}}

gestures {
    workspace_swipe_distance = {{SWIPE_DISTANCE}}
    workspace_swipe_cancel_ratio = {{SWIPE_CANCEL_RATIO}}
    workspace_swipe_create_new = {{SWIPE_CREATE_NEW}}
    workspace_swipe_direction_lock = {{SWIPE_DIRECTION_LOCK}}
}

# -------------------------------------------------------- keybindings ---
binds {
    scroll_event_delay = {{SCROLL_EVENT_DELAY}}
    hide_special_on_workspace_change = {{HIDE_SPECIAL_ON_WS_CHANGE}}
}

# ------------------------------------------------------------ cursor -----
cursor {
    no_hardware_cursors = {{NO_HARDWARE_CURSORS}}
    inactive_timeout = {{CURSOR_INACTIVE_TIMEOUT}}
    hotspot_padding = {{CURSOR_HOTSPOT_PADDING}}
    hide_on_key_press = false
    sync_gsettings_theme = true
}

# -------------------------------------------------------------- misc -----
misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    # The script writes the config to many files in a row and triggers its
    # own `hyprctl reload` at the end; Hyprland's inotify-based auto reload
    # can catch a half-written file during that, treat it as invalid and
    # replace the config with its own STUB. So it is kept off — manual
    # reload with MOD+CTRL+R is unaffected.
    disable_autoreload = true
    force_default_wallpaper = 0
    background_color = {{RGBA_BG_DARK}}

    vrr = {{VRR}}

    focus_on_activate = {{FOCUS_ON_ACTIVATE}}
    animate_manual_resizes = {{ANIMATE_MANUAL_RESIZES}}
    mouse_move_enables_dpms = {{DPMS_ON_INPUT}}
    key_press_enables_dpms = {{DPMS_ON_INPUT}}

    enable_swallow = {{ENABLE_SWALLOW}}
    swallow_regex = {{SWALLOW_REGEX}}

    # What happens when focusing another window while one is fullscreen
    # (0 close, 1 drop fullscreen, 2 send it behind)
    on_focus_under_fullscreen = {{ON_FOCUS_UNDER_FULLSCREEN}}

    # To be able to rescue the session if the lock screen crashes
    allow_session_lock_restore = true
}

# Reduces screenshot/scaling issues
xwayland {
    force_zero_scaling = true
}

# Your personal settings — read last, can override everything above.
# The installer never touches this file.
source = ~/.config/hypr/custom.conf
{{#if RICE_HYPR}}

# Hyprland extras of the active profile (python -m hyprsetup rice status):
# lines that start the author's own windows, and their keybindings.
source = ~/.config/hypr/rice.conf
# Your keybindings come after the author's: an author binding on the same key
# is unbound and yours is bound again (keybindings stay put when the profile changes).
source = ~/.config/hypr/hyprsetup-keybinds.conf
{{/if}}
{{#if MIX_HYPR}}

# Parts of the mix (python -m hyprsetup mix show): startup commands for the
# bar/launcher/notifications taken from other profiles.
source = ~/.config/hypr/mix.conf
{{/if}}
