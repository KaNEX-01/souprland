{{! require: MANAGE_HYPR_CONFIGS && HAS_HYPRLAND_EXTRAS }}
// crt.glsl — scanlines and a light vignette (retro CRT look)
// generated by hyprsetup · used with hyprshade
//
// For show; not designed for constant use — it hurts readability of thin
// text. Set SCANLINE_DEPTH to 0.0 to keep only the vignette.

precision highp float;
varying vec2 v_texcoord;
uniform sampler2D tex;

const float SCANLINE_DEPTH = 0.12;   // line darkness (0.0 = no lines)
const float SCANLINE_COUNT = 800.0;  // number of lines across the screen
const float VIGNETTE       = 0.25;   // corner darkening (0.0 = none)

void main() {
    vec4 color = texture2D(tex, v_texcoord);

    // Scanline: a sine band along the vertical axis.
    float scan = 1.0 - SCANLINE_DEPTH *
                 (0.5 + 0.5 * sin(v_texcoord.y * SCANLINE_COUNT * 3.14159265));

    // Vignette: darken with distance from the center.
    vec2 offset = v_texcoord - vec2(0.5);
    float vignette = 1.0 - VIGNETTE * dot(offset, offset) * 4.0;

    gl_FragColor = vec4(color.rgb * scan * vignette, color.a);
}
