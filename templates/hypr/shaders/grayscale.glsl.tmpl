{{! require: MANAGE_HYPR_CONFIGS && HAS_HYPRLAND_EXTRAS }}
// grayscale.glsl — turns the screen fully gray
// generated by hyprsetup · used with hyprshade
//
// Meant as a focus / fewer-distractions mode; also handy for simulating
// color blindness or checking designs.

precision highp float;
varying vec2 v_texcoord;
uniform sampler2D tex;

void main() {
    vec4 color = texture2D(tex, v_texcoord);
    // ITU-R BT.709 luminance coefficients — a much more accurate gray than a
    // plain average (green weighs most for the human eye).
    float luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
    gl_FragColor = vec4(vec3(luma), color.a);
}
