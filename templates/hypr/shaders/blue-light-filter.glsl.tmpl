{{! require: MANAGE_HYPR_CONFIGS && HAS_HYPRLAND_EXTRAS }}
// blue-light-filter.glsl — dims blue light (for night use)
// generated by hyprsetup · used with hyprshade
//
// To apply:        hyprshade on blue-light-filter
// To turn off:     hyprshade off
// Schedule:        ~/.config/hypr/hyprshade.toml
//
// Change the coefficients to adjust the temperature; 1.0 = leave as is.
// The values below roughly correspond to 4500K.

precision highp float;
varying vec2 v_texcoord;
uniform sampler2D tex;

const vec3 WARMTH = vec3(1.0, 0.86, 0.72);

void main() {
    vec4 color = texture2D(tex, v_texcoord);
    // Alpha is kept; only the color channels are scaled.
    gl_FragColor = vec4(color.rgb * WARMTH, color.a);
}
