{{! require: MANAGE_HYPR_CONFIGS && HAS_HYPRLAND_EXTRAS }}
// vibrance.glsl — boosts saturation, affecting already vivid colors less
// generated by hyprsetup · used with hyprshade
//
// "Vibrance" differs from plain saturation: it noticeably livens up dull
// colors but does not push already saturated ones much, so skin tones
// and already bright areas do not blow out.

precision highp float;
varying vec2 v_texcoord;
uniform sampler2D tex;

const float STRENGTH = 0.35;   // 0.0 = off, 1.0 = very aggressive

void main() {
    vec4 color = texture2D(tex, v_texcoord);

    float maxc = max(color.r, max(color.g, color.b));
    float minc = min(color.r, min(color.g, color.b));
    float saturation = maxc - minc;          // 0 = gri, 1 = tam doygun
    float luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));

    // The higher the saturation, the smaller the push.
    float amount = STRENGTH * (1.0 - saturation);
    gl_FragColor = vec4(mix(vec3(luma), color.rgb, 1.0 + amount), color.a);
}
