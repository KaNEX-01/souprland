{{! require: MANAGE_HYPR_CONFIGS && HYPR_LANG==conf }}
####################################################################
#  env.conf — environment variables
####################################################################

# --------------------------------------------------------------- cursor --
env = XCURSOR_THEME,{{CURSOR_THEME}}
env = XCURSOR_SIZE,{{CURSOR_SIZE}}
env = HYPRCURSOR_THEME,{{CURSOR_THEME}}
env = HYPRCURSOR_SIZE,{{CURSOR_SIZE}}

# ------------------------------------------------------------- session --
env = XDG_CURRENT_DESKTOP,Hyprland
env = XDG_SESSION_TYPE,wayland
env = XDG_SESSION_DESKTOP,Hyprland
{{#if XDG_MENU_PREFIX}}
env = XDG_MENU_PREFIX,{{XDG_MENU_PREFIX}}
{{/if}}
{{#if FLATPAK_DIRS}}
# Make Flatpak apps' .desktop files and icons visible
env = XDG_DATA_DIRS,$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share
{{/if}}

# ----------------------------------------------------------- toolkits ----
env = GDK_BACKEND,wayland,x11
env = SDL_VIDEODRIVER,wayland
env = CLUTTER_BACKEND,wayland
env = MOZ_ENABLE_WAYLAND,1
env = ELECTRON_OZONE_PLATFORM_HINT,auto
env = QT_QPA_PLATFORM,wayland;xcb
env = QT_WAYLAND_DISABLE_WINDOWDECORATION,1
env = QT_AUTO_SCREEN_SCALE_FACTOR,1
{{#if QT_PLATFORM_THEME}}
env = QT_QPA_PLATFORMTHEME,{{QT_PLATFORM_THEME}}
{{/if}}

{{#if HAS_NVIDIA}}
# --------------------------------------------------------------- NVIDIA --
# These variables are required together with nvidia_drm.modeset=1.
env = LIBVA_DRIVER_NAME,nvidia
env = GBM_BACKEND,nvidia-drm
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = NVD_BACKEND,direct
# If you get screen tearing/blackouts, try the following:
# env = WLR_DRM_NO_ATOMIC,1
{{/if}}

{{#if HAS_AMD}}
# ------------------------------------------------------------------ AMD --
env = LIBVA_DRIVER_NAME,radeonsi
env = VDPAU_DRIVER,radeonsi
{{/if}}

# --------------------------------------------------------- applications --
env = TERMINAL,{{CMD_TERMINAL}}
env = BROWSER,{{BROWSER}}
{{#if EDITOR_CMD}}
env = EDITOR,{{EDITOR_CMD}}
env = VISUAL,{{EDITOR_CMD}}
{{/if}}

{{#if EXTRA_ENV_LINES}}
# ------------------------------------------------- user-defined ----------
{{EXTRA_ENV_LINES}}
{{/if}}
