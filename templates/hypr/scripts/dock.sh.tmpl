{{! require: MANAGE_HYPR_CONFIGS }}
{{! mode: 755 }}
#!/usr/bin/env bash
# dock.sh — app bar floating at the screen edge (nwg-dock-hyprland).
# generated by hyprsetup (Settings → Status Bar → Dock).
#
# The dock is independent of the bar backend: it runs next to whichever of
# Waybar, HyprPanel, Quickshell… is selected. Its look comes from
# ~/.config/nwg-dock-hyprland/style.css (generated from the theme), pinned apps
# from ~/.cache/nwg-dock-pinned — pinning via right-click on an icon edits it.
#
# Usage:
#     dock.sh start | stop | toggle | restart
#     dock.sh sync     (re)start if the setting is on, stop if it is off
set -uo pipefail

ENABLED="{{DOCK_ENABLE}}"
ARGS=({{DOCK_ARGS}})
LAUNCHER={{DOCK_LAUNCHER_CMD}}
PIN_CANDIDATES=({{DOCK_PIN_CANDIDATES}})
# The pattern is anchored to the START of the command line, so a shell command
# containing the name (e.g. bash -c "... nwg-dock-hyprland ...") is not killed.
PATTERN="^nwg-dock-hyprland( |\$)"
PINNED="${XDG_CACHE_HOME:-$HOME/.cache}/nwg-dock-pinned"

running() {
    pgrep -f -- "$PATTERN" >/dev/null 2>&1
}

# Do not start with an empty dock: pin the selected terminal, browser and file
# manager. If the file already exists (the user edited it via right-click)
# it is left alone.
seed_pins() {
    [[ -e "$PINNED" ]] && return 0
    local dirs=("${XDG_DATA_HOME:-$HOME/.local/share}/applications"
                /usr/share/applications /var/lib/flatpak/exports/share/applications)
    local id dir found=()
    for id in "${PIN_CANDIDATES[@]}"; do
        for dir in "${dirs[@]}"; do
            if [[ -f "$dir/$id.desktop" ]]; then
                [[ " ${found[*]} " == *" $id "* ]] || found+=("$id")
                break
            fi
        done
    done
    ((${#found[@]})) || return 0
    mkdir -p "$(dirname "$PINNED")"
    printf '%s\n' "${found[@]}" >"$PINNED"
}

start() {
    running && return 0
    if ! command -v nwg-dock-hyprland >/dev/null 2>&1; then
        notify-send -a "Dock" "nwg-dock-hyprland is not installed" \
            "sudo pacman -S nwg-dock-hyprland" 2>/dev/null
        return 1
    fi
    seed_pins
    local args=("${ARGS[@]}")
    [[ -n "$LAUNCHER" ]] && args+=(-c "$LAUNCHER")
    setsid -f nwg-dock-hyprland "${args[@]}" >/dev/null 2>&1 </dev/null
}

stop() {
    pkill -f -- "$PATTERN" 2>/dev/null
    return 0
}

case "${1:-toggle}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 0.3; start ;;
    toggle)  if running; then stop; else start; fi ;;
    sync)
        if [[ "$ENABLED" == true ]]; then stop; sleep 0.3; start; else stop; fi
        ;;
    *)
        printf 'Usage: %s {start|stop|toggle|restart|sync}\n' "$(basename "$0")" >&2
        exit 2
        ;;
esac
