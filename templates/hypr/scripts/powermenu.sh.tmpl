{{! require: MANAGE_HYPR_CONFIGS && !HAS_WLOGOUT }}
{{! mode: 755 }}
#!/usr/bin/env bash
# Power menu — offers lock/sleep/shut down through the launcher.
# generated by hyprsetup (used when wlogout is not installed).
#
# A button that runs "hyprctl dispatch exit" directly logs you out with one
# accidental click; this menu asks for a choice first, and for confirmation on
# destructive options.
set -euo pipefail

# The launcher's prompt flag — empty for launchers that do not support one.
PROMPT_FLAG="{{DMENU_PROMPT_FLAG}}"

pick() {  # <prompt text>  — reads options from stdin
    if [[ -n "$PROMPT_FLAG" ]]; then
        {{CMD_DMENU}} "$PROMPT_FLAG" "$1"
    else
        {{CMD_DMENU}}
    fi
}

confirm() {  # <question> — a second confirmation for destructive options
{{#unless POWERMENU_CONFIRM}}
    return 0    # Settings → Session → Power menu: confirmation off
{{/unless}}
    local answer
    answer=$(printf '%s\n' "No" "Yes" | pick "$1" || true)
    [[ "$answer" == "Yes" ]]
}

options=("󰌾  Lock" "󰤄  Sleep")
{{#if POWERMENU_HIBERNATE}}
options+=("󰒲  Hibernate")
{{/if}}
options+=("󰗽  Log out" "󰜉  Reboot" "󰐥  Shut down")
choice=$(printf '%s\n' "${options[@]}" | pick "Power" || true)

if [[ -z "$choice" ]]; then
    exit 0
fi

# Note: "condition && command" ends the list with status 1 when the condition
# is false and silently kills the script under set -e; hence the explicit if.
case "$choice" in
    *Lock*)
        exec {{LOCK_CMD}} ;;
    *Sleep*)
        exec systemctl suspend ;;
    *Hibernate*)
        if confirm "Hibernate?"; then exec systemctl hibernate; fi ;;
    *"Log out"*)
        if confirm "Log out?"; then exec hyprctl dispatch exit; fi ;;
    *Reboot*)
        if confirm "Reboot?"; then exec systemctl reboot; fi ;;
    *"Shut down"*)
        if confirm "Shut down the computer?"; then exec systemctl poweroff; fi ;;
esac
exit 0
