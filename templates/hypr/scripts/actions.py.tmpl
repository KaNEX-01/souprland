    "medya-onceki": "playerctl", "medya-panel": "barpanel.py",
    "panel": "barpanel.py", "parlaklik": "barpanel.py", "oyun": "gamemode.py", "guncelle": "updates.sh", "bildirimler": "notifylog.py", "gece": "hyprsunset", "cubuk": "bar-toggle.sh",
    "dock": "dock.sh", "gorsellestirici": "visualizer.sh", "kayit": "record.sh",
}


def available(ident: str) -> bool:
    need = NEEDS.get(ident)
    if not need:
        return True
    return (SCRIPTS / need).is_file() if "." in need else have(need)


def write_desktop_entries() -> None:
    """Entries shown in the launchers' app lists."""
    APPS.mkdir(parents=True, exist_ok=True)
    wanted = set()
    entries = [("menu", "Actions", "actions;tools;utilities;", "applications-utilities")]
    entries += [(a[0], a[2], a[3], a[4]) for a in ACTIONS if a[2] and available(a[0])]
    for ident, name, keywords, icon in entries:
        path = APPS / f"souprland-{ident}.desktop"
        wanted.add(path.name)
        argv = [str(Path(__file__).resolve())] + ([] if ident == "menu" else [ident])
        text = ("[Desktop Entry]\nType=Application\n"
                f"Name={name}\nComment=Souprland action\n"
                f"Exec={' '.join(shlex.quote(a) for a in argv)}\n"
                f"Icon={icon}\nTerminal=false\nCategories=Utility;\n"
                f"Keywords={keywords}\nX-Souprland-Action=true\n")
        if not path.is_file() or path.read_text(encoding="utf-8") != text:
            path.write_text(text, encoding="utf-8")
    for stale in APPS.glob("souprland-*.desktop"):
        if stale.name not in wanted and "X-Souprland-Action" in stale.read_text(errors="ignore"):
            stale.unlink()


def main() -> int:
    args = sys.argv[1:]
    if args and args[0] == "desktop":
        write_desktop_entries()
        return 0
    if args and args[0] == "sarki-durum":
        song_status()
        return 0
    table = {a[0]: a[5] for a in ACTIONS}
    if args:
        action = table.get(args[0])
        if action is None:
            print(f"unknown action: {args[0]} ({', '.join(table)})", file=sys.stderr)
            return 2
        action()
        return 0
    picked = dmenu([a[1] for a in ACTIONS if available(a[0])], "Actions")
    for ident, line, *_rest in ACTIONS:
        if picked == line:
            table[ident]()
            break
    return 0


if __name__ == "__main__":
    sys.exit(main())
