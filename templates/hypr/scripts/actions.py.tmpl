#!/usr/bin/env python3
"""Actions: small tools run from the launcher (song recognition, color, emoji…).

generated by hyprsetup. Independent of the launcher: the list is shown in
the selected launcher's dmenu mode ({{CMD_DMENU}}), so it works the same in
wofi, rofi, fuzzel, tofi and walker.

Two ways in:
  * MOD+A → the actions menu (this script, no arguments).
  * The launcher's app list: every action has a .desktop entry
    (~/.local/share/applications/souprland-*.desktop) that shows up when you
    type "song" or "color". "actions.py desktop" writes the entries; the
    settings app calls it whenever this file is refreshed.

Usage:
    actions.py                 open the menu
    actions.py <action>        run an action directly (e.g. sarki)
    actions.py desktop         write/clean up the .desktop entries

Song recognition (songrec): the audio playing on the computer (the default
output's monitor source) or the microphone is recorded for a few seconds and
recognized on Shazam's server; the result arrives as a notification with the
cover art. Nothing is saved anywhere.
"""

import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import unicodedata
import urllib.parse
import urllib.request
from pathlib import Path

DMENU = "{{CMD_DMENU}}"
PROMPT_FLAG = "{{DMENU_PROMPT_FLAG}}"
SCRIPTS = Path(__file__).resolve().parent
HOME = Path.home()
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "hyprsetup"
APPS = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share") / "applications"
APP_NAME = "Souprland"
#: Recording length for song recognition (s). Shazam matches well with 6-10 s.
# Settings → Session → Screen recording; empty = XDG Pictures/Screenshots
SCREENSHOT_DIR = "{{SCREENSHOT_DIR_PY}}"
LISTEN_SECONDS = int("{{SONG_LISTEN_SECONDS}}" or 9)   # Settings → Session → Desktop tools
#: Song recognition state ("dinliyor-<pc|mic>" = listening / "taniyor" =
#: recognizing; internal ids); the bar's custom/shazam button reads it and is
#: refreshed with RTMIN+11 on change.
SONG_STATE = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "souprland-sarki.state"


# ---------------------------------------------------------------- helpers --
def have(name: str) -> bool:
    return shutil.which(name) is not None


def out(*argv: str, timeout: float = 10, data: str | None = None) -> str:
    try:
        return subprocess.run(argv, capture_output=True, text=True, input=data,
                              timeout=timeout, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def spawn(*argv: str) -> None:
    try:
        subprocess.Popen(argv, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def notify(title: str, body: str = "", icon: str = "", replace: str = "",
           urgency: str = "normal", timeout_ms: int = 6000) -> str:
    """Shows a notification; returns its id for later updates."""
    if not have("notify-send"):
        return ""
    argv = ["notify-send", "-a", APP_NAME, "-u", urgency, "-t", str(timeout_ms), "-p"]
    if icon:
        argv += ["-i", icon]
    if replace.isdigit():
        argv += ["-r", replace]
    argv += [title, body]
    return out(*argv).strip()


def dmenu(items: list[str], prompt: str = "") -> str:
    """The selected launcher's list mode; an empty list = free text input."""
    command = DMENU
    if not command:
        command = next((c for c in ("wofi --dmenu", "rofi -dmenu", "fuzzel --dmenu")
                        if have(c.split()[0])), "")
    if not command:
        notify("Actions", "No launcher available to show the list (wofi/rofi/fuzzel).")
        return ""
    argv = shlex.split(command)
    if prompt and PROMPT_FLAG:
        argv += [PROMPT_FLAG, prompt]
    return out(*argv, data="\n".join(items) + ("\n" if items else ""),
               timeout=600).strip()


def copy(text: str) -> None:
    if have("wl-copy"):
        subprocess.run(["wl-copy"], input=text, text=True, check=False)


# --------------------------------------------------------------- song ----
def song_state(value: str) -> None:
    """Writes the state (empty = done) and refreshes the bar button."""
    try:
        if value:
            SONG_STATE.write_text(f"{value} {os.getpid()}\n", encoding="utf-8")
        else:
            SONG_STATE.unlink(missing_ok=True)
    except OSError:
        pass
    if have("pkill"):
        subprocess.run(["pkill", "-RTMIN+11", "-x", "waybar"], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def song_busy() -> bool:
    """Is another recognition still running (a double click must not start two recordings)."""
    try:
        pid = int(SONG_STATE.read_text(encoding="utf-8").split()[-1])
        os.kill(pid, 0)
        return True
    except (OSError, ValueError, IndexError):
        return False


def recognize(source: str) -> None:
    """source: "pc" (what the computer is playing) or "mic" (microphone)."""
    if song_busy():
        notify("Song recognition", "Already listening…", "audio-input-microphone-symbolic",
               timeout_ms=2500)
        return
    song_state(f"dinliyor-{source}")
    try:
        _recognize(source)
    finally:
        if _own_state():              # early exits (error, no match)
            song_state("")


def _own_state() -> bool:
    try:
        return SONG_STATE.read_text(encoding="utf-8").split()[-1] == str(os.getpid())
    except (OSError, IndexError):
        return False


def song_status() -> None:
    """Waybar JSON for the bar's custom/shazam button."""
    state = ""
    if song_busy():
        try:
            state = SONG_STATE.read_text(encoding="utf-8").split()[0]
        except (OSError, IndexError):
            state = ""
    if state.startswith("dinliyor"):
        where = "microphone" if state.endswith("mic") else "computer audio"
        row = {"text": "\U000f036c listening…", "class": "listening",
               "tooltip": f"Listening ({where}), {LISTEN_SECONDS} s"}
    elif state == "taniyor":
        row = {"text": "\U000f051f recognizing…", "class": "recognizing",
               "tooltip": "Asking Shazam"}
    else:
        row = {"text": "\U000f075a", "class": "idle",
               "tooltip": "Recognize song (Shazam)\nLeft click: computer audio\n"
                          "Right click: from the microphone"}
    print(json.dumps(row, ensure_ascii=False), flush=True)


def _recognize(source: str) -> None:
    if not have("songrec"):
        notify("Song recognition", "songrec is not installed (sudo pacman -S songrec).",
               "dialog-warning")
        return
    if source == "pc":
        sink = out("pactl", "get-default-sink").strip()
        device = f"{sink}.monitor" if sink else "@DEFAULT_MONITOR@"
        where = "computer audio"
    else:
        device = out("pactl", "get-default-source").strip() or "@DEFAULT_SOURCE@"
        where = "microphone"
    nid = notify("Listening…", f"{where} · {LISTEN_SECONDS} s",
                 "audio-input-microphone-symbolic", timeout_ms=(LISTEN_SECONDS + 20) * 1000)
    with tempfile.TemporaryDirectory(prefix="souprland-sarki-") as tmp:
        wav = Path(tmp) / "recording.wav"
        # SIGTERM when time is up: parecord writes the data size into the WAV
        # header only on a clean shutdown. subprocess.run(timeout=) sends
        # SIGKILL, the header stays empty and songrec says "No match" to everything.
        try:
            rec = subprocess.Popen(["parecord", f"--device={device}",
                                    "--file-format=wav", str(wav)],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            try:
                rec.wait(timeout=LISTEN_SECONDS)
            except subprocess.TimeoutExpired:
                rec.terminate()       # time is up = recording done
                try:
                    rec.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    rec.kill()
                    rec.wait()
        except OSError:
            notify("Song recognition", "parecord not found (libpulse).", "dialog-warning",
                   replace=nid)
            return
        if not wav.is_file() or wav.stat().st_size < 50_000:
            notify("Song recognition", "Could not record audio.", "dialog-warning", replace=nid)
            return
        song_state("taniyor")
        notify("Recognizing…", "Asking Shazam", "content-loading-symbolic",
               replace=nid, timeout_ms=30000)
        raw = out("songrec", "recognize", "-j", str(wav), timeout=40)
    try:
        track = (json.loads(raw) or {}).get("track") or {}
    except ValueError:
        track = {}
    if not track:
        hint = ("Is something playing? Very quiet audio or speech may not match."
                if source == "pc" else "Move the microphone closer to the sound and try again.")
        notify("No song found", hint, "dialog-question", replace=nid)
        return
    title, artist = track.get("title", "?"), track.get("subtitle", "?")
    cover = ""
    art = (track.get("images") or {}).get("coverart", "")
    if art:
        CACHE.mkdir(parents=True, exist_ok=True)
        cover = str(CACHE / "song-cover.jpg")
        try:
            urllib.request.urlretrieve(art, cover)
        except OSError:
            cover = ""
    copy(f"{artist} – {title}")
    query = urllib.parse.quote_plus(f"{artist} {title}")
    # The result notification has buttons: notify-send --wait waits for the chosen one.
    # The wait happens in the background (in a forked process); the menu closes at once.
    song_state("")
    if os.fork() != 0:
        return
    os.setsid()
    argv = ["notify-send", "-a", APP_NAME, "-t", "15000", "-w",
            "-i", cover or "audio-x-generic",
            "-A", "spotify=Search Spotify", "-A", "youtube=Search YouTube",
            "-A", "shazam=Shazam page"]
    if nid.isdigit():
        argv += ["-r", nid]
    choice = out(*argv, title, f"{artist}\n(copied to clipboard)", timeout=20).strip()
    urls = {"spotify": f"https://open.spotify.com/search/{query}",
            "youtube": f"https://www.youtube.com/results?search_query={query}",
            "shazam": track.get("url", "")}
    if urls.get(choice):
        spawn("xdg-open", urls[choice])
    os._exit(0)


# ---------------------------------------------------------------- tools --
def color() -> None:
    if not have("hyprpicker"):
        notify("Color picker", "hyprpicker is not installed.", "dialog-warning")
        return
    value = out("hyprpicker", "-a", "-f", "hex", timeout=120).strip()
    if value:
        notify(f"Color: {value}", "copied to clipboard", "color-select-symbolic")


def emoji() -> None:
    cache = CACHE / "emoji.txt"
    if not cache.is_file():
        rows = []
        for start, end in ((0x1F300, 0x1F5FF), (0x1F600, 0x1F64F), (0x1F680, 0x1F6FF),
                           (0x1F900, 0x1F9FF), (0x1FA70, 0x1FAFF), (0x2600, 0x26FF),
                           (0x2700, 0x27BF)):
            for code in range(start, end + 1):
                name = unicodedata.name(chr(code), "")
                if name:
                    rows.append(f"{chr(code)}  {name.lower()}")
        CACHE.mkdir(parents=True, exist_ok=True)
        cache.write_text("\n".join(rows), encoding="utf-8")
    picked = dmenu(cache.read_text(encoding="utf-8").splitlines(), "Emoji")
    if picked:
        char = picked.split()[0]
        copy(char)
        notify(f"{char} copied", "", "face-smile-symbolic", timeout_ms=2500)


def screenshot(kind: str) -> None:
    if SCREENSHOT_DIR:
        folder = Path(os.path.expandvars(os.path.expanduser(SCREENSHOT_DIR)))
    else:
        folder = (Path(out("xdg-user-dir", "PICTURES").strip() or HOME / "Pictures")
                  / "Screenshots")
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / time.strftime("Screenshot_%Y-%m-%d_%H.%M.%S.png")
    argv = ["grim"]
    if kind == "bolge":
        region = out("slurp", timeout=120).strip()
        if not region:
            return
        argv += ["-g", region]
    elif kind == "pencere":
        win = json.loads(out("hyprctl", "-j", "activewindow") or "{}")
        if win.get("at"):
            (x, y), (w, h) = win["at"], win["size"]
            argv += ["-g", f"{x},{y} {w}x{h}"]
    else:
        mon = next((m for m in json.loads(out("hyprctl", "-j", "monitors") or "[]")
                    if m.get("focused")), None)
        if mon:
            argv += ["-o", mon["name"]]
    time.sleep(0.25)                  # let the menu close and leave the screen
    subprocess.run([*argv, str(path)], check=False)
    if path.is_file():
        if have("wl-copy"):
            with open(path, "rb") as image:
                subprocess.run(["wl-copy", "--type", "image/png"], stdin=image, check=False)
        notify("Screenshot", f"{path.name}\nalso copied to clipboard", str(path))


def calculator() -> None:
    expression = dmenu([], "Calculate (e.g. 12*7, 5 km to mi)")
    while expression:
        if have("qalc"):
            result = out("qalc", "-t", expression).strip()
        else:
            try:
                result = str(eval(expression, {"__builtins__": {}}, {}))  # noqa: S307
            except Exception:              # noqa: BLE001
                result = "error"
        copy(result)
        # The result stays in the list; type a new expression, Esc exits.
        again = dmenu([f"= {result}   (copied to clipboard)"], "Calculate")
        expression = "" if not again or again.startswith("= ") else again


def websearch() -> None:
    query = dmenu([], "Search the web")
    if query:
        spawn("xdg-open", "https://duckduckgo.com/?q=" + urllib.parse.quote_plus(query))


def clipboard() -> None:
    if not have("cliphist"):
        notify("Clipboard history", "cliphist is not installed.", "dialog-warning")
        return
    picked = dmenu(out("cliphist", "list").splitlines(), "Clipboard")
    if picked:
        data = subprocess.run(["cliphist", "decode"], input=picked.encode(),
                              capture_output=True, check=False).stdout
        subprocess.run(["wl-copy"], input=data, check=False)


def power() -> None:
    options = {
        "🔒  Lock": (["loginctl", "lock-session"], False),
        "🌙  Sleep": (["systemctl", "suspend"], False),
        "🚪  Log out": (["hyprctl", "dispatch", "exit"], True),
        "🔄  Reboot": (["systemctl", "reboot"], True),
        "⏻  Shut down": (["systemctl", "poweroff"], True),
    }
    picked = dmenu(list(options), "Power")
    if picked not in options:
        return
    argv, confirm = options[picked]
    if confirm and dmenu(["No", "Yes"], picked.split(None, 1)[1] + "?") != "Yes":
        return
    spawn(*argv)


def script(name: str, *args: str) -> None:
    path = SCRIPTS / name
    if path.is_file():
        spawn(str(path), *args)
    else:
        notify("Actions", f"{name} is not part of this setup.", "dialog-warning")


# -------------------------------------------------------------- media ----
def media(*command: str) -> None:
    """media.sh cmd …: picks the same player as the bar (playing, else last playing)."""
    if (SCRIPTS / "media.sh").is_file():
        out(str(SCRIPTS / "media.sh"), "cmd", *command)
    elif have("playerctl"):
        out("playerctl", *command)
    else:
        notify("Media", "playerctl is not installed.", "dialog-warning")


# ---------------------------------------------------- Wallpaper Engine ----
WPENGINE = "linux-wallpaper"   # the kernel truncates process names to 15 characters
SETTINGS = (Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
            / "hyprsetup/settings.conf")


def _workshop_items() -> list[tuple[str, str, str]]:
    """Installed Workshop wallpapers: (id, title, type)."""
    found: dict[str, tuple[str, str, str]] = {}
    for steam in (HOME / ".local/share/Steam", HOME / ".steam/steam",
                  HOME / ".var/app/com.valvesoftware.Steam/.local/share/Steam"):
        base = steam / "steamapps/workshop/content/431960"
        if not base.is_dir():
            continue
        for item in sorted(base.iterdir()):
            if item.name in found or not (item / "project.json").is_file():
                continue
            try:
                meta = json.loads((item / "project.json").read_text(errors="ignore"))
            except ValueError:
                meta = {}
            found[item.name] = (item.name, str(meta.get("title") or item.name).strip(),
                                str(meta.get("type") or "").lower())
    return sorted(found.values(), key=lambda i: i[1].casefold())


def _set_wpengine_id(ident: str) -> None:
    """Persists the choice: settings.conf (next render) + the generated script."""
    for path, prefix, line in ((SETTINGS, "WPENGINE_ID=", f'WPENGINE_ID="{ident}"'),
                               (SCRIPTS / "wallpaperengine.sh", "ID=", f'ID="{ident}"')):
        if not path.is_file():
            continue
        lines = path.read_text(encoding="utf-8").splitlines()
        for index, old in enumerate(lines):
            if old.startswith(prefix):
                lines[index] = line
                break
        else:
            if path == SETTINGS:
                lines.append(line)
        path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def wpengine_pick() -> None:
    if not (SCRIPTS / "wallpaperengine.sh").is_file():
        notify("Wallpaper Engine", "Wallpaper Engine is not selected in this profile.",
               "dialog-warning")
        return
    items = _workshop_items()
    if not items:
        notify("Wallpaper Engine", "No installed Workshop wallpapers found "
               "(subscribe via Steam → Wallpaper Engine → Workshop).", "dialog-warning")
        return
    icons = {"scene": "🎬", "video": "📼", "web": "🌐"}
    rows = [f"{icons.get(kind, '🖼️')}  {title}  ·  {ident}" for ident, title, kind in items]
    picked = dmenu(rows, "Wallpaper Engine")
    if picked not in rows:
        return
    ident, title, _kind = items[rows.index(picked)]
    _set_wpengine_id(ident)
    spawn(str(SCRIPTS / "wallpaperengine.sh"), "start")
    notify("Wallpaper Engine", title, "preferences-desktop-wallpaper")


def wpengine_pause() -> None:
    pids = out("pgrep", "-x", WPENGINE).split()
    if not pids:
        notify("Wallpaper Engine", "Not running.", "dialog-information")
        return
    try:
        state = Path(f"/proc/{pids[0]}/stat").read_text().split(") ", 1)[1][0]
    except (OSError, IndexError):
        state = ""
    paused = state == "T"
    out("pkill", "-CONT" if paused else "-STOP", "-x", WPENGINE)
    notify("Wallpaper Engine", "Resumed" if paused else
           "Paused (CPU/GPU idle)", "preferences-desktop-wallpaper")


# ----------------------------------------------------------- night light --
def night() -> None:
    if not have("hyprsunset"):
        notify("Night light", "hyprsunset is not installed.", "dialog-warning")
        return
    if out("pgrep", "-x", "hyprsunset").strip():
        out("pkill", "-x", "hyprsunset")
        notify("Night light", "Turned off", "weather-clear")
    else:
        spawn("hyprsunset", "-t", "{{NIGHT_TEMP}}" or "4000")
        notify("Night light", "Turned on", "weather-clear-night")


