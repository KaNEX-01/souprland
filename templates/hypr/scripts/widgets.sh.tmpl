{{! require: MANAGE_HYPR_CONFIGS && HAS_EWW || MANAGE_HYPR_CONFIGS && HAS_QUICKSHELL }}
{{! mode: 755 }}
#!/usr/bin/env bash
# widgets.sh — show/hide the desktop widgets (MOD+G).
# generated by hyprsetup.
#
# Why it exists: widgets are drawn on the "bottom" layer by default, i.e.
# BELOW windows. On a tiling desktop the screen is almost always covered with
# windows, so this amounted to "I turned the widgets on but see nothing".
# There are two ways out, both handled here:
#
#   * With WIDGET_LAYER="top" widgets go above windows; since having them
#     always on top is annoying, this keybinding toggles them.
#   * With WIDGET_AUTOSTART=false they are not shown at login at all.
#
# Usage:
#     widgets.sh toggle    close if open, open if closed   (MOD+G)
#     widgets.sh show      open     (autostart calls this at login)
#     widgets.sh hide      close
set -uo pipefail

{{#if HAS_QUICKSHELL}}
# Quickshell engine: every widget lives in quickshell/hyprsetup/shell.qml,
# which shows/hides them itself (IpcHandler "widgets"); nothing to open one
# by one. Without this branch MOD+G did nothing and WIDGET_AUTOSTART was
# ignored with Quickshell.
case "${1:-toggle}" in
    toggle|show|hide)
        exec quickshell -p ~/.config/quickshell/hyprsetup/shell.qml ipc call widgets "${1:-toggle}" ;;
    *)
        echo "usage: widgets.sh toggle|show|hide" >&2; exit 2 ;;
esac
{{/if}}
WIDGETS=({{WIDGET_NAMES}})

if ! command -v eww >/dev/null 2>&1; then
    notify-send -a "Widgets" "eww is not installed" 2>/dev/null || true
    exit 1
fi
if ((${#WIDGETS[@]} == 0)); then
    notify-send -a "Widgets" "No widgets enabled" \
        "Add some on the settings app's Widgets page" 2>/dev/null || true
    exit 0
fi

# An "open" call before the daemon is ready is silently dropped. The autostart
# line used to rely on a fixed "sleep 1" for that; here we actually wait
# (up to ~3 s).
ensure_daemon() {
    eww ping >/dev/null 2>&1 && return 0
    eww daemon >/dev/null 2>&1 &
    for _ in $(seq 30); do
        eww ping >/dev/null 2>&1 && return 0
        sleep 0.1
    done
    return 1
}

show() {
    ensure_daemon || { notify-send -a "Widgets" "Could not start the eww daemon" 2>/dev/null; exit 1; }
    eww open-many "${WIDGETS[@]}" >/dev/null 2>&1
}

hide() {
    eww ping >/dev/null 2>&1 || return 0
    eww close "${WIDGETS[@]}" >/dev/null 2>&1
}

case "${1:-toggle}" in
    show) show ;;
    hide) hide ;;
    toggle)
        # "Open" means: AT LEAST ONE of our widgets is in the active windows
        # list. eww's own "active-windows" output has the form
        # "<id>: <name>".
        open_now=0
        if eww ping >/dev/null 2>&1; then
            while IFS= read -r line; do
                name="${line#*: }"
                for want in "${WIDGETS[@]}"; do
                    [[ "$name" == "$want" ]] && { open_now=1; break 2; }
                done
            done < <(eww active-windows 2>/dev/null)
        fi
        if ((open_now)); then hide; else show; fi
        ;;
    *)
        printf 'Usage: %s [toggle|show|hide]\n' "${0##*/}" >&2
        exit 2 ;;
esac
