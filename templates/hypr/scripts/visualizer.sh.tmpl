{{! require: MANAGE_HYPR_CONFIGS }}
{{! mode: 755 }}
#!/usr/bin/env bash
# visualizer.sh — spectrum bars along the bottom screen edge reacting to music.
# generated by hyprsetup (Settings → Widgets → Audio visualizer).
#
# cava (github.com/karlstav/cava) listens to what is playing (the default
# output's monitor); kitty's panel mode puts it on the "bottom" layer at the
# bottom edge: above the wallpaper (Wallpaper Engine included), below windows.
# The background is fully transparent. VIS_MODE=strip reserves space for it
# below the windows (bars always visible); desktop does not push windows
# (visible only on an empty workspace). Bass in the middle, treble at the
# edges (cava's stereo mode).
#
# Note: linux-wallpaperengine's own audio spectrum (g_AudioSpectrum*) always
# reaches effects as zeros in this version; that is why the visualizer is a
# separate layer above the wallpaper rather than inside it.
#
# Usage:
#     visualizer.sh start | stop | toggle | restart
#     visualizer.sh sync     (re)start if the setting is on, stop if it is off
set -uo pipefail

ENABLED="{{VIS_ENABLE}}"
MODE="{{VIS_MODE}}"
COLOR="{{VIS_COLOR}}"
BRIGHTNESS="{{VIS_BRIGHTNESS}}"
HEIGHT="{{VIS_HEIGHT}}"
WIDTH="{{VIS_WIDTH}}"
MONITOR="{{VIS_MONITOR}}"
ACCENT="{{HEX_ACCENT}}"
BG="{{HEX_BG_DARK}}"
# The pattern is anchored to the START of the command line: searching for
# "--class=…" alone would also match and kill a shell carrying that string.
CLASS="hyprsetup-visualizer"
PATTERN="^kitty \+kitten panel .*--class=$CLASS( |\$)"
CONF="${XDG_RUNTIME_DIR:-/tmp}/hyprsetup-visualizer.cava"

running() {
    pgrep -f -- "$PATTERN" >/dev/null 2>&1
}

# Blends a "#rrggbb" color toward the background: $3 = 0-100 brightness.
dim() {
    local c="${1#\#}" b="${2#\#}" p="$3" out="" i x y
    for i in 0 2 4; do
        x=$((16#${c:i:2})); y=$((16#${b:i:2}))
        out+=$(printf '%02x' $(( y + (x - y) * p / 100 )))
    done
    printf '#%s' "$out"
}

write_conf() {
    local base="${COLOR:-$ACCENT}"
    [[ "$base" == \#* ]] || base="#$base"
    local top bottom
    top="$(dim "$base" "$BG" "$BRIGHTNESS")"
    bottom="$(dim "$base" "$BG" $(( BRIGHTNESS * 55 / 100 )))"
    cat > "$CONF" <<EOF
[general]
framerate = 60
autosens = 1
bars = 0
bar_width = 1
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = noncurses
channels = stereo
mono_option = average

[color]
gradient = 1
gradient_count = 2
gradient_color_1 = '$bottom'
gradient_color_2 = '$top'

[smoothing]
noise_reduction = 77
EOF
}

start() {
    running && return 0
    for need in kitty cava; do
        if ! command -v "$need" >/dev/null 2>&1; then
            notify-send -a "Audio visualizer" "$need is required" \
                "sudo pacman -S $need" 2>/dev/null
            return 1
        fi
    done
    write_conf
    # Empty VIS_MONITOR: one panel per display; otherwise only that display.
    # Width is a percentage of the display: margins are computed from each
    # display's own width.
    # Mode: "strip" reserves space below windows (exclusive zone = height),
    # bars always visible; "desktop" stays below windows like the wallpaper,
    # visible only on an empty workspace.
    local zone=0
    [[ "$MODE" == strip ]] && zone="$HEIGHT"
    local name width side
    # At login displays may not be added yet (exec-once runs early); with an
    # empty list no panel would open. Wait up to ~20 s.
    local _
    for _ in $(seq 1 40); do
        [[ "$(hyprctl monitors -j 2>/dev/null)" == *'"name"'* ]] && break
        sleep 0.5
    done
    while read -r name width; do
        [[ -n "$name" ]] || continue
        side=$(( width * (100 - WIDTH) / 200 ))
        # background_image=none: the terminal background image from kitty.conf
        # (Terminal › Background) carried over to the panel and showed up
        # behind the bars.
        local panel=(kitty +kitten panel --edge=bottom --layer=bottom
                     --lines="${HEIGHT}px" --exclusive-zone="$zone" --override-exclusive-zone
                     --margin-left="$side" --margin-right="$side"
                     --focus-policy=not-allowed --class="$CLASS"
                     --output-name="$name"
                     -o background_opacity=0 -o window_padding_width=0
                     -o cursor_trail=0 -o font_size=6 -o background_image=none)
        setsid -f "${panel[@]}" cava -p "$CONF" >/dev/null 2>&1 </dev/null
    done < <(hyprctl monitors -j 2>/dev/null | python3 -c '
import json, sys
want = sys.argv[1]
for m in json.load(sys.stdin):
    if not want or m["name"] == want:
        print(m["name"], int(m["width"] / (m.get("scale") or 1)))' "$MONITOR")
}

stop() {
    pkill -f -- "$PATTERN" 2>/dev/null
    return 0
}

case "${1:-toggle}" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 0.3; start ;;
    toggle)  if running; then stop; else start; fi ;;
    sync)
        if [[ "$ENABLED" == true ]]; then stop; sleep 0.3; start; else stop; fi
        ;;
    *) echo "usage: $0 start|stop|toggle|restart|sync" >&2; exit 2 ;;
esac
