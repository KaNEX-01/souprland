{{! require: MANAGE_HYPR_CONFIGS && HAS_WAYBAR }}
{{! mode: 755 }}
#!/usr/bin/env python3
"""Bar detail panel: opens on a left click on a Waybar item.

generated by hyprsetup. The settings app's package draws the panel
(python/hyprsetup/gui/barpanel.py); colors and bar sizes are written in
here. If the package is missing (or GTK is), it falls back to the old
behavior: the tab's full app opens, so a click is never a dead end.

Usage:  barpanel.py ses|ag|bluetooth|pil|parlaklik|takvim|medya|sistem|kayit
"""

import os
import shutil
import signal
import subprocess
import sys
from pathlib import Path

VALUES = {
    "HEX_BG": "{{HEX_BG}}",
    "HEX_BG_DARK": "{{HEX_BG_DARK}}",
    "HEX_SURFACE": "{{HEX_SURFACE}}",
    "HEX_FG": "{{HEX_FG}}",
    "HEX_SUBTEXT": "{{HEX_SUBTEXT}}",
    "HEX_ACCENT": "{{HEX_ACCENT}}",
    "HEX_ACCENT2": "{{HEX_ACCENT2}}",
    "FONT_FAMILY": "{{FONT_FAMILY}}",
    "ROUNDING": "{{ROUNDING}}",
    "BAR_POSITION": "{{BAR_POSITION}}",
    "BAR_HEIGHT": "{{BAR_HEIGHT}}",
    "BAR_MARGIN": "{{BAR_MARGIN}}",
    "CMD_TERMINAL": "{{CMD_TERMINAL}}",
    "TERMINAL_EXEC_FLAG": "{{TERMINAL_EXEC_FLAG}}",
    "RECORD_DIR": "{{RECORD_DIR}}",
    "SCREENSHOT_DIR_SH": "{{SCREENSHOT_DIR_SH}}",
    "REPLAY_SECONDS": "{{REPLAY_SECONDS}}",
    "MOD_KEY": "{{MOD_KEY}}",
    "NIGHT_TEMP": "{{NIGHT_TEMP}}",
    "NOTIFY_HISTORY": "{{NOTIFY_HISTORY}}",
    "BRIGHTNESS_DDC": "{{BRIGHTNESS_DDC}}",
    "PANEL_APP_VOLUME": "{{PANEL_APP_VOLUME}}",
}

#: Where to look for the package: the installed app, then the copy that generated this file.
APP_PATHS = ((os.environ["HYPRSETUP_PYTHON"],)
             if os.environ.get("HYPRSETUP_PYTHON") else
             (os.path.expanduser("~/.local/share/hyprsetup/python"),
              "/usr/share/hyprsetup/python",
              "{{SETUP_PYTHON}}"))

#: Per-tab legacy app used when the panel cannot open.
FALLBACK = {
    "ses": ["pavucontrol"],
    "ag": ["{{CMD_TERMINAL}}", "{{TERMINAL_EXEC_FLAG}}", "nmtui"],
    "bluetooth": ["blueman-manager"],
}

#: gtk4-layer-shell must be loaded BEFORE libwayland-client; otherwise the
#: window opens as an ordinary window instead of a layer surface.
LAYER_LIB = "/usr/lib/libgtk4-layer-shell.so"


def fallback(tab: str) -> int:
    argv = [a for part in FALLBACK.get(tab, []) for a in part.split()]
    if argv and shutil.which(argv[0]):
        subprocess.Popen(argv, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


_RUN = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp")
_PID = _RUN / "hyprsetup-barpanel.pid"
_REQUEST = _RUN / "hyprsetup-barpanel.request"
_MTIME = _RUN / "hyprsetup-barpanel.mtime"


def _running_pid() -> int:
    try:
        pid = int(_PID.read_text().strip())
        os.kill(pid, 0)
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
        return pid if b"barpanel" in cmdline else 0
    except (OSError, ValueError):
        return 0


def _fast_signal(tab: str, cur_mtime: str) -> bool:
    """Fast path (~8 ms): signal the resident panel before LD_PRELOAD execve or GTK import."""
    pid = _running_pid()
    if not pid:
        return False
    if tab == "--daemon":
        return True
    try:
        if _MTIME.is_file() and _MTIME.read_text().strip() != cur_mtime:
            os.kill(pid, signal.SIGTERM)
            return False
    except OSError:
        pass
    try:
        _REQUEST.write_text(tab)
        os.kill(pid, signal.SIGUSR1)
        return True
    except OSError:
        return False


def main() -> int:
    tab = sys.argv[1] if len(sys.argv) > 1 else "ses"
    try:
        cur_mtime = str(int(os.path.getmtime(__file__)))
    except OSError:
        cur_mtime = ""
    if _fast_signal(tab, cur_mtime):
        return 0
    if cur_mtime:
        os.environ["HYPRSETUP_BARPANEL_MTIME"] = cur_mtime
    if os.path.isfile(LAYER_LIB) and LAYER_LIB not in os.environ.get("LD_PRELOAD", ""):
        env = dict(os.environ, LD_PRELOAD=":".join(
            filter(None, (LAYER_LIB, os.environ.get("LD_PRELOAD")))))
        os.execve(sys.executable, [sys.executable, *sys.argv], env)
    for path in APP_PATHS:
        if not os.path.isfile(os.path.join(path, "hyprsetup", "gui", "barpanel.py")):
            continue
        sys.path.insert(0, path)
        try:
            from hyprsetup.gui import barpanel
        except (ImportError, ValueError):
            sys.path.remove(path)
            continue
        return barpanel.run_with(VALUES, tab)
    return 0 if tab == "--daemon" else fallback(tab)


if __name__ == "__main__":
    sys.exit(main())
