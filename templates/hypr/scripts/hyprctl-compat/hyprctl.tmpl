{{! require: MANAGE_HYPR_CONFIGS && HAS_HYPRLAND_EXTRAS }}
{{! mode: 755 }}
#!/usr/bin/env bash
# hyprctl shim for hyprshade — generated by hyprsetup.
#
# hyprshade 5 talks to Hyprland's Lua config only: it sets the filter with
# `hyprctl eval "hl.config({ decoration = { screen_shader = '…' } })"` and
# reads it back as "decoration.screen_shader". In a hyprlang (conf) session —
# this project's default — both silently fail, so the night light and the
# screen filters never showed up. hyprshade is run with this folder first in
# PATH (shader.sh, the hyprshade.service drop-in, the settings app); here the
# two Lua calls are translated, everything else goes to the real hyprctl
# unchanged. In a Lua session nothing is translated.
real=/usr/bin/hyprctl
provider=$("$real" -j status 2>/dev/null | sed -n 's/.*"configProvider": *"\([^"]*\)".*/\1/p')
if [[ "$provider" == "lua" ]]; then
    exec "$real" "$@"
fi
re_set="^hl\.config\(\{ decoration = \{ screen_shader = '(.*)' \} \}\)$"
if [[ "${1:-}" == "eval" && "${2:-}" =~ $re_set ]]; then
    value=${BASH_REMATCH[1]}
    value=${value//\\\'/\'}
    value=${value//\\\\/\\}
    exec "$real" keyword decoration:screen_shader "$value"
fi
args=()
for arg in "$@"; do
    [[ "$arg" == "decoration.screen_shader" ]] && arg="decoration:screen_shader"
    args+=("$arg")
done
exec "$real" "${args[@]}"
