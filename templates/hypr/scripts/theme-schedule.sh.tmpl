{{! require: MANAGE_HYPR_CONFIGS && THEME_SCHEDULE }}
{{! mode: 755 }}
#!/usr/bin/env bash
# theme-schedule.sh — day/night theme (generated by hyprsetup).
# The systemd user timer (hyprsetup-theme.timer) runs this; it works out
# which theme should be active right now and applies it if needed
# (python/hyprsetup/themeschedule.py).
set -uo pipefail
root="${XDG_DATA_HOME:-$HOME/.local/share}/hyprsetup"
# Without an installed copy, the source tree that generated this file is used.
[[ -d "$root/python/hyprsetup" ]] || root="$(dirname "{{SETUP_PYTHON}}")"
PYTHONPATH="$root/python${PYTHONPATH:+:$PYTHONPATH}" \
    exec python3 -m hyprsetup theme-schedule --root "$root"
