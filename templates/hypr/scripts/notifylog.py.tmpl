{{! mode: 755 }}
#!/usr/bin/env python3
"""notifylog.py — notification history (independent of the notification daemon).

generated by hyprsetup. The bar panel's "Notifications" tab reads this.

The history interfaces of swaync, mako and dunst have nothing in common
(swaync does not even have a listing command). Instead, this listens on the
session bus in monitor mode (org.freedesktop.DBus.Monitoring.BecomeMonitor)
and records every ``Notify`` call — whichever daemon is running.

History lives only under ``$XDG_RUNTIME_DIR`` (in memory, tmpfs): it is
deleted at logout and never written to disk. The last 50 notifications are kept.

Usage:
    notifylog.py run              recorder (runs at session start)
    notifylog.py list             history, JSON
    notifylog.py clear            clear the history
    notifylog.py dnd [on|off|toggle|status]   do-not-disturb mode
    notifylog.py status           JSON for Waybar (bell / muted + count)
    notifylog.py sync             restart the recorder (when the script changes)
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp")
LOG = RUNTIME / "hyprsetup-notifications.json"
PID = RUNTIME / "hyprsetup-notifylog.pid"
KEEP = int("{{NOTIFY_HISTORY_KEEP}}" or 50)
#: Settings → Session → Desktop tools → Notification history.
ENABLED = "{{NOTIFY_HISTORY}}" == "true"
#: Waybar's custom/notifications module is refreshed with this signal.
WAYBAR_SIGNAL = 13
NOTIFIER = "{{NOTIFIER}}"


def load() -> list[dict]:
    try:
        return json.loads(LOG.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []


def save(items: list[dict]) -> None:
    tmp = LOG.with_suffix(".tmp")
    tmp.write_text(json.dumps(items[-KEEP:], ensure_ascii=False), encoding="utf-8")
    tmp.replace(LOG)
    subprocess.run(["pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar"],
                   capture_output=True, check=False)


def _alive(pid_file: Path) -> bool:
    try:
        os.kill(int(pid_file.read_text().strip()), 0)
        return True
    except (OSError, ValueError):
        return False


def _single_instance(lock: Path, wait: float = 3.0):
    """Holds an exclusive lock for this process's lifetime; None if another
    copy keeps it. Waits a little: on sync the old copy is still exiting."""
    import fcntl
    handle = open(lock, "w")
    deadline = time.monotonic() + wait
    while True:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except OSError:
            if time.monotonic() > deadline:
                handle.close()
                return None
            time.sleep(0.1)


def run() -> int:
    if not ENABLED or _alive(PID):
        return 0
    # One recorder only, even when several syncs start one at the same moment
    # (every copy would log each notification again).
    guard = _single_instance(RUNTIME / "hyprsetup-notifylog.lock")
    if guard is None:
        return 0
    from gi.repository import Gio, GLib

    address = Gio.dbus_address_get_for_bus_sync(Gio.BusType.SESSION, None)
    conn = Gio.DBusConnection.new_for_address_sync(
        address, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
        | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
    conn.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                   "org.freedesktop.DBus.Monitoring", "BecomeMonitor",
                   GLib.Variant("(asu)", ([
                       "type='method_call',interface='org.freedesktop.Notifications',"
                       "member='Notify'"], 0)),
                   None, Gio.DBusCallFlags.NONE, -1, None)
    PID.write_text(str(os.getpid()))

    def record(app, replaces, icon, summary, body, hints) -> bool:
        if hints.get("transient"):
            return False                  # transient (like a volume/brightness OSD)
        items = load()
        entry = {"app": app or "", "summary": summary or "", "body": body or "",
                 "icon": icon or hints.get("image-path", "") or "",
                 "urgency": int(hints.get("urgency", 1) or 1), "time": int(time.time())}
        # replaces_id: an update of the same notification ("Listening…" →
        # result). Only the daemon's reply knows the real id; replacing the
        # same app's last entry gives the same result in practice.
        if replaces and items and items[-1]["app"] == entry["app"]:
            items[-1] = entry
        else:
            items.append(entry)
        save(items)
        return False

    def on_message(_conn, message, _incoming):
        if message.get_member() == "Notify":
            try:
                app, replaces, icon, summary, body, _actions, hints, _exp = \
                    message.get_body().unpack()
            except (TypeError, ValueError):
                return None
            GLib.idle_add(record, app, replaces, icon, summary, body, hints)
        return None

    conn.add_filter(on_message)
    try:
        GLib.MainLoop().run()
    except KeyboardInterrupt:
        pass
    return 0


# ------------------------------------------------------ do not disturb ----
def _running(name: str) -> bool:
    return subprocess.run(["pgrep", "-x", name], capture_output=True).returncode == 0


def _out(*argv: str) -> str:
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=3,
                              check=False).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def daemon() -> str:
    """The notification daemon running now (not the configured one; D-Bus may start another)."""
    for name in dict.fromkeys((NOTIFIER, "swaync", "mako", "dunst")):
        if name and _running(name):
            return name
    return ""


def dnd(command: str = "status") -> bool | None:
    """Do-not-disturb mode; returns the resulting state (None: no daemon)."""
    name = daemon()
    if name == "swaync":
        state = _out("swaync-client", "-D") == "true"
    elif name == "mako":
        state = "do-not-disturb" in _out("makoctl", "mode").split()
    elif name == "dunst":
        state = _out("dunstctl", "is-paused") == "true"
    else:
        return None
    want = {"on": True, "off": False, "toggle": not state}.get(command, state)
    if want != state:
        if name == "swaync":
            _out("swaync-client", "-dn" if want else "-df")
        elif name == "mako":
            _out("makoctl", "mode", "-a" if want else "-r", "do-not-disturb")
        elif name == "dunst":
            _out("dunstctl", "set-paused", "true" if want else "false")
    return want


def status() -> None:
    if not ENABLED:
        print(json.dumps({"text": "", "class": "off"}), flush=True)
        return
    items = load()
    quiet = dnd() is True
    count = len(items)
    tip = (f"{count} notification{'' if count == 1 else 's'}" if count else "No notifications")
    if quiet:
        tip += " · do not disturb on"
    print(json.dumps({"text": "\U000f009b" if quiet else ("\U000f009a" if count else "\U000f009c"),
                      "class": "dnd" if quiet else ("has" if count else "empty"),
                      "tooltip": tip + "\nClick: history · Right-click: do not disturb"},
                     ensure_ascii=False), flush=True)


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "list"
    if command == "run":
        return run()
    if command == "sync":
        try:
            os.kill(int(PID.read_text().strip()), 15)
        except (OSError, ValueError):
            pass
        PID.unlink(missing_ok=True)
        # The pid file only knows the last one: two syncs close together (rice
        # install → uninstall → reapply) left an earlier copy running, possibly
        # from a rice's script folder that no longer exists.
        subprocess.run(["pkill", "-u", str(os.getuid()), "-f", r"notifylog\.py run$"],
                       capture_output=True, check=False)
        if ENABLED:
            subprocess.Popen([sys.executable, __file__, "run"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            LOG.unlink(missing_ok=True)       # turning it off drops the history too
        return 0
    if command == "status":
        status()
        return 0
    if command == "list":
        print(json.dumps(load(), ensure_ascii=False))
    elif command == "clear":
        save([])
    elif command == "dnd":
        state = dnd(sys.argv[2] if len(sys.argv) > 2 else "status")
        print({True: "on", False: "off", None: "none"}[state])
        subprocess.run(["pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar"],
                       capture_output=True, check=False)
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
