{{! require: HAS_CAVA && HAS_WAYBAR }}
{{! mode: 755 }}
#!/usr/bin/env bash
# cava-bar.sh — turns cava's raw output into block characters for Waybar.
# generated by hyprsetup.
#
# Waybar's "custom/cava" module starts this as a long-running process;
# each line is the bar's current frame.
set -euo pipefail

CONFIG="$HOME/.config/cava/waybar"

if ! command -v cava >/dev/null 2>&1; then
    # Leave the Waybar module empty; printing an error fills the bar with junk.
    exit 0
fi
if [[ ! -r "$CONFIG" ]]; then
    exit 0
fi

# In ascii mode cava prints a line like "0;3;5;7;..." per frame.
# We map the digits to block characters by height.
BLOCKS=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)

# Build the sed program once: drop separators first, then map each digit to a block.
script='s/;//g'
for i in "${!BLOCKS[@]}"; do
    script+=";s/$i/${BLOCKS[$i]}/g"
done

# -u: stream line by line (if buffered, the bar looks frozen).
exec cava -p "$CONFIG" | sed -u "$script"
