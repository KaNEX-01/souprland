{{! require: MANAGE_HYPR_CONFIGS && HAS_HYPRLAND_EXTRAS }}
{{! mode: 755 }}
#!/usr/bin/env bash
# Screen filter picker — switches between hyprshade shaders.
# generated by hyprsetup.
#
# Also works without a keybinding:  ~/.config/hypr/scripts/shader.sh
set -euo pipefail

if ! command -v hyprshade >/dev/null 2>&1; then
    notify-send "Screen filter" "hyprshade is not installed" 2>/dev/null || true
    exit 1
fi

PROMPT_FLAG="{{DMENU_PROMPT_FLAG}}"

pick() {
    if [[ -n "$PROMPT_FLAG" ]]; then
        {{CMD_DMENU}} "$PROMPT_FLAG" "$1"
    else
        {{CMD_DMENU}}
    fi
}

# The currently active filter (empty if none is on).
current=$(hyprshade current 2>/dev/null || true)

# Available shaders: hyprshade lists both ~/.config/hypr/shaders and the
# system directory it installed itself.
mapfile -t shaders < <(hyprshade ls 2>/dev/null | sed 's/[[:space:]]*\*$//' | grep . || true)
if ((${#shaders[@]} == 0)); then
    notify-send "Screen filter" "No shaders found" 2>/dev/null || true
    exit 1
fi

# Mark the active one, put a "turn off" option at the top.
options=("󰹏  Turn off")
for s in "${shaders[@]}"; do
    if [[ "$s" == "$current" ]]; then
        options+=("󰄬  $s")     # active
    else
        options+=("󰸉  $s")
    fi
done

choice=$(printf '%s\n' "${options[@]}" | pick "Screen filter" || true)
[[ -z "$choice" ]] && exit 0

# Drop the marker icon and spaces, leaving just the shader name.
name="${choice#* }"
name="${name# }"

if [[ "$choice" == *"Turn off"* ]]; then
    hyprshade off
    notify-send "Screen filter" "Turned off" 2>/dev/null || true
    exit 0
fi

# Picking the already active one turns it off — a one-key toggle feel.
if [[ "$name" == "$current" ]]; then
    hyprshade off
    notify-send "Screen filter" "$name turned off" 2>/dev/null || true
else
    hyprshade on "$name"
    notify-send "Screen filter" "$name applied" 2>/dev/null || true
fi
