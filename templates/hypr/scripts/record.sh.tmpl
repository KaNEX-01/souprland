{{! require: MANAGE_HYPR_CONFIGS && HAS_INSTANT_REPLAY }}
{{! mode: 755 }}
#!/usr/bin/env bash
# record.sh — gpu-screen-recorder wrapper (recording + instant replay).
# generated by hyprsetup.
#
# Usage:
#     record.sh replay-toggle   start/stop the buffer recording
#     record.sh replay-save     write the last {{REPLAY_SECONDS}} seconds to a file
#     record.sh record-toggle   start/stop a normal recording
#     record.sh status          JSON for the Waybar "custom/record" module
#
# "Instant replay" works like ShadowPlay: recording is kept in a ring buffer
# all the time and written to disk only when you ask. No more "I wish I had
# been recording".
set -euo pipefail

OUT_DIR="{{RECORD_DIR}}"
# The path may be "$HOME/Videos" (lib/config.sh default, expanded by the shell
# here) or "~/Videos" (the readable form the settings app writes).
# A quoted "~" is not expanded by the shell; without expanding it by hand a
# real folder NAMED "~" would be created in the working directory.
# (It cannot be a one-liner with "&&": when the condition is false the line
# returns 1 and "set -e" silently kills the script.)
if [[ "$OUT_DIR" == "~" || "$OUT_DIR" == "~/"* ]]; then
    OUT_DIR="$HOME${OUT_DIR#\~}"
fi
FPS="{{RECORD_FPS}}"
AUDIO="{{RECORD_AUDIO}}"
REPLAY_SECONDS="{{REPLAY_SECONDS}}"
# Container format, quality, cursor and codec: Settings → Session → Screen recording.
FORMAT="{{RECORD_FORMAT_VALUE}}"
video_args=(-c "$FORMAT" -q "{{RECORD_QUALITY_VALUE}}" -cursor "{{RECORD_CURSOR_VALUE}}")
CODEC="{{RECORD_CODEC_VALUE}}"
if [[ -n "$CODEC" ]]; then
    video_args+=(-k "$CODEC")
fi

REPLAY_PID="${XDG_RUNTIME_DIR:-/tmp}/hyprsetup-replay.pid"
RECORD_PID="${XDG_RUNTIME_DIR:-/tmp}/hyprsetup-record.pid"

notify() { notify-send -a "Screen recording" "$1" "${2:-}" 2>/dev/null || true; }

# Is the process in the PID file really alive?
alive() {
    local file="$1" pid
    [[ -r "$file" ]] || return 1
    pid=$(cat "$file" 2>/dev/null) || return 1
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# Refresh the bar indicator right away (custom/record, "signal": 9).
refresh_bar() { pkill -RTMIN+9 waybar 2>/dev/null || true; }

# Status: if nothing is on, empty text → the Waybar module draws nothing.
# Elapsed time counts from when the PID file was written.
if [[ "${1:-}" == "status" ]]; then
    text="" tip="" cls=""
    if alive "$RECORD_PID"; then
        secs=$(( $(date +%s) - $(stat -c %Y "$RECORD_PID") ))
        text=$(printf '󰑊 %02d:%02d' $((secs / 60)) $((secs % 60)))
        tip="Recording"
        cls="recording"
    fi
    if alive "$REPLAY_PID"; then
        text="${text:+$text  }󰕧"
        tip="${tip:+$tip · }Instant replay on (last ${REPLAY_SECONDS} s)"
        cls="${cls:-replay}"
    fi
    printf '{"text": "%s", "tooltip": "%s", "class": "%s"}\n' "$text" "$tip" "$cls"
    exit 0
fi

if ! command -v gpu-screen-recorder >/dev/null 2>&1; then
    notify "gpu-screen-recorder is not installed"
    exit 1
fi

mkdir -p "$OUT_DIR"

# Audio flag: if RECORD_AUDIO is empty it is not passed at all (silent recording).
audio_args=()
if [[ -n "$AUDIO" ]]; then
    audio_args=(-a "$AUDIO")
fi

# Area to record: the focused monitor. "screen" merges all displays and gives
# a huge output on multi-monitor setups; asking for the active monitor is better.
target_monitor() {
    local name
    name=$(hyprctl -j monitors 2>/dev/null \
           | { command -v jq >/dev/null && jq -r '.[] | select(.focused) | .name' || cat; } \
           | head -1)
    printf '%s' "${name:-screen}"
}

case "${1:-}" in
    replay-toggle)
        if alive "$REPLAY_PID"; then
            kill "$(cat "$REPLAY_PID")" 2>/dev/null || true
            rm -f "$REPLAY_PID"
            notify "Instant replay off"
        else
            gpu-screen-recorder -w "$(target_monitor)" -f "$FPS" \
                "${audio_args[@]}" "${video_args[@]}" -r "$REPLAY_SECONDS" \
                -o "$OUT_DIR" >/dev/null 2>&1 &
            echo $! >"$REPLAY_PID"
            notify "Instant replay on" "Keeping the last ${REPLAY_SECONDS}s ready"
        fi
        refresh_bar
        ;;

    replay-save)
        if alive "$REPLAY_PID"; then
            # gpu-screen-recorder treats SIGUSR1 as "write the buffer to disk now";
            # the process keeps running.
            kill -SIGUSR1 "$(cat "$REPLAY_PID")"
            notify "Replay saved" "$OUT_DIR"
        else
            notify "Instant replay is off" "Turn it on first: {{MOD_KEY}} + ALT + R"
        fi
        ;;

    record-toggle)
        if alive "$RECORD_PID"; then
            # SIGINT closes the file cleanly. kill -9 leaves a broken file.
            kill -SIGINT "$(cat "$RECORD_PID")" 2>/dev/null || true
            rm -f "$RECORD_PID"
            notify "Recording stopped" "$OUT_DIR"
        else
            file="$OUT_DIR/Recording_$(date +%Y-%m-%d_%H.%M.%S).$FORMAT"
            gpu-screen-recorder -w "$(target_monitor)" -f "$FPS" \
                "${audio_args[@]}" "${video_args[@]}" -o "$file" >/dev/null 2>&1 &
            echo $! >"$RECORD_PID"
            notify "Recording started" "$(basename "$file")"
        fi
        refresh_bar
        ;;

    *)
        printf 'Usage: %s {replay-toggle|replay-save|record-toggle|status}\n' \
            "$(basename "$0")" >&2
        exit 2
        ;;
esac
