#!/usr/bin/env python3
"""ALT+Tab window switcher — switches to the chosen window's WORKSPACE.

generated by hyprsetup; its settings come from MOD+I → Behavior → Window
switcher (WINDOW_SWITCHER, SWITCHER_*).

Why our own script: there are ready-made alt-tab apps for Hyprland
(hyprshell — formerly hyprswitch, hypr-altswitch, hyprspace) but they all
live on AUR/GitHub, have a single maintainer and want a background process
running all the time. All this job needs is Hyprland's own IPC:

    hyprctl clients -j                 list windows
    hyprctl dispatch focuswindow ...   focus a window

The second command switches to the window's workspace by itself if it is on
ANOTHER one — that is the whole desired behavior. The list is shown in the
dmenu mode of the already configured launcher (wofi/rofi/fuzzel/tofi/walker),
so no extra package is needed.

Usage:
    windowswitch.py           open the switcher (ALT+Tab)
    windowswitch.py last      no list, go straight back to the last window (ALT+`)
    windowswitch.py release   ALT was released (Hyprland's release binding)
    windowswitch.py --preload start the invisible, ready-and-waiting copy
                              (autostart runs it when SWITCHER_PRELOAD=true)

With WINDOW_SWITCHER="overlay" this script is only a pass-through: it runs the
GTK window with thumbnails (``hyprsetup switcher``). If that cannot open —
the app is not installed or GTK is missing — the plain list below takes
over, so the keybinding never dies.

Order is "most recently used" (MRU): Hyprland gives every window a
focusHistoryID — 0 is the focused window, 1 the one before. The list starts
at 1 and the focused window goes last; so ALT+Tab → Enter gives the classic
"back to the previous window" behavior.
"""

from __future__ import annotations

import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
from pathlib import Path

#: Values from the settings (settings.conf → template).
MODE = "{{WINDOW_SWITCHER}}"              # overlay | menu
SCOPE = "{{SWITCHER_SCOPE}}"              # all | current | monitor
SORT = "{{SWITCHER_SORT}}"                # recent | workspace
INCLUDE_SPECIAL = "{{SWITCHER_SPECIAL}}" == "true"
SHOW_WORKSPACE = "{{SWITCHER_SHOW_WORKSPACE}}" == "true"
DMENU = shlex.split("{{CMD_DMENU}}")
PROMPT_FLAG = "{{DMENU_PROMPT_FLAG}}"
TITLE_LIMIT = 60


#: "Step forward" requests. A file is used INSTEAD of a signal: SIGUSR1's
#: default action TERMINATES the process, and a signal arriving before the
#: GTK app installs its own handler (~150 ms) killed the switcher while it was
#: opening — everyone pressing Tab quickly while holding ALT saw this. The
#: counter file has no such timing problem: even if read late, no request is
#: lost. Counter = the file's byte count (one byte per press).
QUEUE = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "hyprsetup-switcher.queue"

#: Lock of the open switcher: "<pid> <workspace>".
#:
#: The lock is written HERE, not in the GTK app: loading ``import gi`` + Gtk4 +
#: Adw takes ~110 ms, and the lock could only be written after that. Someone
#: pressing Tab twice quickly while holding ALT started a SECOND switcher in
#: that gap: one made a selection and closed, the other stayed hung on the
#: workspace it was opened on, and every later ALT+Tab moved the selection of
#: that invisible window (the "running on another workspace" bug).
#: This script gets here in 19 ms, and since ``os.execvp`` KEEPS the PID, the
#: lock it writes is valid for the GTK process too.
LOCK = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "hyprsetup-switcher.pid"


#: ALT-released marker. Hyprland's release binding (``bindrnt = ALT,
#: Alt_L``) runs ``windowswitch.py release``; the open picker selects when it
#: sees this file is newer than the last Tab. The release event goes to the
#: focused window — in a fullscreen game the picker could not get focus and
#: got stuck on screen.
RELEASE = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / "hyprsetup-switcher.release"


def _alive(pid: int) -> bool:
    """Is the PID really a window switcher? (guards against a stale lock)"""
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf-8", "replace")
    except OSError:
        return False
    return "hyprsetup" in cmdline or "windowswitch" in cmdline


def claim(workspace: int) -> bool:
    """Should we open the switcher?

    * If an open switcher is on the SAME workspace: it gets a step request
      (the selection moves one forward) and False is returned — that is
      pressing Tab again while holding ALT.
    * If it was left on ANOTHER workspace: it is closed. The user cannot see
      that window, so sending it commands is pointless; a fresh switcher
      opens on the new workspace.
    """
    try:
        pid_text, ws_text = LOCK.read_text().split()
        pid = int(pid_text)
        # "preload": the invisible waiting copy. It has no workspace — it
        # builds the window when the request arrives, on the current one.
        ws = workspace if ws_text == "preload" else int(ws_text)
    except (OSError, ValueError):
        pid, ws = 0, 0

    if pid > 0 and pid != os.getpid() and _alive(pid):
        if ws == workspace:
            # Each press appends ONE byte to the file (O_APPEND is atomic). It
            # used to "read, add one, write": when the switcher reset the counter
            # at the same moment the press was lost, and Tab now and then did nothing.
            try:
                fd = os.open(QUEUE, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
                try:
                    os.write(fd, b"1")
                finally:
                    os.close(fd)
            except OSError:
                pass
            return False
        # Left on another workspace: the user cannot see it, sending commands
        # is pointless. Close it and open a fresh one here.
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    try:
        LOCK.write_text(f"{os.getpid()} {workspace}")
        QUEUE.write_text("")         # this round's counter starts from zero
    except OSError:
        pass
    return True


def notify(summary: str, body: str = "") -> None:
    subprocess.run(["notify-send", "-a", "Window switcher", summary, body],
                   check=False)


def hyprctl(*args: str):
    """Return ``hyprctl -j <args>`` output as JSON."""
    try:
        out = subprocess.run(["hyprctl", "-j", *args], check=True,
                             capture_output=True, text=True, timeout=5).stdout
        return json.loads(out or "null")
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def wanted(client: dict, active_ws: int, active_monitor: int) -> bool:
    """Does this window go into the list?"""
    if not client.get("mapped", True):
        return False
    workspace = client.get("workspace") or {}
    # Special (scratchpad) workspaces are a separate concept: calling a window
    # there with "focuswindow" makes it visible, but it clutters the list, so
    # they are hidden by default.
    if not INCLUDE_SPECIAL and str(workspace.get("name", "")).startswith("special"):
        return False
    if SCOPE == "current" and workspace.get("id") != active_ws:
        return False
    if SCOPE == "monitor" and client.get("monitor") != active_monitor:
        return False
    return True


def sort_key(client: dict):
    history = client.get("focusHistoryID", 0)
    # The focused window (0) goes to the END of the list: first must be "the previous window".
    recent = (1, 0) if history == 0 else (0, history)
    if SORT == "workspace":
        return ((client.get("workspace") or {}).get("id", 0), recent)
    return recent


def label_for(client: dict) -> str:
    workspace = (client.get("workspace") or {}).get("name", "?")
    name = client.get("class") or client.get("initialClass") or "?"
    title = (client.get("title") or "").strip()
    if len(title) > TITLE_LIMIT:
        title = title[: TITLE_LIMIT - 1] + "…"
    parts = []
    if SHOW_WORKSPACE:
        parts.append(f"[{workspace}]")
    parts.append(name)
    if title and title != name:
        parts.append(f"— {title}")
    return " ".join(parts)


def unique(labels: list[str]) -> list[str]:
    """Two windows with the same title make the choice ambiguous; a number is added."""
    seen: dict[str, int] = {}
    out: list[str] = []
    for label in labels:
        seen[label] = seen.get(label, 0) + 1
        out.append(label if seen[label] == 1 else f"{label}  ({seen[label]})")
    return out


def focus(client: dict) -> None:
    """Focus the window. If it is on another workspace, Hyprland switches there.

    XWayland windows (games) also get an ALT press-and-release: ALT+Tab's ALT
    press goes to the game but the release never reaches it; the game thought
    ALT was held and Tab and Caps stopped working (see gui/switcher.py).
    """
    target = f"address:{client['address']}"
    commands = f"dispatch focuswindow {target}"
    if client.get("xwayland"):
        commands += f" ; dispatch sendshortcut , Alt_L, {target}"
    subprocess.run(["hyprctl", "--batch", commands], check=False)


#: Settings for the thumbnail window — embedded from the template, so the GTK
#: side does not have to parse settings.conf.
VALUES = {
    "SWITCHER_SCOPE": SCOPE,
    "SWITCHER_SORT": SORT,
    "SWITCHER_SPECIAL": "{{SWITCHER_SPECIAL}}",
    "SWITCHER_SHOW_WORKSPACE": "{{SWITCHER_SHOW_WORKSPACE}}",
    "SWITCHER_THUMBS": "{{SWITCHER_THUMBS}}",
    "SWITCHER_THUMB_WIDTH": "{{SWITCHER_THUMB_WIDTH}}",
}

#: Where to look for the installed app's python package.
#:
#: If HYPRSETUP_PYTHON is set, ONLY that is tried: a single control point for
#: people installing the app to another prefix (and for tests, so they can
#: exercise the fallback paths without running the real install).
APP_PATHS = ((os.environ["HYPRSETUP_PYTHON"],)
             if os.environ.get("HYPRSETUP_PYTHON") else
             (os.path.expanduser("~/.local/share/hyprsetup/python"),
              "/usr/share/hyprsetup/python"))


def overlay() -> bool:
    """Opens the GTK window with thumbnails.

    Imports the app IN THE SAME PROCESS. It used to run ``hyprsetup switcher``;
    that meant a second python interpreter (~20 ms), a bash wrapper (~5 ms)
    and ``hyprsetup.__main__`` + argparse (~19 ms). ALT+Tab's total budget is
    ~250 ms, so all of it counts.

    If the import fails (package installed elsewhere, GTK missing) the command
    line is tried first, then the plain list — the keybinding is never a dead
    end.
    """
    preload = len(sys.argv) > 1 and sys.argv[1] == "--preload"
    for path in APP_PATHS:
        if not os.path.isfile(os.path.join(path, "hyprsetup", "gui", "switcher.py")):
            continue
        sys.path.insert(0, path)
        try:
            from hyprsetup.gui import switcher as gui_switcher
        except ImportError:
            sys.path.remove(path)
            continue
        if preload:
            raise SystemExit(gui_switcher.run_preload(VALUES))
        raise SystemExit(gui_switcher.run_with(VALUES))

    binary = shutil.which("hyprsetup")
    if binary is None:
        return False
    try:
        os.execvp(binary, [binary, "switcher"])
    except OSError:
        return False
    return True                            # normally never reached


def _set_proc_name() -> None:
    """Process name "souprland-alt": the ananicy-cpp priority rule matches it
    (Settings › Window switcher › Priority, priority.py).

    ananicy looks at the first word of the command line ("cmd"), not comm; so
    the ready-and-waiting copy re-executes itself once under that name.
    The short-lived copy run on every ALT+Tab does not (it would cost +35 ms);
    it already inherits the session's priority (SWITCHER_PRIORITY=session).
    """
    if (len(sys.argv) > 1 and sys.argv[1] == "--preload"
            and os.environ.get("SOUPRLAND_ALT_EXEC") != "1"):
        os.environ["SOUPRLAND_ALT_EXEC"] = "1"
        try:
            os.execv(sys.executable,
                     ["souprland-alt", os.path.abspath(__file__), *sys.argv[1:]])
        except OSError:
            pass
    try:
        import ctypes
        libc = ctypes.CDLL(None)
        libc.prctl(15, b"souprland-alt", 0, 0, 0)        # PR_SET_NAME
    except (OSError, AttributeError):
        pass


def main() -> int:
    _set_proc_name()
    # "last" mode opens NO list: whatever UI is selected it goes straight to
    # the previous window, so it is handled before anything else.
    direct = len(sys.argv) > 1 and sys.argv[1] == "last"

    # "release": ALT was released. With no open (or waiting) picker there is
    # nothing to do; every ALT release ends up here.
    if len(sys.argv) > 1 and sys.argv[1] == "release":
        if LOCK.exists():
            try:
                RELEASE.touch()
            except OSError:
                pass
        return 0

    # "--preload": the invisible copy started at session start (SWITCHER_PRELOAD).
    # It writes the lock itself, so claim() is not called.
    if len(sys.argv) > 1 and sys.argv[1] == "--preload":
        if MODE != "overlay" or not overlay():
            return 1
        return 0

    if MODE == "overlay" and not direct:
        workspace = (hyprctl("activeworkspace") or {}).get("id", 0)
        if not claim(workspace):
            return 0                       # the open window took over
        if overlay():
            return 0
        LOCK.unlink(missing_ok=True)       # GTK could not open, release the lock
        QUEUE.unlink(missing_ok=True)

    clients = hyprctl("clients")
    if clients is None:
        notify("Could not connect to Hyprland", "hyprctl could not be run.")
        return 1

    workspace = hyprctl("activeworkspace") or {}
    active_ws = workspace.get("id", -1)
    active_monitor = -1
    for monitor in hyprctl("monitors") or []:
        if monitor.get("focused"):
            active_monitor = monitor.get("id", -1)

    windows = [c for c in clients if wanted(c, active_ws, active_monitor)]
    windows.sort(key=sort_key)
    if not windows:
        notify("No window to switch to")
        return 0

    # "last": no list at all — straight to the next (previous) window.
    if len(sys.argv) > 1 and sys.argv[1] == "last":
        focus(windows[0])
        return 0

    labels = unique([label_for(c) for c in windows])
    command = list(DMENU)
    if PROMPT_FLAG:
        command += [PROMPT_FLAG, "Window"]
    try:
        picked = subprocess.run(command, input="\n".join(labels) + "\n",
                                capture_output=True, text=True,
                                check=False).stdout.strip()
    except OSError as exc:
        notify("Could not run the launcher", str(exc))
        return 1

    if not picked:
        return 0                      # exited with Esc
    if picked not in labels:
        # Some launchers return a trimmed selection; try a prefix match.
        matches = [i for i, label in enumerate(labels) if label.startswith(picked)]
        if not matches:
            return 0
        index = matches[0]
    else:
        index = labels.index(picked)

    focus(windows[index])
    return 0


if __name__ == "__main__":
    sys.exit(main())
