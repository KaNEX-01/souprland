#!/usr/bin/env python3
"""gamemode.py — game mode: takes the desktop's GPU/CPU load off while gaming.

generated by hyprsetup (Settings → Session → Game mode).

While on:
  * Hyprland animations, blur and shadows are turned off (GAMEMODE_EFFECTS),
  * Wallpaper Engine is paused — the process is frozen with SIGSTOP and the
    scene resumes where it left off (GAMEMODE_PAUSE_WALLPAPER),
  * the audio visualizer is stopped if running, then started again,
  * notifications are muted (GAMEMODE_DND; swaync / mako / dunst).
When turned off, ``hyprctl reload`` restores the values from the config.

Auto mode (GAMEMODE_AUTO) listens on Hyprland's event socket: when a fullscreen
window on a VISIBLE workspace is a game (GAMEMODE_MATCH, or any fullscreen
window in "fullscreen" mode) the mode turns on, and off once none is left.
A manually enabled mode is never turned off automatically.

Usage:
    gamemode.py on | off | toggle   turn on / off by hand
    gamemode.py status              JSON for Waybar (empty while off)
    gamemode.py watch               auto mode (runs at session start)
    gamemode.py sync                restart the watcher after a settings change
"""

from __future__ import annotations

import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

AUTO = "{{GAMEMODE_AUTO}}"                  # off | games | fullscreen
MATCH = r"""{{GAMEMODE_MATCH}}"""
EFFECTS = "{{GAMEMODE_EFFECTS}}" == "true"
PAUSE_WALLPAPER = "{{GAMEMODE_PAUSE_WALLPAPER}}" == "true"
DND = "{{GAMEMODE_DND}}" == "true"
NOTIFIER = "{{NOTIFIER}}"

SCRIPTS = Path(__file__).resolve().parent
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp")
STATE = RUNTIME / "hyprsetup-gamemode.json"
WATCH_PID = RUNTIME / "hyprsetup-gamemode-watch.pid"
#: Waybar's custom/gamemode module is refreshed with this signal.
WAYBAR_SIGNAL = 12
WPENGINE = "linux-wallpaper"


# ---------------------------------------------------------------- helpers --
def run(*argv: str, timeout: float = 10) -> str:
    try:
        return subprocess.run(argv, capture_output=True, text=True,
                              timeout=timeout, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def running(pattern: str, exact: bool = False) -> bool:
    flag = "-x" if exact else "-f"
    return bool(run("pgrep", flag, pattern).strip())


def hypr_json(what: str):
    try:
        return json.loads(run("hyprctl", what, "-j") or "null")
    except ValueError:
        return None


def notify(title: str, body: str = "") -> None:
    run("notify-send", "-a", "Souprland", "-t", "2500",
        "-i", "input-gaming-symbolic", title, body)


def load_state() -> dict:
    try:
        return json.loads(STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def save_state(state: dict) -> None:
    if state:
        STATE.write_text(json.dumps(state), encoding="utf-8")
    else:
        STATE.unlink(missing_ok=True)
    run("pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar")


def _panel_running(name: str) -> bool:
    # visualizer.sh opens the kitty panel with its own class.
    return running(f"^kitty \\+kitten panel .*--class=hyprsetup-{name}( |$)")


def _dnd(on: bool) -> None:
    # The daemon RUNNING right now, not the configured NOTIFIER: D-Bus activation
    # may have started a different daemon; swaync-client hangs trying to reach
    # a swaync that is not running.
    for daemon in dict.fromkeys((NOTIFIER, "swaync", "mako", "dunst")):
        if not running(daemon, exact=True):
            continue
        if daemon == "swaync":
            run("swaync-client", "-dn" if on else "-df", timeout=3)
        elif daemon == "mako":
            run("makoctl", "mode", "-a" if on else "-r", "do-not-disturb", timeout=3)
        elif daemon == "dunst":
            run("dunstctl", "set-paused", "true" if on else "false", timeout=3)
        return


# ---------------------------------------------------------------- mode ----
def enable(auto: bool = False) -> None:
    state = load_state()
    if state.get("on"):
        return
    state = {"on": True, "auto": auto, "since": int(time.time())}
    if EFFECTS:
        run("hyprctl", "--batch",
            "keyword animations:enabled 0 ; keyword decoration:blur:enabled 0 ; "
            "keyword decoration:shadow:enabled 0")
    if PAUSE_WALLPAPER and running(WPENGINE, exact=True):
        run("pkill", "-STOP", "-x", WPENGINE)
        state["wallpaper"] = True
    for name, script in (("visualizer", "visualizer.sh"),):
        if _panel_running(name) and (SCRIPTS / script).is_file():
            run(str(SCRIPTS / script), "stop")
            state[name] = True
    if DND:
        notify("Game mode on", "Effects off, notifications muted.")
        _dnd(True)
    else:
        notify("Game mode on", "Effects off.")
    save_state(state)


def disable() -> None:
    state = load_state()
    if not state.get("on"):
        return
    if EFFECTS:
        run("hyprctl", "reload")
    if state.get("wallpaper"):
        run("pkill", "-CONT", "-x", WPENGINE)
    for name, script in (("visualizer", "visualizer.sh"),):
        if state.get(name) and (SCRIPTS / script).is_file():
            subprocess.Popen([str(SCRIPTS / script), "start"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if DND:
        _dnd(False)
    save_state({})
    notify("Game mode off")


def status() -> None:
    state = load_state()
    if not state.get("on"):
        print(json.dumps({"text": "", "class": "off"}), flush=True)
        return
    how = "automatic" if state.get("auto") else "turned on manually"
    print(json.dumps({"text": "\U000f0297", "class": "on",
                      "tooltip": f"Game mode on ({how})\nClick: turn off"},
                     ensure_ascii=False), flush=True)


# ----------------------------------------------------------- auto mode ----
def wants_gamemode(pattern: re.Pattern | None) -> bool:
    """Is there a fullscreen game on a visible workspace."""
    monitors = hypr_json("monitors") or []
    visible = {m.get("activeWorkspace", {}).get("id") for m in monitors}
    for client in hypr_json("clients") or []:
        if not client.get("fullscreen") or client.get("workspace", {}).get("id") not in visible:
            continue
        if pattern is None:
            return True
        names = (client.get("class", ""), client.get("initialClass", ""),
                 client.get("title", ""))
        if any(pattern.search(n or "") for n in names):
            return True
    return False


def watch() -> int:
    if AUTO not in ("games", "fullscreen"):
        return 0
    try:
        pattern = None if AUTO == "fullscreen" else re.compile(MATCH or "^steam_app_", re.I)
    except re.error:
        pattern = re.compile("^steam_app_", re.I)
    sock_path = (RUNTIME / "hypr" / os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
                 / ".socket2.sock")
    WATCH_PID.write_text(str(os.getpid()))
    interesting = ("fullscreen>>", "activewindowv2>>", "closewindow>>", "workspacev2>>",
                   "focusedmonv2>>", "openwindow>>")
    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(str(sock_path))
                sock.settimeout(1.0)
                buffer, dirty = b"", True
                while True:
                    if dirty:
                        dirty = False
                        want = wants_gamemode(pattern)
                        state = load_state()
                        if want and not state.get("on"):
                            enable(auto=True)
                        elif not want and state.get("on") and state.get("auto"):
                            disable()
                    try:
                        chunk = sock.recv(4096)
                    except socket.timeout:
                        continue
                    if not chunk:
                        break
                    buffer += chunk
                    *lines, buffer = buffer.split(b"\n")
                    if any(line.decode(errors="ignore").startswith(interesting)
                           for line in lines):
                        time.sleep(0.4)       # let the fullscreen switch settle
                        dirty = True
        except OSError:
            pass
        if not sock_path.exists():
            return 0                          # Hyprland has exited
        time.sleep(2)


def stop_watch() -> None:
    try:
        pid = int(WATCH_PID.read_text().strip())
        os.kill(pid, signal.SIGTERM)
    except (OSError, ValueError):
        pass
    WATCH_PID.unlink(missing_ok=True)


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if command == "on":
        enable()
    elif command == "off":
        disable()
    elif command == "toggle":
        disable() if load_state().get("on") else enable()
    elif command == "status":
        status()
    elif command == "watch":
        return watch()
    elif command == "sync":
        stop_watch()
        if load_state().get("auto"):
            disable()
        if AUTO in ("games", "fullscreen"):
            subprocess.Popen([sys.executable, __file__, "watch"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
