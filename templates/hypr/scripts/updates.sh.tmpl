{{! require: MANAGE_HYPR_CONFIGS }}
{{! mode: 755 }}
#!/usr/bin/env bash
# updates.sh — pending package updates (Waybar custom/updates).
# generated by hyprsetup.
#
# Repo updates are counted with checkupdates (pacman-contrib): it syncs the
# database into a temporary copy, so it never touches the system's pacman
# database and needs no root. AUR updates are counted with yay or paru "-Qua".
# The result is cached; Waybar asks every half hour.
#
# Usage:
#     updates.sh status     Waybar JSON (empty when there are no updates → hidden)
#     updates.sh refresh    refresh the cache and update the bar
#     updates.sh upgrade    start the upgrade in a terminal

set -uo pipefail

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/hyprsetup/updates.txt"
SIGNAL=14
# Settings → Session → Desktop tools.
ENABLED="{{UPDATES_CHECK}}"
INTERVAL="{{UPDATES_INTERVAL}}"
WITH_AUR="{{UPDATES_AUR}}"
TERMINAL="{{CMD_TERMINAL}}"
EXEC_FLAG="{{TERMINAL_EXEC_FLAG}}"

aur_helper() {
    local h
    for h in yay paru; do
        command -v "$h" >/dev/null 2>&1 && { echo "$h"; return; }
    done
}

refresh() {
    mkdir -p "$(dirname "$CACHE")"
    # One refresh at a time: a second checkupdates running alongside Waybar's
    # background refresh hit the database lock and returned an empty list.
    exec 9>"$CACHE.lock"
    flock -w 180 9 || return 0
    local repo="" aur="" helper rc=0
    if command -v checkupdates >/dev/null 2>&1; then
        repo=$(timeout 120 checkupdates 2>/dev/null) || rc=$?
        # 0: updates, 2: none, other: error (network, lock) → keep the cache.
        if (( rc != 0 && rc != 2 )); then
            return 0
        fi
    fi
    helper=$(aur_helper)
    if [[ -n "$helper" && "$WITH_AUR" == true ]]; then
        aur=$(timeout 120 "$helper" -Qua 2>/dev/null | sed 's/$/ [AUR]/')
    fi
    printf '%s\n%s\n' "$repo" "$aur" | sed '/^\s*$/d' >"$CACHE.tmp" && mv "$CACHE.tmp" "$CACHE"
    pkill "-RTMIN+$SIGNAL" -x waybar 2>/dev/null
}

status() {
    if [[ "$ENABLED" != true ]]; then
        echo '{"text": "", "class": "none"}'
        return
    fi
    # Missing or older than the interval: refresh in the background;
    # Waybar does not wait, it asks again when the refresh signals.
    if [[ ! -f "$CACHE" ]] || [[ -n "$(find "$CACHE" -mmin "+${INTERVAL:-30}" 2>/dev/null)" ]]; then
        (refresh >/dev/null 2>&1 &)
    fi
    local count=0 aur=0 list=""
    if [[ -f "$CACHE" ]]; then
        count=$(grep -c . "$CACHE")
        aur=$(grep -c '\[AUR\]$' "$CACHE")
        list=$(head -n 25 "$CACHE" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
        (( count > 25 )) && list+=$'\n'"… and $((count - 25)) more packages"
    fi
    if (( count == 0 )); then
        echo '{"text": "", "class": "none"}'
        return
    fi
    python3 - "$count" "$aur" "$list" <<'PY'
import json, sys
count, aur, packages = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
head = f"{count} update{'' if count == 1 else 's'}" + (f" ({aur} AUR)" if aur else "")
print(json.dumps({"text": f"\U000f06b0 {count}", "class": "pending",
                  "tooltip": f"{head}\n\n{packages}\n\nClick: upgrade · Right-click: check again"},
                 ensure_ascii=False))
PY
}

upgrade() {
    local helper cmd
    helper=$(aur_helper)
    if [[ -n "$helper" ]]; then
        cmd="$helper -Syu"
    else
        cmd="sudo pacman -Syu"
    fi
    # The count refreshes when the terminal closes.
    local script="$cmd; echo; read -rp 'Press Enter to close… '; $0 refresh"
    if [[ -n "$TERMINAL" ]]; then
        # shellcheck disable=SC2086
        setsid -f $TERMINAL $EXEC_FLAG bash -c "$script" >/dev/null 2>&1
    fi
}

case "${1:-status}" in
    status)  status ;;
    refresh) refresh ;;
    upgrade) upgrade ;;
    *) echo "usage: $0 status|refresh|upgrade" >&2; exit 2 ;;
esac
