{{! require: MANAGE_HYPR_CONFIGS && HAS_HYPRLAND_EXTRAS }}
# hyprshade.toml — screen filter schedule
# generated by hyprsetup
#
# Shader files: ~/.config/hypr/shaders/
# Manual use:
#     hyprshade on <name>      apply a filter
#     hyprshade off            turn off
#     hyprshade toggle <name>  toggle
#     hyprshade auto           apply the schedule below now
#
# For the schedule to run on its own, a systemd timer is needed:
#     hyprshade install && systemctl --user enable --now hyprshade.timer
#
# NOTE — CONFLICT with hyprsunset: hyprsunset also lowers the color
# temperature. With both on, the screen turns twice as yellow. That is why the
# night filter is OFF by default; to turn it on, set in settings.conf:
#     NIGHT_SHADER="blue-light-filter"
# and do not install the hyprsunset component (or do not use MOD+SHIFT+N).
{{#if NIGHT_SHADER}}

[[shades]]
name = "{{NIGHT_SHADER}}"
start_time = {{NIGHT_SHADER_START}}:00
end_time = {{NIGHT_SHADER_END}}:00
{{/if}}
{{#unless NIGHT_SHADER}}

# Night filter is off (NIGHT_SHADER empty). Example:
#
# [[shades]]
# name = "blue-light-filter"
# start_time = 20:00:00
# end_time = 06:00:00
{{/unless}}
