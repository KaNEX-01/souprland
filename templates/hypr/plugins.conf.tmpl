{{! require: MANAGE_HYPR_CONFIGS && HYPR_LANG==conf && HAS_ANY_PLUGIN }}
####################################################################
#  plugins.conf — hyprpm plugin settings
#  generated by hyprsetup
#
#  IMPORTANT: The settings in this file only apply if the plugin is
#  INSTALLED and ENABLED. Plugins have to be rebuilt after every
#  Hyprland update:
#
#      hyprpm update && hyprpm reload
#
#  If the build fails, Hyprland starts without plugins and these
#  settings are silently ignored. To check the status: hyprpm list
####################################################################

{{#if HAS_HYPREXPO}}
# ---------------------------------------------------------- hyprexpo ----
# Shows all workspaces in a grid. Keybinding: MOD + the key left of Tab
# (grave/backtick) — see keybinds.conf.
plugin {
    hyprexpo {
        columns = {{HYPREXPO_COLUMNS_VALUE}}
        gap_size = {{GAPS_OUT}}
        bg_col = {{RGBA_BG_DARK}}
        workspace_method = center current

        # Open with the touchpad. Using the same finger count as GESTURE_FINGERS
        # avoids clashing with the workspace swipe: the swipe is horizontal,
        # expo is vertical.
        enable_gesture = true
        gesture_fingers = {{GESTURE_FINGERS}}
        gesture_distance = 300
        gesture_positive = true
    }
}
{{/if}}

{{#if HAS_HYPRBARS}}
# ---------------------------------------------------------- hyprbars ----
# Adds title bars to windows. Colors come from the theme palette.
plugin {
    hyprbars {
        bar_height = {{HYPRBARS_HEIGHT_VALUE}}
        bar_color = {{RGBA_SURFACE}}
        col.text = {{RGBA_FG}}
        bar_text_size = {{FONT_SIZE}}
        bar_text_font = {{FONT_FAMILY}}
        bar_part_of_window = true
        bar_precedence_over_border = true

        # Buttons are defined RIGHT TO LEFT: the first line is the rightmost button.
{{#if HYPRBARS_BUTTONS}}
        hyprbars-button = {{RGBA_RED}}, {{HYPRBARS_BUTTON_SIZE}}, , hyprctl dispatch killactive
        hyprbars-button = {{RGBA_YELLOW}}, {{HYPRBARS_BUTTON_SIZE}}, , hyprctl dispatch fullscreen 1
        hyprbars-button = {{RGBA_GREEN}}, {{HYPRBARS_BUTTON_SIZE}}, , hyprctl dispatch togglefloating
{{/if}}
    }
}
{{/if}}

{{#if HAS_BORDERS_PLUS_PLUS}}
# ------------------------------------------------- borders-plus-plus ----
# Draws extra layers OUTSIDE Hyprland's own border.
plugin {
    borders-plus-plus {
        add_borders = 1
        col.border_1 = {{RGBA_ACCENT2}}
        border_size_1 = {{BORDER_SIZE}}
        natural_rounding = yes
    }
}
{{/if}}

{{#if HAS_HYPRTRAILS}}
# --------------------------------------------------------- hyprtrails ----
plugin {
    hyprtrails {
        color = {{RGBA_ACCENT_66}}
    }
}
{{/if}}

{{#if HAS_HY3}}
# ---------------------------------------------------------------- hy3 ----
# hy3 is a LAYOUT engine; it needs "layout = hy3" in general{} to take
# effect. The LAYOUT setting controls that:
#     ./install.sh --reapply --set LAYOUT=hy3
plugin {
    hy3 {
        # Tab bar look
        tabs {
            height = 5
            padding = 6
            render_text = false
            col.active = {{RGBA_ACCENT}}
            col.urgent = {{RGBA_RED}}
            col.inactive = {{RGBA_SURFACE}}
        }

        autotile {
            enable = true
            # Split side by side above this width, stacked below it —
            # keeps narrow panes readable.
            trigger_width = 800
            trigger_height = 500
        }
    }
}
{{/if}}
