{{! require: LAUNCHER==fuzzel && HAS_FUZZEL }}
# fuzzel.ini — theme: {{THEME}} · generated by hyprsetup

font={{FONT_FAMILY}}:size={{FONT_SIZE}}
dpi-aware=no
prompt="{{LAUNCHER_PROMPT_TEXT}} "
terminal={{CMD_TERMINAL}} {{TERMINAL_EXEC_FLAG}}
layer=overlay
anchor={{LAUNCHER_ANCHOR}}
width={{LAUNCHER_WIDTH_CHARS}}
lines={{LAUNCHER_LINES_VALUE}}
horizontal-pad=20
vertical-pad=14
inner-pad=8
icons-enabled={{LAUNCHER_ICONS_YESNO}}
icon-theme={{ICON_THEME_NAME}}

[colors]
background={{COL_BG}}{{LAUNCHER_ALPHA_HEX}}
text={{COL_FG}}ff
match={{COL_ACCENT}}ff
selection={{COL_ACCENT}}ff
selection-text={{COL_BG}}ff
selection-match={{COL_ACCENT2}}ff
border={{COL_ACCENT}}ff

[border]
width={{LAUNCHER_BORDER_VALUE}}
radius={{LAUNCHER_RADIUS_VALUE}}

[dmenu]
exit-immediately-if-empty=yes
