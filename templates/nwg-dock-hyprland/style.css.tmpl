{{! require: DOCK_ENABLE }}
/*
 * nwg-dock-hyprland style.css — app bar floating at the screen edge
 * generated by hyprsetup · theme: {{THEME}}
 *
 * Colors come from the selected palette, sizes from Settings → Status Bar → Dock.
 * Manual edits are overwritten on the next apply.
 */

window {
    background: transparent;
    border-style: none;
}

#box {
    background: rgba({{RGB_BG}}, {{DOCK_OPACITY_CSS}});
    border-radius: {{DOCK_RADIUS_PX}}px;
    border: 1px solid rgba({{RGB_SURFACE}}, 0.9);
    padding: 6px 8px;
}

button, image {
    background: none;
    border-style: none;
    box-shadow: none;
    color: {{HEX_FG}};
}

button {
    padding: {{DOCK_ICON_PAD}}px;
    margin: 0 2px;
    border-radius: {{DOCK_RADIUS_PX}}px;
    color: {{HEX_FG}};
    font-size: 12px;
    transition: background-color 150ms ease;
}

button:hover {
    background-color: rgba({{RGB_SURFACE}}, 0.9);
}

button:focus {
    box-shadow: none;
}

/* App of the focused window: an accent-colored line underneath. */
#active {
    border-bottom: 3px solid {{HEX_ACCENT}};
}
