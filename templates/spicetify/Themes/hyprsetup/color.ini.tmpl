{{! require: HAS_SPICETIFY }}
; color.ini — Spotify (spicetify) color scheme
; generated by hyprsetup · theme: {{THEME}}
;
; To apply:
;     spicetify config current_theme hyprsetup color_scheme base
;     spicetify apply
;
; NOTE: spicetify writes into Spotify's install directory. Every Spotify
; update RESETS the theme and "spicetify apply" has to be run again —
; that is how spicetify works, not this script.

[base]
text                = {{COL_FG}}
subtext             = {{COL_SUBTEXT}}
main                = {{COL_BG}}
main-elevated       = {{COL_SURFACE}}
highlight           = {{COL_SURFACE}}
highlight-elevated  = {{COL_SURFACE}}
sidebar             = {{COL_BG_DARK}}
player              = {{COL_BG_DARK}}
card                = {{COL_SURFACE}}
shadow              = {{COL_BG_DARK}}
selected-row        = {{COL_ACCENT}}
button              = {{COL_ACCENT}}
button-active       = {{COL_ACCENT}}
button-disabled     = {{COL_SURFACE}}
tab-active          = {{COL_SURFACE}}
notification        = {{COL_ACCENT}}
notification-error  = {{COL_RED}}
misc                = {{COL_SUBTEXT}}
