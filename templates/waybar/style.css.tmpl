#workspaces button.active {
    background-color: transparent; color: @accent; padding: 0 5px;
    box-shadow: inset 0 -2px @accent;
}
{{/if}}

{{#if BAR_IS_ST_MANDO}}
/* st-mando — steel strip, each module in its own capsule with a thin sand frame;
 * the clock filled with sand color. */
window#waybar { background-color: alpha(@bg-dark, {{BAR_OPACITY}}); }
#workspaces, #cpu, #memory, #clock, #tray, #network, #pulseaudio, #battery,
#custom-power {
    background-color: alpha(@surface, 0.65);
    border: 1px solid alpha(@fg, 0.3);
    color: @fg;
    border-radius: {{BAR_RADIUS}}px;
    margin: 3px 2px;
}
#clock { background-color: @fg; color: @bg-dark; font-weight: bold; padding: 0 16px; }
#custom-power { color: @accent; }
#cpu, #memory { color: @fg; }
#workspaces button { color: @fg; padding: 0 5px; margin: 3px 1px; border-radius: {{BAR_RADIUS}}px; }
#workspaces button.active {
    background-color: @accent; color: @bg-dark; padding: 0 16px; border-radius: {{BAR_RADIUS}}px;
}
{{/if}}

/* Player buttons (custom/media-*): keep them a clickable size in whichever bar
 * preset they are used. Presets override this in their own blocks. */
#custom-media-prev, #custom-media-play, #custom-media-next { padding: 0 6px; }
#custom-media { padding: 0 10px; }
#custom-shazam { padding: 0 8px; }
#custom-gamemode { padding: 0 8px; color: @accent; }
#custom-notifications { padding: 0 8px; }
#custom-notifications.dnd { color: @subtext; }
#custom-updates { padding: 0 8px; color: @accent2; }
#custom-shazam.listening, #custom-shazam.recognizing { color: @accent; }
@keyframes hs-shazam-pulse {
    from { background-color: alpha(@accent, 0.08); }
    to   { background-color: alpha(@accent, 0.30); }
}

{{#if BAR_IS_ST_KULE}}
/* st-kule — a soft night strip stuck to the top of the screen. Rounded bottom
 * corners, translucent (Hyprland blurs the waybar layer, so the tower looks
 * like frosted glass from behind). On the left the workspace number + icons of
 * its windows (the active one a soft pill), a detailed player in a single
 * capsule in the middle, plain metrics and a clock pill on the right. No sharp
 * edges or harsh red lines; accents at low opacity, transitions animated. */
window#waybar {
    background-color: alpha(@bg-dark, {{BAR_OPACITY}});
    border-radius: 0 0 {{BAR_RADIUS}}px {{BAR_RADIUS}}px;
    border: none;
    border-bottom: 1px solid alpha(@accent2, 0.10);
}
#workspaces, #window, #cpu, #memory, #temperature, #pulseaudio, #network,
#bluetooth, #battery, #tray, #clock, #custom-power {
    background-color: transparent;
    color: @fg;
    border: none;
    border-radius: 999px;
    margin: 0;
    padding: 0 9px;
    transition: all 200ms cubic-bezier(0.23, 1, 0.32, 1);
}
#workspaces { padding: 0 0 0 6px; }
#workspaces button {
    color: alpha(@subtext, 0.9);
    background-color: transparent;
    padding: 0 10px;
    margin: 4px 2px;
    border-radius: 999px;
    border: none;
    box-shadow: none;
    min-width: 0;
    transition: all 250ms cubic-bezier(0.23, 1, 0.32, 1);
}
#workspaces button.empty { color: alpha(@subtext, 0.38); }
#workspaces button:hover {
    border-radius: 999px;
    background-color: alpha(@surface, 0.55);
    color: @fg;
    box-shadow: none;
}
#workspaces button.active {
    /* keep the shared rule's {{BAR_RADIUS}}px (0 = flush strip) from squaring off the pill */
    border-radius: 999px;
    background-color: alpha(@accent2, 0.20);
    color: @fg;
    font-weight: 600;
    padding: 0 12px;
    box-shadow: inset 0 0 0 1px alpha(@accent2, 0.18);
}
#workspaces button.urgent { border-radius: 999px; background-color: alpha(@accent, 0.22); color: @fg; }
#window { color: alpha(@subtext, 0.95); font-style: normal; }

/* the player capsule in the middle: mpris + three buttons side by side as one piece */
#custom-media, #custom-media-prev, #custom-media-play, #custom-media-next {
    background-color: alpha(@surface, 0.55);
    color: @fg;
    margin: 4px 0;
    border: none;
    transition: all 200ms cubic-bezier(0.23, 1, 0.32, 1);
}
#custom-media {
    padding: 0 12px 0 16px;
    border-radius: 999px 0 0 999px;
    font-style: normal;
}
#custom-media.paused { color: alpha(@subtext, 0.95); font-style: normal; }
#custom-media-prev, #custom-media-next { color: alpha(@accent2, 0.9); padding: 0 7px; }
#custom-media-play { color: alpha(@accent, 0.85); padding: 0 7px; font-size: calc({{FONT_SIZE}}pt + 2pt); }
#custom-media-play.paused { color: @fg; }
#custom-media-next { border-radius: 0 999px 999px 0; padding: 0 14px 0 7px; }
#custom-media-prev:hover, #custom-media-play:hover, #custom-media-next:hover,
#custom-media:hover { background-color: alpha(@surface, 0.85); }
/* song recognition: a separate small pill next to the capsule; the accent pulses while listening */
#custom-shazam {
    background-color: alpha(@surface, 0.55);
    color: alpha(@accent2, 0.9);
    margin: 4px 0 4px 6px;
    padding: 0 11px;
    border-radius: 999px;
    border: none;
    transition: all 200ms cubic-bezier(0.23, 1, 0.32, 1);
}
#custom-shazam:hover { background-color: alpha(@surface, 0.85); color: @accent; }
#custom-shazam.listening, #custom-shazam.recognizing {
    background-color: alpha(@accent, 0.16);
    color: @accent;
    box-shadow: inset 0 0 0 1px alpha(@accent, 0.30);
}
#custom-shazam.listening { animation: hs-shazam-pulse 1.2s ease-in-out infinite alternate; }

#cpu, #memory, #temperature { color: alpha(@accent2, 0.9); }
#pulseaudio.muted { color: alpha(@subtext, 0.7); }
#network.disconnected { color: alpha(@subtext, 0.7); }
#cpu:hover, #memory:hover, #pulseaudio:hover, #network:hover,
#bluetooth:hover, #tray:hover { background-color: alpha(@surface, 0.5); }
#clock {
    font-weight: 600;
    color: @fg;
    background-color: alpha(@surface, 0.55);
    margin: 4px 2px 4px 6px;
    padding: 0 14px;
}
#clock:hover { background-color: alpha(@surface, 0.85); }
#custom-power { color: alpha(@accent, 0.8); margin: 4px 8px 4px 2px; padding: 0 11px; }
#custom-power:hover { background-color: alpha(@accent, 0.18); color: @accent; }
{{/if}}
