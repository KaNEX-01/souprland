    color: @subtext; padding: 0 5px; margin: 4px 1px; border-radius: 999px;
}
#workspaces button.active {
    background-color: @fg; color: @bg-dark; padding: 0 6px; border-radius: 999px;
}
{{/if}}

{{#if BAR_IS_ST_AY}}
