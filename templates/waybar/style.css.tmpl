{{! require: BAR==waybar && HAS_WAYBAR }}
/* Waybar theme: {{THEME}} — generated by hyprsetup */

@define-color bg       {{HEX_BG}};
@define-color bg-dark  {{HEX_BG_DARK}};
@define-color surface  {{HEX_SURFACE}};
@define-color fg       {{HEX_FG}};
@define-color subtext  {{HEX_SUBTEXT}};
@define-color accent   {{HEX_ACCENT}};
@define-color accent2  {{HEX_ACCENT2}};
@define-color red      {{HEX_RED}};
@define-color green    {{HEX_GREEN}};
@define-color yellow   {{HEX_YELLOW}};

* {
    font-family: "{{FONT_FAMILY}}", "JetBrainsMono Nerd Font", sans-serif;
    font-size: {{FONT_SIZE}}pt;
    min-height: 0;
    border: none;
    border-radius: 0;
}

window#waybar {
    background: transparent;
    color: @fg;
}

window#waybar.hidden {
    opacity: 0.0;
}

/* Shared box look for module groups */
#workspaces,
#submap,
#window,
#cpu,
#memory,
#backlight,
#pulseaudio,
#bluetooth,
#network,
#battery,
#temperature,
#disk,
#idle-inhibitor,
#tray,
#clock,
#mpris,
#taskbar,
#custom-cava,
#custom-weather,
#custom-powerprofile,
#custom-privacy,
#custom-record,
#custom-mic,
#custom-user1,
#custom-user2,
#custom-user3,
#custom-power {
    background-color: alpha(@bg, {{BAR_OPACITY}});
    padding: 2px {{BAR_PADDING}}px;
    margin: 0 3px;
    border-radius: {{BAR_RADIUS}}px;
}

/* Audio visualizer: block characters must be equally wide in a monospace
 * font, otherwise the bar wobbles left and right every frame. The accent
 * color lines the bars up with the palette. */
/* The privacy indicator only shows while the microphone/camera/screen is IN
 * USE; when it shows it has to be noticed — so it takes the palette's warning
 * color instead of sitting quietly like the other modules. */
#custom-privacy {
    color: {{HEX_RED}};
}

/* Red while recording (so a forgotten recording gets noticed); accent color
 * when only instant replay is on. */
#custom-record.recording {
    color: {{HEX_RED}};
}
#custom-record.replay {
    color: {{HEX_ACCENT}};
}

/* Microphone: red while listened to, dim while muted; yellow if an app is
 * still listening while muted (you may think you are talking but not be heard). */
#custom-mic.active {
    color: {{HEX_RED}};
}
#custom-mic.muted {
    color: alpha(@fg, 0.5);
}
#custom-mic.idle {
    color: alpha(@fg, 0.75);
}
#custom-mic.muted-active {
    color: {{HEX_YELLOW}};
}

#custom-cava {
    font-family: "{{FONT_MONO}}", monospace;
    color: {{HEX_ACCENT}};
    letter-spacing: 1px;
}

/* ========================================================= bar presets ===
 * Only the block for the selected bar preset is generated from the ones below.
 * Presets that differ only in scale (slim, media, stats-only, taskbar, dock)
 * are not here — the shared rules above already get them right.
 */

{{#if BAR_IS_ISLANDS}}
/* islands — modules are gathered into a few separate islands; the gap between
 * islands is open, modules inside an island sit flush. */
#workspaces, #submap, #window, #mpris, #tray, #clock, #custom-power {
    margin: 0 {{BAR_SPACING}}px;
}
#cpu, #memory, #temperature, #disk,
#backlight, #pulseaudio, #bluetooth, #network, #battery {
    margin: 0 1px;
    border-radius: 0;
}
/* Round the island ends: the first system module on the left and the last on the right */
#cpu     { border-radius: {{BAR_RADIUS}}px 0 0 {{BAR_RADIUS}}px; margin-left: {{BAR_SPACING}}px; }
#battery { border-radius: 0 {{BAR_RADIUS}}px {{BAR_RADIUS}}px 0; margin-right: {{BAR_SPACING}}px; }
{{/if}}

{{#if BAR_IS_PILL_SINGLE}}
/* pill-single — all modules inside one capsule; modules have no background of
 * their own, the capsule is on window#waybar. Its narrowness comes from the
 * fixed "width" in the config, not from CSS (GTK CSS does not accept percentage
 * margins; see render.py:BAR_FIXED_WIDTH). */
window#waybar {
    background-color: alpha(@bg, {{BAR_OPACITY}});
    border-radius: {{BAR_RADIUS}}px;
}
#workspaces, #submap, #window, #cpu, #memory, #backlight, #pulseaudio,
#bluetooth, #network, #battery, #temperature, #disk, #idle-inhibitor,
#tray, #clock, #mpris, #custom-power {
    background-color: transparent;
    border-radius: 0;
}
{{/if}}

{{#if BAR_IS_BRACKET}}
/* bracket — no background; each region is wrapped in [ … ] by real
 * "custom/bracket-open"/"-close" modules added by render.py (GTK CSS does not
 * generate content with ::before/::after, hence the real modules). */
#workspaces, #submap, #window, #cpu, #memory, #backlight, #pulseaudio,
#bluetooth, #network, #battery, #temperature, #disk, #idle-inhibitor,
#tray, #clock, #mpris, #custom-power {
    background-color: transparent;
    border-radius: 0;
    padding: 0 4px;
}
#custom-bracket-open, #custom-bracket-close {
    background-color: transparent;
    color: @accent;
    font-weight: bold;
    padding: 0 2px;
    margin: 0;
}
{{/if}}

{{#if BAR_IS_CORNER_TRAY}}
/* corner-tray — no bar background, only the corner clusters are boxed. */
#window, #workspaces {
    background-color: transparent;
    border-radius: 0;
}
#custom-power { border-radius: {{BAR_RADIUS}}px 0 0 {{BAR_RADIUS}}px; }
#tray, #pulseaudio, #network, #battery, #clock {
    margin: 0 1px;
    border-radius: 0;
}
#clock { border-radius: 0 {{BAR_RADIUS}}px {{BAR_RADIUS}}px 0; }
{{/if}}

{{#if BAR_IS_MINIMAL}}
/* minimal — the bar is nearly invisible; the information lives in desktop widgets. */
#workspaces, #clock {
    background-color: transparent;
    border-radius: 0;
    padding: 0 6px;
}
#clock { color: @subtext; }
{{/if}}

{{#if BAR_IS_SHARP}}
/* sharp — a thick accent-colored top border and wide letter spacing; the BAR_*
 * scales (radius=0, high opacity) alone did not give this.
 * NOTE: text-transform is not a valid property in GTK CSS — when Waybar was
 * tested with that value the stylesheet failed to parse and the bar never
 * opened (the "bar does not work in cybr-neon" bug).
 * Instead of an uppercase effect, only letter-spacing, which GTK CSS supports,
 * is used. */
window#waybar {
    border-top: 3px solid @accent;
}
#workspaces button,
#clock,
#window {
    letter-spacing: 1px;
}
{{/if}}

{{#if BAR_IS_TELEMETRY}}
/* telemetry — many modules show at once, so a small font size is used;
 * the BAR_* scales did not give this otherwise. */
#workspaces, #submap, #window, #cpu, #memory, #backlight, #pulseaudio,
#bluetooth, #network, #battery, #temperature, #disk, #idle-inhibitor,
#tray, #clock {
    font-size: calc({{FONT_SIZE}}pt - 1pt);
}
{{/if}}

{{#if BAR_IS_RAIL}}
/* rail — vertical rail on the left. Flipping the padding axis now depends on
 * BAR_POSITION, not the bar preset; the BAR_IS_VERTICAL block at the end of
 * the file does it (so EVERY preset choosing left/right gets the same
 * narrowing). Only rail's own separator line remains here. */
window#waybar {
    border-right: 1px solid alpha(@surface, 0.6);
}
{{/if}}

{{#if BAR_IS_GLASS}}
/* glass — frosted glass: every module floats in its own translucent capsule
 * (the shared rule above already does that; here only a thin top sheen that
 * strengthens the glass feel and a soft glow on the active area are added).
 * The real blur comes from the compositor (see windowrules.conf →
 * layerrule = blur on, match:namespace ^(waybar)$). */
#workspaces, #submap, #window, #pulseaudio, #network, #bluetooth, #battery,
#tray, #clock, #custom-power {
    border-top: 1px solid alpha(@fg, 0.08);
    box-shadow: inset 0 1px 0 alpha(@fg, 0.05);
}
#workspaces button.active {
    box-shadow: 0 0 8px alpha(@accent, 0.45);
}
{{/if}}

{{#if BAR_IS_OUTLINE}}
/* outline — modules are separated by outlines, not fills. The shared rule's
 * background-color is undone and replaced with a 1 pixel frame; the bar's own
 * background (BAR_OPACITY=1) keeps showing behind the modules.
 * The active workspace is the only filled item here — in a line-drawn bar
 * there is no other way to read where the focus is. */
#workspaces, #submap, #window, #cpu, #memory, #temperature, #disk,
#backlight, #pulseaudio, #bluetooth, #network, #battery, #idle-inhibitor,
#tray, #clock, #mpris, #custom-cava, #custom-power {
    background-color: transparent;
    border: 1px solid alpha(@fg, 0.45);
    padding: 0 {{BAR_PADDING}}px;
    margin: 2px {{BAR_SPACING}}px;
}
#workspaces button {
    border: none;                 /* the frame is on the #workspaces box, not the button */
    padding: 0 6px;
}
#workspaces button.active {
    background-color: @accent;
    color: @bg;
}
{{/if}}

/* ------------------------------------------------------------------------
 * The presets below are taken from real setups' Waybar configs
 * (docs/preset-sources.md). Sizes are in the preset file, the distinctive
 * STYLE is here: module capsules in one, bare text in another, separator
 * lines in a third — things BAR_* numbers cannot express.
 * ---------------------------------------------------------------------- */

{{#if BAR_IS_JAKOOLIT_SIMPLE_L}}
/* jakoolit-simple-l — JaKooLit's "Simple-L" layout: each module group in its
 * own rounded capsule, with open gaps between capsules; the workspaces on the
 * left end and the power button on the right end finish with fully rounded
 * ends. Modules take different palette colors — JaKooLit's neon feel comes
 * from color separation, not from the background. */
#workspaces, #submap, #window, #clock, #idle-inhibitor, #pulseaudio,
#backlight, #network, #bluetooth, #battery, #tray, #custom-power {
    background-color: alpha(@surface, {{BAR_OPACITY}});
    border-radius: {{BAR_RADIUS}}px;
    margin: 3px 4px;
    padding: 0 10px;
}
#workspaces  { border-radius: 999px; padding: 0 4px; }
#custom-power {
    background-color: alpha(@red, 0.85);
    color: @bg;
    border-radius: 999px;
    padding: 0 12px;
}
#clock       { color: @accent; font-weight: bold; }
#pulseaudio  { color: @accent2; }
#network     { color: @green; }
#battery     { color: @yellow; }
#bluetooth   { color: @accent2; }
#workspaces button.active {
    background-color: @accent;
    color: @bg;
    border-radius: 999px;
    box-shadow: 0 0 6px alpha(@accent, 0.5);
}
{{/if}}

{{#if BAR_IS_HYDE_WALLBASH}}
/* hyde-wallbash — HyDE: a fully rounded power button on the left end, a bare
 * clock in the middle, system modules gathered into a single capsule on the
 * right. Both capsule ends are rounded, the modules inside sit flush — that is
 * HyDE's "one-piece right block" look. */
#custom-power {
    background-color: @accent;
    color: @bg;
    border-radius: 999px;
    margin: 3px 6px 3px 4px;
    padding: 0 14px;
}
#workspaces {
    background-color: alpha(@surface, {{BAR_OPACITY}});
    border-radius: 999px;
    padding: 0 6px;
    margin: 3px 2px;
}
#window { background-color: transparent; color: @subtext; }
#clock  { background-color: transparent; color: @fg; font-weight: bold; }
#mpris, #pulseaudio, #network, #battery, #tray {
    background-color: alpha(@surface, {{BAR_OPACITY}});
    border-radius: 0;
    margin: 3px 0;
    padding: 0 10px;
}
#mpris   { border-radius: 999px 0 0 999px; margin-left: 6px; padding-left: 14px; }
#tray    { border-radius: 0 999px 999px 0; margin-right: 6px; padding-right: 14px; }
#workspaces button.active { background-color: @accent; color: @bg; border-radius: 999px; }
{{/if}}

{{#if BAR_IS_ML4W_GLASS}}
/* ml4w-glass — ML4W: the bar is translucent glass, the workspaces are in the
 * CENTER and bigger than the rest; the side groups are softly cornered boxes.
 * A thin sheen line above the modules keeps the glass readable. */
window#waybar {
    background-color: alpha(@bg, {{BAR_OPACITY}});
    border-radius: {{BAR_RADIUS}}px;
    margin: {{BAR_MARGIN}}px {{BAR_MARGIN}}px 0 {{BAR_MARGIN}}px;
    border: 1px solid alpha(@fg, 0.10);
}
#custom-power, #updates, #window, #pulseaudio, #backlight, #network,
#battery, #clock, #tray {
    background-color: alpha(@surface, 0.35);
    border-top: 1px solid alpha(@fg, 0.08);
    border-radius: {{BAR_RADIUS}}px;
    margin: 4px 3px;
    padding: 0 10px;
}
#custom-power { color: @red; }
#workspaces {
    background-color: alpha(@surface, 0.30);
    border-radius: 999px;
    padding: 2px 8px;
    margin: 4px;
}
#workspaces button {
    padding: 0 10px;
    margin: 2px 3px;
    border-radius: 999px;
    font-size: calc({{FONT_SIZE}}pt + 1pt);
}
#workspaces button.active {
    background-color: @accent;
    color: @bg;
    box-shadow: 0 0 10px alpha(@accent, 0.4);
}
{{/if}}

{{#if BAR_IS_CYBERARCH_HUD}}
/* cyberarch-hud — CyberArch: no corners, no fill; a thin accent line under
 * each module and uppercase/spaced typography. Counters use a monospace font,
 * because constantly changing digits wobble in a proportional font. */
#workspaces, #submap, #window, #cpu, #memory, #temperature, #netstat,
#disk, #clock {
    background-color: transparent;
    border-bottom: 1px solid alpha(@accent, 0.55);
    border-radius: 0;
    margin: 0 6px;
    padding: 0 6px;
    letter-spacing: 1px;
}
#cpu, #memory, #temperature, #netstat, #disk, #clock {
    font-family: "{{FONT_MONO}}", monospace;
    font-size: calc({{FONT_SIZE}}pt - 1pt);
    color: @accent2;
}
#temperature.critical, #battery.critical { color: @red; border-bottom-color: @red; }
#window { color: @fg; }
#workspaces button {
    border-radius: 0;
    padding: 0 6px;
    color: @subtext;
}
#workspaces button.active {
    background-color: alpha(@accent, 0.20);
    color: @accent;
    box-shadow: inset 0 -2px 0 @accent;
}
{{/if}}

{{#if BAR_IS_GRUVBOX_SOLID}}
/* gruvbox-solid — classic gruvbox rice: one-piece opaque background, a 1 pixel
 * vertical separator between modules, no rounding and no gaps at all. */
window#waybar {
    background-color: @bg;
    border-bottom: 2px solid @accent;
}
#workspaces, #window, #cpu, #memory, #pulseaudio, #network, #battery,
#tray, #clock {
    background-color: transparent;
    border-radius: 0;
    margin: 0;
    padding: 0 12px;
    border-left: 1px solid alpha(@surface, 0.9);
}
#workspaces { border-left: none; padding: 0; }
#clock { color: @yellow; font-weight: bold; }
#battery.warning { color: @yellow; }
#battery.critical { color: @red; }
#workspaces button {
    border-radius: 0;
    padding: 0 10px;
    margin: 0;
    color: @subtext;
}
#workspaces button.active {
    background-color: @accent;
    color: @bg;
}
{{/if}}

{{#if BAR_IS_CATPPUCCIN_PILLS}}
/* catppuccin-pills — no bar background; every module in its own fully rounded
 * capsule, and the capsules take different pastel colors from the palette.
 * That is what sets Catppuccin Waybar themes apart: the color is on the module. */
window#waybar { background-color: transparent; }
#workspaces, #window, #pulseaudio, #network, #battery, #clock, #tray {
    border-radius: 999px;
    margin: {{BAR_MARGIN}}px 4px;
    padding: 0 14px;
    color: @bg;
}
#workspaces { background-color: alpha(@surface, 0.92); color: @fg; padding: 0 6px; }
#window     { background-color: alpha(@surface, 0.80); color: @subtext; }
#pulseaudio { background-color: @accent2; }
#network    { background-color: @green; }
#battery    { background-color: @yellow; }
#clock      { background-color: @accent; font-weight: bold; }
#tray       { background-color: alpha(@surface, 0.92); }
#workspaces button {
    border-radius: 999px;
    padding: 0 8px;
    margin: 3px 2px;
    color: @subtext;
}
#workspaces button.active { background-color: @accent; color: @bg; }
{{/if}}

{{#if BAR_IS_SAMEEMUL_ISLANDS}}
/* sameemul-islands — three islands: left (workspaces), center (window), right
 * (media + counter + clock). An island is ONE box; the modules inside have no
 * background of their own, only thin separators between them. */
#workspaces {
    background-color: alpha(@surface, {{BAR_OPACITY}});
    border-radius: {{BAR_RADIUS}}px;
    margin: {{BAR_MARGIN}}px 0 {{BAR_MARGIN}}px {{BAR_SPACING}}px;
    padding: 0 6px;
}
#window {
    background-color: alpha(@surface, {{BAR_OPACITY}});
    border-radius: {{BAR_RADIUS}}px;
    margin: {{BAR_MARGIN}}px 0;
    padding: 0 16px;
}
#mpris, #cpu, #memory, #pulseaudio, #clock {
    background-color: alpha(@surface, {{BAR_OPACITY}});
    border-radius: 0;
    margin: {{BAR_MARGIN}}px 0;
    padding: 0 10px;
    border-left: 1px solid alpha(@bg, 0.55);
}
#mpris { border-radius: {{BAR_RADIUS}}px 0 0 {{BAR_RADIUS}}px; border-left: none; padding-left: 14px; }
#clock { border-radius: 0 {{BAR_RADIUS}}px {{BAR_RADIUS}}px 0; margin-right: {{BAR_SPACING}}px; padding-right: 14px; color: @accent; }
#workspaces button.active { background-color: @accent; color: @bg; }
{{/if}}

{{#if BAR_IS_ECLIPSE_SIDEBAR}}
/* eclipse-sidebar — a rounded vertical BOARD on the left edge. Modules are
 * centered one below the other, with horizontal separator lines between
 * groups; the clock is two lines (BAR_CLOCK_FORMAT="%H%n%M"). Vertical
 * narrowing comes from the BAR_IS_VERTICAL block at the end of the file; the
 * board's style is here. */
window#waybar {
    background-color: alpha(@bg, {{BAR_OPACITY}});
    border-radius: {{BAR_RADIUS}}px;
    margin: {{BAR_MARGIN}}px;
    border: 1px solid alpha(@fg, 0.08);
}
#workspaces, #pulseaudio, #network, #battery, #tray, #clock, #custom-power {
    background-color: transparent;
    border-radius: {{BAR_RADIUS}}px;
    margin: 6px 4px;
    padding: 6px 0;
}
#clock {
    color: @accent;
    font-weight: bold;
    border-top: 1px solid alpha(@fg, 0.12);
    margin-top: 10px;
    padding-top: 10px;
}
#custom-power { color: @red; }
#workspaces button {
    padding: 6px 0;
    margin: 3px 4px;
    border-radius: 999px;
}
#workspaces button.active {
    background-color: @accent;
    color: @bg;
}
{{/if}}

{{#if BAR_IS_GDOTS_RAIL}}
/* gdots-rail — a narrow icon rail: no boxes, no separators. The active
 * workspace is shown with a thick accent bar hugging the left edge (the
 * "edge cursor" common in pywal rices). */
window#waybar {
    background-color: @bg;
    border-right: 1px solid alpha(@surface, 0.8);
}
#workspaces, #pulseaudio, #battery, #clock {
    background-color: transparent;
    border-radius: 0;
    margin: 4px 0;
    padding: 6px 0;
    color: @subtext;
}
#clock { color: @fg; font-family: "{{FONT_MONO}}", monospace; }
#workspaces button {
    padding: 8px 0;
    margin: 2px 0;
    border-radius: 0;
    color: alpha(@subtext, 0.6);
}
#workspaces button.active {
    color: @accent;
    box-shadow: inset 3px 0 0 @accent;
}
{{/if}}

{{#if BAR_IS_COLORSHELL_DOCK}}
/* colorshell-dock — a dock floating at the bottom. The app icons in the middle
 * are big and rise on hover; the side modules stay small and dim so the dock
 * itself stands out. */
window#waybar {
    background-color: alpha(@bg, {{BAR_OPACITY}});
    border-radius: {{BAR_RADIUS}}px;
    margin: 0 18% {{BAR_MARGIN}}px 18%;
    border: 1px solid alpha(@fg, 0.10);
}
#custom-power, #tray, #pulseaudio, #battery, #clock {
    background-color: transparent;
    color: @subtext;
    padding: 0 10px;
    margin: 0;
}
#clock { color: @fg; }
#custom-power { color: @red; }
#workspaces { background-color: transparent; padding: 0 4px; }
#workspaces button {
    padding: 2px 10px;
    margin: 4px 4px 6px 4px;
    border-radius: {{BAR_RADIUS}}px;
    font-size: calc({{FONT_SIZE}}pt + 2pt);
    transition: all 150ms cubic-bezier(0.23, 1, 0.32, 1);
}
#workspaces button:hover {
    background-color: alpha(@accent, 0.25);
    margin-bottom: 10px;          /* hop up out of the dock */
}
#workspaces button.active {
    background-color: alpha(@accent, 0.35);
    box-shadow: inset 0 -3px 0 @accent;
}
{{/if}}

{{#if BAR_IS_RAINZ_NEBULA}}
/* rainz-nebula — almost no bar: instead of boxes and separators, wide letter
 * spacing, dim text and a soft glow under the active workspace. The bar of
 * dark cosmic desktops with gradient borders. */
window#waybar { background-color: alpha(@bg, {{BAR_OPACITY}}); }
#workspaces, #window, #pulseaudio, #clock {
    background-color: transparent;
    border-radius: 0;
    margin: 0 10px;
    padding: 0 6px;
    letter-spacing: 2px;
    color: alpha(@fg, 0.75);
}
#window { color: alpha(@subtext, 0.8); }
#clock  { color: @accent; }
#workspaces button {
    padding: 0 10px;
    margin: 0 2px;
    border-radius: 999px;
    color: alpha(@subtext, 0.5);
}
#workspaces button.active {
    color: @accent;
    box-shadow: 0 0 12px alpha(@accent, 0.55);
}
{{/if}}

{{#if BAR_IS_BINNEWBS_COMPACT}}
/* binnewbs-compact — tight but readable: small padding, light rounding, thin
 * separators between modules. The update counter turns yellow when it has
 * something, to draw attention. */
#workspaces, #window, #updates, #pulseaudio, #network, #battery, #tray {
    background-color: alpha(@surface, {{BAR_OPACITY}});
    border-radius: {{BAR_RADIUS}}px;
    margin: 3px 2px;
    padding: 0 8px;
}
#clock {
    background-color: alpha(@surface, {{BAR_OPACITY}});
    border-radius: {{BAR_RADIUS}}px;
    margin: 3px 2px;
    padding: 0 10px;
    font-weight: bold;
}
#updates { color: @yellow; }
#window  { color: @subtext; }
#workspaces button {
    padding: 0 6px;
    margin: 2px 1px;
    border-radius: calc({{BAR_RADIUS}}px - 2px);
}
#workspaces button.active { background-color: @accent; color: @bg; }
{{/if}}

/* ==================================== Script Test (our own profiles) ===
 * presets/profile/st-*.conf. The workspace button rules have the same
 * specificity as the shared block below; so these presets' button styles are
 * in the "Script Test: workspaces" block at the end of the file. */

{{#if BAR_IS_ST_YAPRAK}}
/* st-yaprak — one-piece dark strip, bare modules; workspaces are
 * Material-style soft capsules. */
window#waybar { background-color: alpha(@bg-dark, {{BAR_OPACITY}}); }
#workspaces, #window, #tray, #custom-weather, #pulseaudio, #network,
#bluetooth, #battery, #clock {
    background-color: transparent;
    margin: 0 2px;
}
#window { color: @fg; font-style: normal; font-weight: 600; }
#pulseaudio, #network, #bluetooth, #battery, #custom-weather { color: @fg; }
#clock {
    color: @fg;
    font-weight: 600;
    font-size: calc({{FONT_SIZE}}pt - 1pt);
}
{{/if}}

{{#if BAR_IS_ST_GUNBATIMI}}
/* st-gunbatimi — pitch-black strip, everything in one color (the palette FG). */
window#waybar { background-color: @bg-dark; }
#workspaces, #window, #idle-inhibitor, #tray, #bluetooth, #network,
#battery, #clock {
    background-color: transparent;
    color: @fg;
    margin: 0 2px;
    padding: 0 6px;
}
#window { font-style: normal; color: @fg; }
#battery { color: @fg; }
#clock   { font-weight: normal; }
{{/if}}

{{#if BAR_IS_ST_KIZIL}}
/* st-kizil — three floating boxes; thin cream (ACCENT) frame, black background.
 * The metrics on the right are one box: the inner modules' side frames are removed. */
#custom-power, #clock, #workspaces,
#cpu, #memory, #pulseaudio, #backlight, #battery {
    background-color: alpha(@bg-dark, {{BAR_OPACITY}});
    border: 1px solid @accent;
    color: @fg;
}
#custom-power { color: @accent; margin-right: 0; }
#clock        { color: @fg; font-weight: normal; }
#cpu, #memory, #pulseaudio, #backlight, #battery {
    margin: 0;
    border-radius: 0;
    border-left: none;
    border-right: none;
    padding: 2px 7px;
}
#cpu     { border-left: 1px solid @accent;
           border-radius: {{BAR_RADIUS}}px 0 0 {{BAR_RADIUS}}px; }
#battery { border-right: 1px solid @accent;
           border-radius: 0 {{BAR_RADIUS}}px {{BAR_RADIUS}}px 0; }
{{/if}}

{{#if BAR_IS_ST_GECEGOLU}}
/* st-gecegolu — low dark strip, small mono text, boxless modules. */
window#waybar { background-color: alpha(@bg-dark, {{BAR_OPACITY}}); }
#cpu, #temperature, #memory, #disk, #workspaces, #clock, #pulseaudio,
#battery, #network, #bluetooth, #tray, #window {
    background-color: transparent;
    color: @fg;
    margin: 0 1px;
    padding: 0 4px;
    font-family: "{{FONT_MONO}}", monospace;
    font-size: calc({{FONT_SIZE}}pt - 1pt);
}
#clock  { color: @fg; font-weight: normal; }
#window { color: @subtext; font-style: normal; }
{{/if}}

/* ---------------------------------------------------------- workspaces --- */
#workspaces {
    padding: 2px 4px;
}

#workspaces button {
    color: @subtext;
    padding: 0 8px;
    margin: 3px 2px;
    border-radius: {{BAR_RADIUS}}px;
    transition: all 200ms cubic-bezier(0.23, 1, 0.32, 1);
}

#workspaces button:hover {
    background-color: @surface;
    color: @fg;
}

#workspaces button.active {
    background-color: @accent;
    color: @bg-dark;
    font-weight: bold;
    padding: 0 14px;
    border-radius: {{BAR_RADIUS}}px;
}

{{#if BAR_WS_PILL_EXPAND}}
/* pill-expand — the active workspace widens noticeably. */
#workspaces button {
    padding: 0 6px;
}
#workspaces button.active {
    padding: 0 22px;
    border-radius: 999px;
}
{{/if}}

{{#if BAR_WS_UNDERLINE}}
/* underline — digits stay fixed, the active one is underlined; no fill. */
#workspaces button,
#workspaces button.active {
    background-color: transparent;
    border-radius: 0;
    padding: 0 8px;
    border-bottom: 2px solid transparent;
}
#workspaces button.active {
    color: @accent;
    border-bottom-color: @accent;
}
{{/if}}

{{#if BAR_WS_BRACKET}}
/* bracket — no fill, the active one stands out by color only. */
#workspaces button,
#workspaces button.active {
    background-color: transparent;
    border-radius: 0;
    padding: 0 6px;
}
#workspaces button.active { color: @accent; font-weight: bold; }
{{/if}}

{{#if BAR_WS_APP_ICONS}}
/* app-icons — window icons instead of numbers; the box must be wider. */
#workspaces button {
    padding: 0 6px;
}
{{/if}}

{{#if BAR_WS_NAMED}}
/* named — text labels; sized by content instead of a fixed width. */
#workspaces button {
    padding: 0 10px;
    font-size: {{FONT_SIZE}}pt;
}
{{/if}}

#workspaces button.urgent {
    background-color: @red;
    color: @bg-dark;
}

/* -------------------------------------------------------- window ----- */
#window {
    color: @subtext;
    font-style: italic;
}

window#waybar.empty #window {
    background-color: transparent;
}

/* ------------------------------------------------------- modules ----- */
#clock          { color: @accent;  font-weight: bold; }
#cpu            { color: @green; }
#memory         { color: @accent2; }
#backlight      { color: @yellow; }
#pulseaudio     { color: @accent; }
#bluetooth      { color: @accent2; }
#network        { color: @green; }
#battery        { color: @green; }
#submap         { color: @yellow; font-weight: bold; }

#pulseaudio.muted,
#network.disconnected,
#bluetooth.disabled {
    color: @subtext;
}

#battery.warning:not(.charging)  { color: @yellow; }
#battery.critical:not(.charging) {
    color: @bg-dark;
    background-color: @red;
    animation: blink 1s steps(2) infinite;
}

@keyframes blink {
    to { background-color: @bg; color: @red; }
}

#custom-power {
    color: @red;
    font-size: {{FONT_SIZE}}pt;
}

#temperature       { color: @yellow; }
#temperature.critical { color: @red; }
#disk              { color: @subtext; }
#idle-inhibitor.activated { color: @yellow; }

#custom-power:hover {
    background-color: @red;
    color: @bg-dark;
}

#tray menu {
    background-color: @bg;
    color: @fg;
}

/* the dock preset's bottom taskbar — icons of open windows */
#taskbar button {
    padding: 0 6px;
    margin: 2px;
    border-radius: {{BAR_RADIUS}}px;
}

#taskbar button:hover {
    background-color: @surface;
}

#taskbar button.active {
    background-color: alpha(@accent, 0.35);
}

tooltip {
    background-color: @bg-dark;
    border: 1px solid @accent;
    border-radius: {{BAR_RADIUS}}px;
}

tooltip label {
    color: @fg;
    padding: 4px;
}

{{#if BAR_IS_VERTICAL}}
/* ==================================================== vertical bar (left/right)
 * In Waybar "width" is a MINIMUM: the bar grows to the widest module.
 * Horizontal padding/margins are added to that width too — with
 * BAR_PADDING=6 each module took 12px extra, and a rail given BAR_WIDTH=44
 * came out much thicker. Vertically the padding axis is flipped: inner
 * spacing goes up/down, 2px stays on the sides.
 *
 * This block is at the end of the file ON PURPOSE: the #workspaces /
 * #workspaces button rules above (padding: 0 8px, 0 14px for .active) have
 * the same specificity, so if this came earlier they would override these
 * values again — that is why workspace buttons widened the rail in the rail
 * preset. */
#workspaces,
#submap,
#window,
#cpu,
#memory,
#backlight,
#pulseaudio,
#bluetooth,
#network,
#battery,
#temperature,
#disk,
#idle-inhibitor,
#tray,
#clock,
#mpris,
#custom-cava,
#custom-power {
    padding: {{BAR_PADDING}}px 2px;
    margin: 3px 0;
}

#workspaces button,
#workspaces button.active {
    padding: 6px 0;
    margin: 2px 3px;
}

/* Multi-line modules (e.g. "󰻠\n42") are centered with tight line spacing. */
#cpu, #memory, #temperature, #disk, #backlight,
#pulseaudio, #network, #battery, #clock {
    /* GTK CSS has no text-align; the label is already centered. Only the font
     * is shrunk so a three-digit value is sure to fit with 2px side padding. */
    font-size: calc({{FONT_SIZE}}pt - 1pt);
}

/* Since the window title shrinks to an icon when vertical (see config.jsonc.tmpl),
 * the italic body-text rule is meaningless here — keep the icon in the fg color. */
#window {
    color: @fg;
    font-style: normal;
}
{{/if}}

/* ========================================== Script Test: workspaces ===
 * Must come AFTER the shared "#workspaces button" rules (same specificity). */
{{#if BAR_IS_ST_YAPRAK}}
#workspaces button {
    background-color: alpha(@surface, 0.7);
    color: @fg;
    padding: 0 12px;
    margin: 5px 3px;
    border-radius: {{BAR_RADIUS}}px;
}
#workspaces button.active {
    background-color: alpha(@accent, 0.28);
    color: @fg;
    padding: 0 14px;
    border-radius: {{BAR_RADIUS}}px;
    box-shadow: inset 0 0 0 1px alpha(@accent, 0.55);
}
{{/if}}
{{#if BAR_IS_ST_GUNBATIMI}}
#workspaces button {
    color: @subtext;
    padding: 0 7px;
    margin: 4px 2px;
    border-radius: {{BAR_RADIUS}}px;
    border: 1px solid transparent;
}
#workspaces button.active {
    background-color: alpha(@surface, 0.9);
    color: @fg;
    padding: 0 7px;
    border: 1px solid @subtext;
    border-radius: {{BAR_RADIUS}}px;
    font-weight: normal;
}
{{/if}}
{{#if BAR_IS_ST_KIZIL}}
#workspaces button {
    color: alpha(@fg, 0.55);
    padding: 0 7px;
    margin: 2px 1px;
}
#workspaces button.active {
    background-color: transparent;
    color: @accent;
    padding: 0 7px;
    box-shadow: inset 0 -2px @red;
}
{{/if}}
{{#if BAR_IS_ST_GECEGOLU}}
#workspaces button {
    color: @fg;
    background-color: alpha(@surface, 0.9);
    padding: 0 6px;
    margin: 3px 2px;
    border-radius: 999px;
}
#workspaces button.active {
    background-color: @accent;
    color: @bg-dark;
    padding: 0 9px;
    border-radius: 999px;
}
{{/if}}
/* Window name: the shared block makes it italic and comes later; undone here. */
{{#if BAR_IS_ST_YAPRAK}}
#window { font-style: normal; color: @fg; }
{{/if}}
{{#if BAR_IS_ST_GUNBATIMI}}
#window { font-style: normal; color: @fg; }
{{/if}}
{{#if BAR_IS_ST_GECEGOLU}}
#window { font-style: normal; color: @subtext; }
{{/if}}

/* ============================ Script Test third party (temaornek/ adaptations) ===
 * ALL rules for each preset are here, at the very end of the file: the shared
 * module colors above (#clock { color: @accent } etc.) and the workspace button
 * rules have the same specificity, so written earlier they would be overridden.
 * Vertical presets (st-manga, st-limon) get NO horizontal padding — the
 * vertical block's flipped-axis padding is kept. */

{{#if BAR_IS_ST_SEPYA}}
/* st-sepya — beige strip, dark brown 2px frame; the three boxes on the right framed separately. */
window#waybar { background-color: @bg; border: 2px solid @fg; }
#workspaces, #network, #pulseaudio, #clock {
    background-color: transparent;
    color: @fg;
    font-family: "{{FONT_MONO}}", monospace;
    font-weight: normal;
}
#network, #pulseaudio, #clock {
    border: 2px solid @fg;
    border-radius: 0;
    padding: 0 7px;
    margin: 3px 3px;
}
#workspaces button { color: @subtext; padding: 0 3px; margin: 0; border-radius: 0; }
#workspaces button.active {
    background-color: transparent; color: @fg; padding: 0 3px; font-weight: bold;
}
#workspaces button:hover { background-color: @bg-dark; color: @fg; }
{{/if}}

{{#if BAR_IS_ST_METRO}}
/* st-metro — classic bottom taskbar: mustard top line, square workspaces,
 * the window name as a red-framed "task button". */
window#waybar { background-color: @bg-dark; border-top: 1px solid @accent; }
#workspaces, #window, #tray, #pulseaudio, #clock {
    background-color: transparent;
    color: @fg;
    font-family: "{{FONT_MONO}}", monospace;
    margin: 0 2px;
}
#workspaces button {
    color: @fg; padding: 0 6px; margin: 4px 1px; border-radius: 0;
    border: 1px solid alpha(@fg, 0.45);
}
#workspaces button.active {
    background-color: @fg; color: @bg-dark; padding: 0 6px; border-radius: 0;
}
#window {
    font-style: normal; color: @fg;
    background-color: @surface; border: 1px solid @accent2;
    margin: 3px 6px; padding: 0 12px;
}
window#waybar.empty #window { border: none; background-color: transparent; }
#clock { font-weight: normal; }
{{/if}}

{{#if BAR_IS_ST_MANGA}}
/* st-manga — paper-white vertical rail, thin gray separator; everything ink black. */
window#waybar { background-color: @bg; border-right: 1px solid @surface; }
#custom-power, #workspaces, #clock, #pulseaudio, #network, #bluetooth {
    background-color: transparent;
    color: @fg;
}
#clock { font-weight: normal; }
#custom-power { color: @fg; }
#custom-power:hover { background-color: @surface; color: @fg; }
#workspaces button { color: @surface; background-color: transparent; }
#workspaces button.active { color: @fg; background-color: transparent; }
#workspaces button:hover { color: @subtext; background-color: transparent; }
{{/if}}

{{#if BAR_IS_ST_LAVANTA}}
/* st-lavanta — i3 status line: boxless text, modules separated by vertical lines. */
window#waybar { background-color: alpha(@bg-dark, {{BAR_OPACITY}}); }
#workspaces, #battery, #pulseaudio, #backlight, #cpu, #memory, #disk,
#network, #clock {
    background-color: transparent;
    color: @fg;
    font-family: "{{FONT_MONO}}", monospace;
    margin: 0;
    padding: 0 9px;
    border-radius: 0;
}
#pulseaudio, #backlight, #cpu, #memory, #disk, #network, #clock {
    border-left: 1px solid alpha(@subtext, 0.6);
}
#workspaces { padding: 0; }
#workspaces button {
    color: @fg; padding: 0 7px; margin: 0; border-radius: 0;
    border-right: 1px solid alpha(@subtext, 0.4);
}
#workspaces button.active {
    background-color: @accent; color: @bg-dark; padding: 0 7px; border-radius: 0;
}
#clock { font-weight: normal; }
{{/if}}

{{#if BAR_IS_ST_NANE}}
/* st-nane — one thin capsule floating in the middle, bright mint frame. All
 * modules are in the center region; the capsule is that region's box (since GTK
 * CSS does not accept percentage margins, instead of narrowing the window). */
.modules-center {
    background-color: alpha(@bg, {{BAR_OPACITY}});
    border: 1px solid alpha(@accent, 0.7);
    border-radius: {{BAR_RADIUS}}px;
    padding: 0 8px;
}
#workspaces, #clock, #tray, #pulseaudio, #bluetooth, #network, #custom-power {
    background-color: transparent;
    color: @fg;
    margin: 0 1px;
    padding: 0 6px;
}
#clock { font-weight: normal; letter-spacing: 1px; }
#custom-power { color: @fg; }
