#network, #bluetooth { background-color: @accent; color: @bg-dark; font-weight: bold; }
#pulseaudio          { background-color: @accent2; color: @bg-dark; font-weight: bold; }
#battery             { background-color: @fg; color: @bg-dark; font-weight: bold; }
#workspaces button {
    color: @subtext; padding: 0 7px; margin: 3px 1px; border-radius: 6px;
}
#workspaces button.active {
    background-color: @accent; color: @bg-dark; padding: 0 9px; border-radius: 6px;
}
{{/if}}

{{#if BAR_IS_ST_SIYAH}}
/* st-siyah — thin pitch-black strip, small mono text, no boxes. */
window#waybar { background-color: @bg-dark; }
#workspaces, #window, #memory, #battery, #bluetooth, #network, #pulseaudio, #clock {
    background-color: transparent;
