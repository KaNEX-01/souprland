{{! require: BAR==waybar && HAS_WAYBAR }}
// Waybar config — generated by hyprsetup
//
// Module lists are built from BAR_MODULES_LEFT / _CENTER / _RIGHT in
// settings.conf; modules tied to unselected components (bluetooth, network,
// brightness) are dropped automatically. All modules are defined below — a
// definition that is not in the lists is ignored by Waybar.
//
// Module reference: https://github.com/Alexays/Waybar/wiki/Configuration
//
// In two-bar presets ("dock", "rail-top") the root is a JSON ARRAY: with
// Waybar's multi-bar support the first element is the main bar and the second
// an extra bar — the bottom taskbar for dock, the left vertical icon strip
// for rail-top (see render.py:_bar_vars → BAR_MULTI / BAR_HAS_DOCK / BAR_HAS_RAIL).
// In every other bar preset it stays a single object.
// Module DEFINITIONS (blocks like "clock": {...} below) live only in the first
// element; since every array element is independent, the extra bars carry
// the definitions of the modules they use themselves.
{{#if BAR_MULTI}}
[
{{/if}}
{
    "layer": "top",
    "position": "{{BAR_POSITION}}",
    // On a vertical bar (left/right) Waybar wants width instead of height;
    // both the key name and the value are chosen in render.py from BAR_POSITION.
    "{{BAR_SIZE_KEY}}": {{BAR_SIZE}},
{{#if BAR_FIXED_WIDTH}}
    // Centered narrow capsule (pill-single): fixed width, Waybar centers it.
    "width": {{BAR_FIXED_WIDTH}},
{{/if}}
    "spacing": {{BAR_SPACING}},
    "margin-top": {{BAR_MARGIN_TOP}},
    "margin-bottom": {{BAR_MARGIN_BOTTOM}},
    "margin-left": {{BAR_MARGIN_LEFT}},
    "margin-right": {{BAR_MARGIN_RIGHT}},
    // Whether to reserve space for windows. Off while auto-hide is on: a bar
    // that reserves space even while hidden leaves an empty strip at the
    // screen edge and hiding becomes pointless.
    "exclusive": {{BAR_EXCLUSIVE_JSON}},
{{#if BAR_AUTOHIDE_ON}}
    // Auto-hide (BAR_AUTOHIDE). Waybar's "mode": "hide" reads visibility from
    // Sway IPC, which has no Hyprland equivalent; so the bar starts hidden
    // and is toggled with SIGUSR1. hypr/scripts/bar-autohide.py sends the
    // signal when the pointer reaches the edge, MOD+J sends it manually
    // (config/keybinds.json → bar-toggle).
    "start_hidden": true,
    "on-sigusr1": "show",
    "on-sigusr2": "hide",
{{/if}}

    "modules-left": {{BAR_JSON_LEFT}},
    "modules-center": {{BAR_JSON_CENTER}},
    "modules-right": {{BAR_JSON_RIGHT}},

    "hyprland/workspaces": {
        // BAR_WS_FORMAT is chosen in render.py by style: number styles
        // (numbers/pill-expand/underline/bracket/occupied-only) use "{id}"
        // directly — writing "{id}" inside format-icons.default does NOT
        // EXPAND, Waybar prints it as literal text (the bug where buttons
        // showed "{id}" verbatim).
        "format": "{{BAR_WS_FORMAT}}",
        // "on-click": "activate" is left out ON PURPOSE: it is NOT a keyword
        // recognized by Waybar's hyprland/workspaces module (it is not in
        // man 5 waybar-hyprland-workspaces either) — real Waybar tried to run
        // it as a literal shell command and failed with "activate: command
        // not found". The module already switches to the workspace on click,
        // no extra on-click is needed.
        "sort-by-number": true,
        // Without all-outputs:false the "active" dot sometimes gets stuck on
        // the wrong output on multi-monitor setups (e.g. with HDMI focused the
        // bar still shows workspace 1 active) — turn it off so each bar tracks
        // only ITS OWN display. persistent-workspaces still shows
        // WORKSPACE_COUNT buttons on every display.
        "all-outputs": false,
{{#if BAR_WS_DOTS}}
        "format-icons": {
            "active": "●",
            "urgent": "!",
            "default": "○"
        },
{{/if}}
{{#if BAR_WS_ROMAN}}
        "format-icons": {
            "1": "I", "2": "II", "3": "III", "4": "IV", "5": "V",
            "6": "VI", "7": "VII", "8": "VIII", "9": "IX", "10": "X",
            "urgent": "!",
            "default": "•"
        },
{{/if}}
{{#if BAR_WS_OCCUPIED_ONLY}}
        // Only occupied (and active) workspaces are listed.
        "show-special": false,
{{/if}}
{{#if BAR_WS_APP_ICONS}}
        "format-window-separator": " ",
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<firefox|librewolf|zen>": "󰈹",
            "class<brave-browser|chromium|google-chrome>": "",
            "class<kitty|foot|alacritty|ghostty|com.mitchellh.ghostty|org.wezfurlong.wezterm>": "",
            "class<code|codium|code-oss|Code>": "󰨞",
            "class<thunar|nautilus|org.gnome.Nautilus|dolphin|org.kde.dolphin>": "",
            "class<spotify|Spotify>": "",
            "class<discord|vesktop|vencord>": "󰙯",
            "class<steam>": "",
            "class<org.telegram.desktop|telegram-desktop>": "",
            "class<obsidian>": ""
        },
{{/if}}
{{#if BAR_WS_ID_ICONS}}
        "format-window-separator": " ",
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<firefox|librewolf|zen>": "󰈹",
            "class<brave-browser|chromium|google-chrome>": "",
            "class<kitty|foot|alacritty|ghostty|com.mitchellh.ghostty|org.wezfurlong.wezterm>": "",
            "class<code|codium|code-oss|Code>": "󰨞",
            "class<thunar|nautilus|org.gnome.Nautilus|dolphin|org.kde.dolphin>": "",
            "class<spotify|Spotify>": "",
            "class<discord|vesktop|vencord>": "󰙯",
            "class<steam>": "",
            "class<org.telegram.desktop|telegram-desktop>": "",
            "class<obsidian>": ""
        },
{{/if}}
{{#if BAR_WS_NAMED}}
        // 1-5 get special labels; beyond that (BAR_WS_NAMED_EXTRA_JSON) the real number.
        "format-icons": {
            "1": "desk", "2": "web", "3": "code", "4": "chat", "5": "media",
            {{BAR_WS_NAMED_EXTRA_JSON}},
            "urgent": "!",
            "default": "•"
        },
{{/if}}
{{#if BAR_WS_OCCUPIED_ONLY}}
        // occupied-only: no persistent workspaces, so empty ones never show.
        "persistent-workspaces": {}
{{/if}}
{{#unless BAR_WS_OCCUPIED_ONLY}}
        // If the real per-display workspace IDs are known (WORKSPACE_MONITOR_MAP
        // or a workspaces.conf written by a tool like nwg-displays) they are
        // used; otherwise it falls back to the "*": N wildcard (see render.py
        // _persistent_workspaces_json — for the case where the wildcard shows
        // Waybar's local/per-display number instead of the real Hyprland ID).
        "persistent-workspaces": {{BAR_WS_PERSISTENT_JSON}}
{{/unless}}
    },

    "hyprland/submap": {
{{#unless BAR_IS_VERTICAL}}
        "format": "✦ {}",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format": "✦",
        "tooltip-format": "{}",
{{/if}}
        "tooltip": false
    },

    "hyprland/window": {
{{#unless BAR_IS_VERTICAL}}
        "format": "{title}",
        "max-length": {{BAR_WINDOW_MAX_LENGTH}},
        "rewrite": {
            "(.*) — Mozilla Firefox": "🌐 $1",
            "(.*) - Visual Studio Code": "󰨞 $1",
            "": "  Hyprland"
        },
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        // The window title does not fit on a vertical rail; the icon stays, the title moves to the tooltip.
        "format": "󰖯",
        "tooltip-format": "{title}",
{{/if}}
        "separate-outputs": true
    },

    // -------------------------------------------------------------------
    // VERTICAL BAR FORMATS — BAR_IS_VERTICAL conditional blocks
    //
    // In Waybar "width" is a MINIMUM — the bar grows to the widest module.
    // Icon+word formats like "󰈀 connected" take ~50-57px at 11pt, so even a
    // rail given BAR_WIDTH=44 came out that thick. Vertically, numeric
    // modules become "icon\nvalue" (two lines, no % sign), and those carrying
    // words ("connected", "muted", "none") become a plain icon; the reading
    // moves to the tooltip. Only a three-digit number sets the width.
    // -------------------------------------------------------------------

    "cpu": {
        "interval": 3,
{{#unless BAR_IS_VERTICAL}}
        "format": "{{BAR_I_CPU_P}}{usage}%",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format": "{{BAR_I_CPU}}\n{usage}",
{{/if}}
        // Left click: detail panel (System tab); right click: btop.
        "on-click": "~/.config/hypr/scripts/barpanel.py sistem",
        "on-click-right": "{{CMD_TERMINAL}} {{TERMINAL_EXEC_FLAG}} btop",
        "tooltip": true
    },

    "memory": {
        "interval": 5,
{{#unless BAR_IS_VERTICAL}}
        "format": "{{BAR_I_MEM_P}}{percentage}%",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format": "{{BAR_I_MEM}}\n{percentage}",
{{/if}}
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
        "on-click": "~/.config/hypr/scripts/barpanel.py sistem",
        "on-click-right": "{{CMD_TERMINAL}} {{TERMINAL_EXEC_FLAG}} btop"
    },

    "temperature": {
        "interval": 5,
        "critical-threshold": 80,
{{#unless BAR_IS_VERTICAL}}
        "format": "{icon} {temperatureC}°C",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format": "{icon}\n{temperatureC}",
{{/if}}
        "format-icons": {{BAR_I_TEMP}},
        "on-click": "~/.config/hypr/scripts/barpanel.py sistem"
    },

    "disk": {
        "interval": 60,
        "path": "/",
{{#unless BAR_IS_VERTICAL}}
        "format": "{{BAR_I_DISK_P}}{percentage_used}%",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format": "{{BAR_I_DISK}}\n{percentage_used}",
{{/if}}
        "tooltip-format": "{used} / {total} used",
        "on-click": "~/.config/hypr/scripts/barpanel.py sistem"
    },

    "backlight": {
{{#unless BAR_IS_VERTICAL}}
        "format": "{icon} {percent}%",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format": "{icon}\n{percent}",
{{/if}}
        "format-icons": {{BAR_I_BRIGHT}},
        // Left click: bar detail panel (hypr/scripts/barpanel.py).
        "on-click": "~/.config/hypr/scripts/barpanel.py parlaklik",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "pulseaudio": {
{{#unless BAR_IS_VERTICAL}}
        "format": "{icon} {volume}%",
        "format-muted": "{{BAR_I_VOL_MUTE_P}}muted",
        "format-bluetooth": "{{BAR_I_BT_P}}{volume}%",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format": "{icon}\n{volume}",
        "format-muted": "{{BAR_I_VOL_MUTE}}",
        "format-bluetooth": "{{BAR_I_BT}}\n{volume}",
{{/if}}
        "format-icons": {
            "headphone": "{{BAR_I_HEADPHONE}}",
            "headset": "{{BAR_I_HEADSET}}",
            "default": {{BAR_I_VOL}}
        },
        // Left click: detail panel (sliders, device selection); middle click:
        // pavucontrol; right click: mute.
        "on-click": "~/.config/hypr/scripts/barpanel.py ses",
        "on-click-middle": "pavucontrol",
        "on-click-right": "pamixer -t",
        "on-scroll-up": "pamixer -i 5",
        "on-scroll-down": "pamixer -d 5",
        "tooltip-format": "{desc}"
    },

    "bluetooth": {
        "format": "{{BAR_I_BT}}",
        "format-disabled": "{{BAR_I_BT_OFF}}",
{{#unless BAR_IS_VERTICAL}}
        "format-connected": "{{BAR_I_BT_CONN_P}}{num_connections}",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format-connected": "{{BAR_I_BT_CONN}}",
{{/if}}
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "~/.config/hypr/scripts/barpanel.py bluetooth",
        "on-click-right": "blueman-manager"
    },

    "network": {
        // The Wi-Fi icon changes with signal strength; a wired connection is
        // icon only (name and address in the tooltip).
        "format-icons": {{BAR_I_WIFI_LEVELS}},
{{#unless BAR_IS_VERTICAL}}
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "{{BAR_I_ETH}}",
        "format-linked": "{{BAR_I_ETH_P}}{ifname}",
        "format-disconnected": "{{BAR_I_NET_OFF_P}}none",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format-wifi": "{icon}\n{signalStrength}",
        "format-ethernet": "{{BAR_I_ETH}}",
        "format-linked": "{{BAR_I_ETH}}",
        "format-disconnected": "{{BAR_I_NET_OFF}}",
{{/if}}
        "tooltip-format-wifi": "{essid} · {ipaddr}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "on-click": "~/.config/hypr/scripts/barpanel.py ag",
        "on-click-right": "{{CMD_TERMINAL}} {{TERMINAL_EXEC_FLAG}} nmtui"
    },

    "battery": {
        "interval": 30,
        "states": { "warning": 25, "critical": 10 },
{{#unless BAR_IS_VERTICAL}}
        "format": "{icon} {capacity}%",
        "format-charging": "{{BAR_I_BAT_CHG_P}}{capacity}%",
        "format-plugged": "{{BAR_I_BAT_PLUG_P}}{capacity}%",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format": "{icon}\n{capacity}",
        "format-charging": "{{BAR_I_BAT_CHG}}\n{capacity}",
        "format-plugged": "{{BAR_I_BAT_PLUG}}\n{capacity}",
{{/if}}
        "format-icons": {{BAR_I_BAT}},
        "tooltip-format": "{timeTo}",
        "on-click": "~/.config/hypr/scripts/barpanel.py pil"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "{{BAR_I_IDLE_ON}}", "deactivated": "{{BAR_I_IDLE_OFF}}" },
        "tooltip-format-activated": "Sleep inhibited",
        "tooltip-format-deactivated": "Sleep allowed"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    // Center module of the media / stats-only bar presets. Waybar's mpris
    // talks to MPRIS over D-Bus directly, not via playerctl; no extra package.
    "mpris": {
{{#unless BAR_IS_VERTICAL}}
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
{{/unless}}
{{#if BAR_IS_VERTICAL}}
        "format": "{player_icon}",
        "format-paused": "{status_icon}",
{{/if}}
        "dynamic-len": 40,
        "dynamic-order": ["title", "artist"],
        "player-icons": { "default": "▶", "mpv": "🎵" },
        "status-icons": { "paused": "⏸" },
        "tooltip-format": "{player}: {title} — {artist}",
        // Left click opens the detailed player panel (cover, progress, volume,
        // shuffle/repeat, player selection); play/pause on right click.
        "on-click": "~/.config/hypr/scripts/barpanel.py medya",
        "on-click-right": "playerctl play-pause",
        "on-click-middle": "playerctl next"
    },

    // Detailed player: title · artist · position/length, once a second.
    // Unlike mpris it picks the player itself: with several players open,
    // the bar text and the buttons always target the SAME player
    // (see hypr/scripts/media.sh). Hidden when there is no player.
    "custom/media": {
        "exec": "$HOME/.config/hypr/scripts/media.sh info",
        "signal": 8,
        "return-type": "json",
        "interval": 1,
        "escape": false,
        "on-click": "~/.config/hypr/scripts/barpanel.py medya",
        "on-click-right": "$HOME/.config/hypr/scripts/media.sh cmd play-pause",
        "on-scroll-up": "$HOME/.config/hypr/scripts/media.sh cmd position 5+",
        "on-scroll-down": "$HOME/.config/hypr/scripts/media.sh cmd position 5-"
    },
    "custom/media-prev": {
        "exec": "$HOME/.config/hypr/scripts/media.sh prev",
        "signal": 8,
        "return-type": "json",
        "interval": 1,
        "on-click": "$HOME/.config/hypr/scripts/media.sh cmd previous",
        "tooltip": false
    },
    "custom/media-play": {
        "exec": "$HOME/.config/hypr/scripts/media.sh play",
        "signal": 8,
        "return-type": "json",
        "interval": 1,
        "on-click": "$HOME/.config/hypr/scripts/media.sh cmd play-pause",
        "on-click-right": "~/.config/hypr/scripts/barpanel.py medya",
        "tooltip": false
    },
    "custom/media-next": {
        "exec": "$HOME/.config/hypr/scripts/media.sh next",
        "signal": 8,
        "return-type": "json",
        "interval": 1,
        "on-click": "$HOME/.config/hypr/scripts/media.sh cmd next",
        "tooltip": false
    },

    // Notifications: a bell (history has notifications / none) or a muted bell
    // (do not disturb on). Click: history in the panel, right click: do not disturb.
    "custom/notifications": {
        "exec": "$HOME/.config/hypr/scripts/notifylog.py status",
        "return-type": "json",
        "signal": 13,
        "interval": 60,
        "format": "{}",
        "on-click": "~/.config/hypr/scripts/barpanel.py bildirim",
        "on-click-right": "$HOME/.config/hypr/scripts/notifylog.py dnd toggle"
    },

    // Pending package updates (checkupdates + yay/paru -Qua); hidden when
    // there are none. Click: upgrade in a terminal, right click: check again.
    "custom/updates": {
        "exec": "$HOME/.config/hypr/scripts/updates.sh status",
        "return-type": "json",
        "interval": {{UPDATES_INTERVAL_SEC}},
        "signal": 14,
        "format": "{}",
        "on-click": "$HOME/.config/hypr/scripts/updates.sh upgrade",
        "on-click-right": "$HOME/.config/hypr/scripts/updates.sh refresh"
    },

    // Game mode indicator: visible only while the mode is on (see
    // hypr/scripts/gamemode.py). Click: turn off.
    "custom/gamemode": {
        "exec": "$HOME/.config/hypr/scripts/gamemode.py status",
        "return-type": "json",
        "signal": 12,
        "format": "{}",
        "on-click": "$HOME/.config/hypr/scripts/gamemode.py toggle"
    },

    // Song recognition (Shazam, songrec): left click listens to what the
    // computer is playing, right click to the microphone for 9 s; the button
    // shows the listening/recognizing state. The result goes to a notification
    // (with Spotify/YouTube/Shazam buttons) and the clipboard.
    "custom/shazam": {
        "exec": "$HOME/.config/hypr/scripts/actions.py sarki-durum",
        "return-type": "json",
        "signal": 11,
        "format": "{}",
        "on-click": "$HOME/.config/hypr/scripts/actions.py sarki",
        "on-click-right": "$HOME/.config/hypr/scripts/actions.py sarki-mikrofon"
    },

    "clock": {
        "interval": 30,
        "format": "{{BAR_I_CLOCK_P}}{:{{BAR_CLOCK_FORMAT}}}",
        "format-alt": "{{BAR_I_CAL_P}}{:{{BAR_CLOCK_FORMAT_ALT}}}",
        // Left click opens the calendar panel; the long format on right click.
        "format-alt-click": "click-right",
        "on-click": "~/.config/hypr/scripts/barpanel.py takvim",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='{{HEX_ACCENT}}'><b>{}</b></span>",
                "weekdays": "<span color='{{HEX_YELLOW}}'><b>{}</b></span>"
            }
        }
    },

    "custom/power": {
        "format": "{{BAR_I_POWER}}",
        "tooltip-format": "Power menu",
        "on-click": "{{POWERMENU_CMD}}"
    },
{{#if HAS_CAVA}}

    // Audio visualizer. The script runs continuously and prints the bar's new
    // frame on every line; so it is used in streaming mode, not "exec" +
    // restart-interval (see hypr/scripts/cava-bar.sh).
    "custom/cava": {
        "exec": "$HOME/.config/hypr/scripts/cava-bar.sh",
        "format": "{}",
        "tooltip": false
    },
{{/if}}

    // Weather. Reads from wttr.in (needs network) and caches the result for
    // 15 minutes — the service is not hit even if the module runs more often
    // via "interval" (see hypr/scripts/weather.sh).
    "custom/weather": {
        "exec": "$HOME/.config/hypr/scripts/weather.sh",
        "return-type": "json",
        "interval": 900,
        "format": "{}",
        "on-click": "$HOME/.config/hypr/scripts/weather.sh --refresh"
    },

    // Power profile (power-profiles-daemon). Click to switch to the next profile.
    "custom/powerprofile": {
        "exec": "$HOME/.config/hypr/scripts/powerprofile.sh",
        "return-type": "json",
        "interval": 10,
        "format": "{}",
        "on-click": "$HOME/.config/hypr/scripts/powerprofile.sh --cycle"
    },

    // Privacy indicator: an icon shows when some app is using the microphone,
    // camera or screen RIGHT NOW, otherwise the module stays empty (Waybar does
    // not draw a module with empty text).
    "custom/privacy": {
        "exec": "$HOME/.config/hypr/scripts/privacy.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}"
    },
    // Microphone: always visible — dim when idle, red while an app listens,
    // crossed out when muted (see hypr/scripts/mic.sh). Click: mute/unmute,
    // right click: audio panel, wheel: microphone level.
    "custom/mic": {
        "exec": "$HOME/.config/hypr/scripts/mic.sh",
        "return-type": "json",
        "interval": 2,
        "signal": 10,
        "format": "{}",
        "on-click": "$HOME/.config/hypr/scripts/mic.sh toggle",
        "on-click-right": "~/.config/hypr/scripts/barpanel.py ses",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    },

    // Recording indicator: visible while screen recording or instant replay is
    // on (with the recording time), empty when off. Left click: the panel's
    // Recording tab, middle click: start/stop recording, right click: save the
    // last moments.
    "custom/record": {
        "exec": "$HOME/.config/hypr/scripts/record.sh status",
        "return-type": "json",
        "interval": 1,
        "signal": 9,
        "format": "{}",
        "on-click": "~/.config/hypr/scripts/barpanel.py kayit",
        "on-click-middle": "$HOME/.config/hypr/scripts/record.sh record-toggle",
        "on-click-right": "$HOME/.config/hypr/scripts/record.sh replay-save"
    },
{{#if BAR_CUSTOM1_ON}}

    // User-defined slot 1 (BAR_CUSTOM1_*).
    "custom/user1": {
        "exec": {{BAR_CUSTOM1_CMD_JSON}},
        "format": {{BAR_CUSTOM1_FORMAT_JSON}},
        "interval": {{BAR_CUSTOM1_INTERVAL_VALUE}},
{{#if BAR_CUSTOM1_HAS_CLICK}}
        "on-click": {{BAR_CUSTOM1_CLICK_JSON}},
{{/if}}
        "tooltip": false
    },
{{/if}}
{{#if BAR_CUSTOM2_ON}}

    // User-defined slot 2 (BAR_CUSTOM2_*).
    "custom/user2": {
        "exec": {{BAR_CUSTOM2_CMD_JSON}},
        "format": {{BAR_CUSTOM2_FORMAT_JSON}},
        "interval": {{BAR_CUSTOM2_INTERVAL_VALUE}},
{{#if BAR_CUSTOM2_HAS_CLICK}}
        "on-click": {{BAR_CUSTOM2_CLICK_JSON}},
{{/if}}
        "tooltip": false
    },
{{/if}}
{{#if BAR_CUSTOM3_ON}}

    // User-defined slot 3 (BAR_CUSTOM3_*).
    "custom/user3": {
        "exec": {{BAR_CUSTOM3_CMD_JSON}},
        "format": {{BAR_CUSTOM3_FORMAT_JSON}},
        "interval": {{BAR_CUSTOM3_INTERVAL_VALUE}},
{{#if BAR_CUSTOM3_HAS_CLICK}}
        "on-click": {{BAR_CUSTOM3_CLICK_JSON}},
{{/if}}
        "tooltip": false
    },
{{/if}}

    // The bracket bar preset's static "[" / "]" characters — runs no real
    // command, shows fixed text (see render.py:_bar_vars).
    "custom/bracket-open": {
        "format": "["
    },
    "custom/bracket-close": {
        "format": "]"
    }
}
{{#if BAR_HAS_DOCK}}
,
{
    // The "dock" preset's bottom taskbar: the icon row of open windows.
    // Being a separate bar object, it carries the definition of the
    // "wlr/taskbar" module it uses itself (each array element is independent).
    "layer": "top",
    "position": "bottom",
    "height": 36,
    "modules-left": [],
    "modules-center": ["wlr/taskbar"],
    "modules-right": [],

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    }
}
{{/if}}
{{#if BAR_HAS_RAIL}}
,
{
    // The "rail-top" preset's left vertical icon strip: icons of open windows
    // stacked. The main bar (first array element) is the thin status bar on
    // top; this element only draws the rail and carries the "wlr/taskbar"
    // definition it uses itself.
    "layer": "top",
    "position": "left",
    "width": {{BAR_WIDTH}},
    "modules-left": [],
    "modules-center": ["wlr/taskbar"],
    "modules-right": [],

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    }
}
{{/if}}
{{#if BAR_MULTI}}
]
{{/if}}
