{{! require: BAR==wayle && HAS_WAYLE }}
{{! target: wayle/config.toml }}
# Wayle config — theme: {{THEME}} · generated by hyprsetup
# Docs: https://wayle.app/config/
#
# Wayle is NOT just a bar: a notification center, OSD and wallpaper are built
# into it. Running it alongside mako/swaync, swayosd and swww gives double
# notifications/double OSD — see modules/desktop.sh:hook_wayle.
#
# Every field has a default; only those matching a hyprsetup setting are
# written here. For your own additions use the settings window
# (wayle panel settings) or the `wayle config` CLI — THIS FILE IS
# OVERWRITTEN the next time the script runs.

[styling]
# Colors are embedded here instead of a separate theme file: files under themes/
# have to be picked by hand in the settings window, while palette takes effect
# directly. CAREFUL — keys here use DASHES ("fg-muted"), while themes/*.toml
# uses UNDERSCORES ("fg_muted"); they are not the same thing.
rounding = "{{WAYLE_ROUNDING}}"
theme-provider = "wayle"

[styling.palette]
bg = "{{HEX_BG_DARK}}"
surface = "{{HEX_BG}}"
elevated = "{{HEX_SURFACE}}"
fg = "{{HEX_FG}}"
fg-muted = "{{HEX_SUBTEXT}}"
primary = "{{HEX_ACCENT}}"
red = "{{HEX_RED}}"
yellow = "{{HEX_YELLOW}}"
green = "{{HEX_GREEN}}"
blue = "{{HEX_ACCENT2}}"

[bar]
location = "{{WAYLE_LOCATION}}"
background-opacity = {{WAYLE_OPACITY}}
rounding = "{{WAYLE_ROUNDING}}"
# Spacing fields are relative units, not pixels (upstream defaults
# 0.35 / 0.5), so the BAR_* pixel settings are written scaled —
# see render.py:_wayle_vars.
inset-edge = {{WAYLE_INSET_EDGE}}
padding = {{WAYLE_PADDING}}
module-gap = {{WAYLE_MODULE_GAP}}
exclusive = true

# One layout applies to all monitors. monitor = "*" is Wayle's own wildcard;
# HyprPanel had no equivalent and every monitor id had to be written out
# there (a display left out got no bar at all).
[[bar.layout]]
monitor = "*"
left = {{WAYLE_LAYOUT_LEFT}}
center = {{WAYLE_LAYOUT_CENTER}}
right = {{WAYLE_LAYOUT_RIGHT}}

[modules.clock]
format = "{{BAR_CLOCK_FORMAT}}"
