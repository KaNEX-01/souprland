{{! require: LAUNCHER==tofi && HAS_TOFI }}
{{! target: tofi/config }}
# tofi config — theme: {{THEME}} · generated by hyprsetup
# Docs: man 5 tofi
#
# tofi has NO ICON SUPPORT: LAUNCHER_ICONS and LAUNCHER_ICON_SIZE have no
# effect here (see the "Sets" row of the GUI comparison table). Five of the
# seven launcher settings apply.

# -------------------------------------------------------------------- font ---
font = {{FONT_FAMILY}}
font-size = {{FONT_SIZE}}

# ------------------------------------------------------------------ layout ---
# tofi does not grow the window to fit its content; it uses the given size
# exactly — so the height is derived from LAUNCHER_LINES (see render.py).
width = {{LAUNCHER_WIDTH_PCT}}%
height = {{LAUNCHER_HEIGHT_PCT_TOFI}}%
anchor = {{LAUNCHER_ANCHOR}}
corner-radius = {{LAUNCHER_RADIUS_VALUE}}
num-results = {{LAUNCHER_LINES_VALUE}}
result-spacing = 4
padding-top = 14
padding-bottom = 14
padding-left = 20
padding-right = 20

# ------------------------------------------------------------------ colors ---
# In tofi, opacity is not a separate key but the alpha suffix of the background
# color (same idea as LAUNCHER_ALPHA_HEX in the fuzzel template). HEX_* is used,
# not COL_*: tofi expects colors with '#', while COL_* comes without it.
background-color = {{HEX_BG}}{{LAUNCHER_ALPHA_HEX}}
text-color = {{HEX_FG}}
prompt-color = {{HEX_ACCENT}}
placeholder-color = {{HEX_SUBTEXT}}
input-color = {{HEX_FG}}
default-result-color = {{HEX_FG}}
selection-color = {{HEX_ACCENT}}
selection-background = {{HEX_SURFACE}}
selection-background-corner-radius = {{LAUNCHER_INNER_RADIUS}}
border-width = {{LAUNCHER_BORDER_VALUE}}
border-color = {{HEX_ACCENT}}
outline-width = 0
outline-color = {{HEX_BG_DARK}}

# ---------------------------------------------------------------- behavior ---
prompt-text = "{{LAUNCHER_PROMPT_TEXT}} "
terminal = {{CMD_TERMINAL}}
text-cursor-style = bar
matching-algorithm = fuzzy
require-match = false
hide-cursor = true
# Selection history: your most-used apps rise to the top.
history = true
