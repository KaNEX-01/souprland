{{! require: LAUNCHER==rofi && HAS_ROFI }}
/* config.rasi — rofi · theme: {{THEME}} · generated by hyprsetup */

configuration {
    modes: "drun,run,window";
    show-icons: {{LAUNCHER_ICONS_BOOL}};
    display-drun: "{{LAUNCHER_PROMPT_TEXT}}";
    display-run: "Komut";
    display-window: "Pencere";
    drun-display-format: "{name}";
    window-format: "{c}  {t}";
    terminal: "{{CMD_TERMINAL}}";
    sidebar-mode: false;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    kb-cancel: "Escape,MouseSecondary";
}

@theme "~/.config/rofi/hyprsetup.rasi"
