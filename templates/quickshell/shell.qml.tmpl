{{#if HAS_QS_WIDGET_WORLDCLOCK}}
    // Time zone math is left to the system's own tzdata (`date` with the TZ
    // environment variable) — QML's plain JS Date cannot reliably give the
    // time of an arbitrary zone, it only knows the local/UTC offset.
    PanelWindow {
        anchors { top: {{WG_WORLDCLOCK_TOP}}; bottom: {{WG_WORLDCLOCK_BOTTOM}}; left: {{WG_WORLDCLOCK_LEFT}}; right: {{WG_WORLDCLOCK_RIGHT}} }
        margins { top: {{WG_WORLDCLOCK_Y}}; bottom: {{WG_WORLDCLOCK_Y}}; left: {{WG_WORLDCLOCK_X}}; right: {{WG_WORLDCLOCK_X}} }
        implicitWidth: {{WG_WORLDCLOCK_W}}
        implicitHeight: {{WG_WORLDCLOCK_H}}
        color: "transparent"
        exclusiveZone: 0
        // Desktop widget: bottom layer. With the default WlrLayer.Top the
        // window would stay above every app (see the note at the top of the file).
        WlrLayershell.layer: {{WIDGET_LAYER_QML}}
        focusable: false

        Rectangle {
            anchors.fill: parent
            color: "{{WIDGET_BG_QML}}"
            radius: {{WIDGET_RADIUS_VALUE}}
            border.color: "{{HEX_ACCENT}}"
            border.width: 2

            Column {
                anchors.centerIn: parent
                scale: {{WIDGET_SCALE_VALUE}}
                spacing: 4

                Text {
                    id: wcLondon
                    text: "London  --:--"
                    color: "{{HEX_FG}}"
                    font.pixelSize: 13
                    font.family: "{{FONT_FAMILY}}"
                }
                Text {
                    id: wcTokyo
                    text: "Tokyo   --:--"
                    color: "{{HEX_FG}}"
                    font.pixelSize: 13
                    font.family: "{{FONT_FAMILY}}"
                }
                Text {
                    id: wcNewYork
                    text: "New York  --:--"
                    color: "{{HEX_FG}}"
                    font.pixelSize: 13
                    font.family: "{{FONT_FAMILY}}"
                }
            }
        }

        Timer {
            interval: 30000
            running: true
            repeat: true
            triggeredOnStart: true
            onTriggered: {
                wcLondonProc.running = true
                wcTokyoProc.running = true
                wcNewYorkProc.running = true
            }
        }

        Process {
            id: wcLondonProc
            command: ["bash", "-c", "TZ=Europe/London date +%H:%M"]
            stdout: SplitParser { onRead: data => wcLondon.text = "London  " + data }
        }
        Process {
            id: wcTokyoProc
            command: ["bash", "-c", "TZ=Asia/Tokyo date +%H:%M"]
            stdout: SplitParser { onRead: data => wcTokyo.text = "Tokyo   " + data }
        }
        Process {
            id: wcNewYorkProc
            command: ["bash", "-c", "TZ=America/New_York date +%H:%M"]
            stdout: SplitParser { onRead: data => wcNewYork.text = "New York  " + data }
        }
    }
{{/if}}
