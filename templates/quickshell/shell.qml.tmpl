{{#if HAS_QS_WIDGET_SYSINFO}}
    WidgetWindow {
        atTop: {{WG_SYSINFO_TOP}}; atBottom: {{WG_SYSINFO_BOTTOM}}; atLeft: {{WG_SYSINFO_LEFT}}; atRight: {{WG_SYSINFO_RIGHT}}
        mx: {{WG_SYSINFO_X}}; my: {{WG_SYSINFO_Y}}; boxW: {{WG_SYSINFO_W}}; boxH: {{WG_SYSINFO_H}}

        GridLayout {
            id: sysinfo
            anchors.fill: parent
            // Rings side by side, text/bars one under the other.
            columns: ws.meter === "ring" ? 2 : 1
            columnSpacing: ws.px(12)
            rowSpacing: ws.px(ws.meter === "bar" ? 8 : 4)
            property var last: null
            Meter { id: cpuMeter; icon: "󰻠"; label: "CPU"; Layout.fillWidth: true; Layout.fillHeight: true }
            Meter { id: ramMeter; icon: "󰍛"; label: "RAM"; Layout.fillWidth: true; Layout.fillHeight: true }

            // CPU from the /proc/stat delta, RAM from /proc/meminfo — one cat,
            // no top/free (top alone costs ~100 ms each run).
            Timer {
                interval: 2500; running: true; repeat: true; triggeredOnStart: true
                onTriggered: sysProc.running = true
            }
            Process {
                id: sysProc
                command: ["cat", "/proc/stat", "/proc/meminfo"]
                stdout: StdioCollector {
                    onStreamFinished: {
                        const t = text
                        const cpu = t.match(/^cpu\s+(.*)$/m)
                        if (cpu) {
                            const f = cpu[1].trim().split(/\s+/).map(Number)
                            const idle = f[3] + (f[4] || 0)
                            const total = f.reduce((a, b) => a + b, 0)
                            if (sysinfo.last) {
                                const dt = total - sysinfo.last.total
                                if (dt > 0) cpuMeter.value = 1 - (idle - sysinfo.last.idle) / dt
                            }
                            sysinfo.last = { idle: idle, total: total }
                        }
                        const tot = t.match(/^MemTotal:\s+(\d+)/m)
                        const avail = t.match(/^MemAvailable:\s+(\d+)/m)
                        if (tot && avail) ramMeter.value = 1 - Number(avail[1]) / Number(tot[1])
                    }
                }
            }
        }
    }
{{/if}}
