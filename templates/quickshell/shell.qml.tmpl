{{#if HAS_QS_WIDGET_TEMPERATURE}}
    WidgetWindow {
        id: tempWin
        atTop: {{WG_TEMPERATURE_TOP}}; atBottom: {{WG_TEMPERATURE_BOTTOM}}; atLeft: {{WG_TEMPERATURE_LEFT}}; atRight: {{WG_TEMPERATURE_RIGHT}}
        mx: {{WG_TEMPERATURE_X}}; my: {{WG_TEMPERATURE_Y}}; boxW: {{WG_TEMPERATURE_W}}; boxH: {{WG_TEMPERATURE_H}}
        property real celsius: -1
        hasData: celsius >= 0

        // 100 °C = full ring/bar.
        Meter {
            anchors.fill: parent
            icon: tempWin.celsius >= 80 ? "󰸁" : "󰔏"
            label: "CPU temp"
            value: Math.max(0, tempWin.celsius) / 100
            valueText: Math.round(tempWin.celsius) + "°C"
        }
        Timer {
            interval: 5000; running: true; repeat: true; triggeredOnStart: true
            onTriggered: tempProc.running = true
        }
        // The CPU sensor by hwmon name (AMD k10temp / zenpower, Intel
        // coretemp), then the thermal zones. Desktop AMD systems often have no
        // usable thermal zone at all, so reading only /sys/class/thermal gave
        // "--°C" there.
        Process {
            id: tempProc
            command: ["bash", "-c",
                "for h in /sys/class/hwmon/hwmon*; do " +
                "case $(cat $h/name 2>/dev/null) in k10temp|zenpower|coretemp|cpu_thermal) " +
                "cat $h/temp1_input 2>/dev/null && exit;; esac; done; " +
                "for z in /sys/class/thermal/thermal_zone*; do " +
                "case $(cat $z/type 2>/dev/null) in x86_pkg_temp|cpu*|soc*|acpitz) " +
                "cat $z/temp 2>/dev/null && exit;; esac; done"]
            stdout: StdioCollector {
                onStreamFinished: {
                    const v = Number(text.trim().split("\n")[0])
                    tempWin.celsius = v > 0 ? v / 1000 : -1
                }
            }
        }
    }
{{/if}}
