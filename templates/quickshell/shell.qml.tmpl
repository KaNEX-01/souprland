{{! require: HAS_QUICKSHELL || HAS_QUICKSHELL_BAR }}
{{! target: quickshell/hyprsetup/shell.qml }}
// generated by hyprsetup — only the PanelWindow blocks for the widgets you
// picked on the Widget Sets page are included here.
// To add a new widget, update templates/quickshell/shell.qml.tmpl instead of
// editing this file by hand — otherwise your change is lost on the next
// install.
//
// NOTE: This file is the Quickshell/QML counterpart of the 6 widgets in
// templates/eww/eww.yuck.tmpl (clock, sysinfo, battery, calendar, music,
// network) — it uses the same commands (playerctl, nmcli,
// /sys/class/power_supply) and sits in the same corners. It targets
// Quickshell's Process/SplitParser API (Quickshell.Io); if the signature
// differs in your installed Quickshell version (this project could not be
// tested with a real Quickshell session in this environment), to debug: run
// quickshell -p ~/.config/quickshell/hyprsetup/shell.qml and check the QML error in
// the terminal.
//
// LAYERS: the desktop widgets' layer comes from the WIDGET_LAYER setting
// (Bottom = below windows, Top = above); the bar always stays on Top.
// Rationale: the note at the top of templates/eww/eww.yuck.tmpl.
//
// Old note: PanelWindow's default layer is WlrLayer.Top — i.e. if nothing is
// set, the widget is drawn *above* normal app windows and stays fixed on
// screen. So desktop widgets explicitly use WlrLayer.Bottom: above the
// wallpaper, below apps. Only the bar (QS_BAR) is on the Top layer.

import QtQuick
import QtQuick.Layouts
// MonthGrid (calendar widget) lives in QtQuick.Controls in Qt 6.
import QtQuick.Controls
import Quickshell
// WlrLayershell.layer: in Quickshell 0.3 the layer is not PanelWindow's own
// property but an attached property of the Wayland module (writing "layer:"
// kept the config from loading at all, and the bar never opened).
import Quickshell.Wayland
import Quickshell.Io
// Hyprland: the bar's workspaces and the widgets' screen/workspace.
import Quickshell.Hyprland
// Widgets: drop shadow (MultiEffect) and Quickshell's own services — MPRIS,
// PipeWire and UPower update live instead of polling playerctl/pamixer.
import QtQuick.Effects
import Quickshell.Services.Mpris
import Quickshell.Services.Pipewire
import Quickshell.Services.UPower

ShellRoot {
    id: shellRoot
    // Desktop widgets shown? WIDGET_AUTOSTART=false starts with them hidden;
    // MOD+G (widgets.sh → "qs ipc call widgets toggle") flips it. The bar is
    // not affected.
    property bool widgetsShown: {{WIDGET_AUTOSTART_QML}}
    IpcHandler {
        target: "widgets"
        function toggle(): void { shellRoot.widgetsShown = !shellRoot.widgetsShown; }
        function show(): void { shellRoot.widgetsShown = true; }
        function hide(): void { shellRoot.widgetsShown = false; }
    }
{{#if QS_BAR}}
    // ------------------------------------------------------------- bar ---
    // Drawn when BAR=quickshell-bar is selected. Unlike the widgets, this
    // window reserves an exclusiveZone: windows do not go under the bar, they
    // are pushed away from the edge — that is what separates a status bar from
    // a desktop widget.
    // Modules come from the BAR_MODULES_{LEFT,CENTER,RIGHT} lists; render.py
    // turns them into QS_{L,C,R}_<NAME> flags (see QS_BAR_MODULES).
    // One bar per display (like Waybar); a single PanelWindow only opened on
    // the focused display.
    Variants {
        model: Quickshell.screens
    PanelWindow {
        id: qsBar
        required property var modelData
        screen: modelData
        anchors {
            top: {{QS_ANCHOR_TOP}}
            bottom: {{QS_ANCHOR_BOTTOM}}
            left: {{QS_ANCHOR_LEFT}}
            right: {{QS_ANCHOR_RIGHT}}
        }
        margins { top: {{BAR_MARGIN}}; bottom: {{BAR_MARGIN}}; left: {{BAR_MARGIN}}; right: {{BAR_MARGIN}} }
{{#if QS_BAR_AUTOHIDE}}
        // Auto-hide (BAR_AUTOHIDE): normally the bar is just a strip of
        // {{QS_BAR_PEEK}} pixels, and expands to full size when the pointer
        // touches it. Unlike its Waybar counterpart no helper process is
        // needed here — the window sees the pointer itself.
        //
        // HoverHandler is used, not MouseArea: modules have their own
        // MouseAreas and a MouseArea on top would swallow their pointer
        // events. HoverHandler is passive and takes events from no one.
        property bool revealed: false
        Item {
            anchors.fill: parent
            HoverHandler {
                onHoveredChanged: qsBar.revealed = hovered
            }
        }
{{/if}}
{{#if QS_BAR_VERTICAL}}
        implicitWidth: {{QS_BAR_SIZE_EXPR}}
{{/if}}
{{#unless QS_BAR_VERTICAL}}
        implicitHeight: {{QS_BAR_SIZE_EXPR}}
{{/unless}}
        // Reserving space while hidden is pointless: exclusiveZone is 0 with auto-hide.
        exclusiveZone: {{QS_BAR_EXCLUSIVE}}
        // The bar is not a widget: it stays on the top layer so non-fullscreen
        // windows do not cover it. Widgets do the opposite.
        WlrLayershell.layer: WlrLayer.Top
        color: "transparent"
        focusable: false

{{#if BAR_IS_CAELESTIA}}
        // caelestia — "dynamic island": the background covers not the whole bar
        // but a rounded rectangle floating in the middle. That is what sets the
        // source apart; with a full-width background it turns into a plain bar.
        Rectangle {
            anchors.fill: parent
            anchors.margins: {{BAR_MARGIN}}
            color: "{{HEX_BG}}"
            opacity: {{BAR_OPACITY}}
            radius: height / 2
        }
{{/if}}
{{#if BAR_IS_ILLOGICAL_IMPULSE}}
        // illogical-impulse — Material 3: full-width background, a wide but
        // restrained corner radius and a thin divider line above the background
        // (in M3 surfaces are separated by tone, not by shadow).
        Rectangle {
            anchors.fill: parent
            color: "{{HEX_BG}}"
            opacity: {{BAR_OPACITY}}
            radius: {{BAR_RADIUS}}
            Rectangle {
                anchors { left: parent.left; right: parent.right; bottom: parent.bottom }
                height: 1
                color: "{{HEX_SURFACE}}"
                opacity: 0.6
            }
        }
{{/if}}
{{#if BAR_QS_PLAIN}}
        Rectangle {
            anchors.fill: parent
            color: "{{HEX_BG}}"
            opacity: {{BAR_OPACITY}}
            radius: {{BAR_RADIUS}}
        }
{{/if}}

        // Three regions: start / center / end. The center region is always
        // centered, the other two hug their edges. On a horizontal bar these are
        // left/right and the regions a Row; on a vertical (left/right rail) bar
        // they are top/bottom and a Column — all driven by
        // QS_ZONE/QS_START/QS_END/QS_CROSS (see render.py:_quickshell_bar_vars).
        {{QS_ZONE}} {
            anchors { {{QS_START}}: parent.{{QS_START}}; {{QS_CROSS}}: parent.{{QS_CROSS}} }
            anchors.{{QS_START}}Margin: {{BAR_PADDING}}
            spacing: {{BAR_SPACING}}
{{#if QS_L_WORKSPACES}}
            {{QS_ZONE}} {
                spacing: 6
                Repeater {
                    model: Hyprland.workspaces
                    Rectangle {
                        // The active workspace is styled differently per
                        // preset: a stretching fully rounded capsule in
                        // caelestia, M3's expanding pill in illogical-impulse;
                        // both stand out at a glance from the "row of dots".
{{#if BAR_IS_CAELESTIA}}
                        width: modelData.active ? {{QS_WS_WIDTH}} * 2.5 : {{QS_WS_WIDTH}}
                        height: {{QS_WS_HEIGHT}}
                        radius: height / 2
                        Behavior on width { NumberAnimation { duration: 180 } }
{{/if}}
{{#if BAR_IS_ILLOGICAL_IMPULSE}}
                        width: modelData.active ? {{QS_WS_WIDTH}} * 2 : {{QS_WS_WIDTH}}
                        height: {{QS_WS_HEIGHT}}
                        radius: height / 2
                        Behavior on width { NumberAnimation { duration: 220 } }
{{/if}}
{{#if BAR_QS_PLAIN}}
                        width: {{QS_WS_WIDTH}}
                        height: {{QS_WS_HEIGHT}}
                        radius: 4
{{/if}}
                        color: modelData.active ? "{{HEX_ACCENT}}" : "{{HEX_SUBTEXT}}"
                        anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
                        MouseArea {
                            anchors.fill: parent
                            onClicked: Hyprland.dispatch("workspace " + modelData.id)
                        }
                    }
                }
            }
{{/if}}
{{#if QS_L_WINDOW}}
            Text {
                text: ToplevelManager.activeToplevel ? ToplevelManager.activeToplevel.title : ""
                color: "{{HEX_SUBTEXT}}"
                elide: Text.ElideRight
                width: Math.min(implicitWidth, {{QS_TEXT_MAX}})
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_L_CLOCK}}
            Text {
                id: qsBarClockL
                text: Qt.formatDateTime(new Date(), "HH:mm")
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
        }

        {{QS_ZONE}} {
            anchors.centerIn: parent
            spacing: {{BAR_SPACING}}
{{#if QS_C_WINDOW}}
            Text {
                text: ToplevelManager.activeToplevel ? ToplevelManager.activeToplevel.title : ""
                color: "{{HEX_SUBTEXT}}"
                elide: Text.ElideRight
                width: Math.min(implicitWidth, {{QS_TEXT_MAX}})
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_C_CLOCK}}
            Text {
                id: qsBarClockC
                text: Qt.formatDateTime(new Date(), "HH:mm")
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
        }

        {{QS_ZONE}} {
            anchors { {{QS_END}}: parent.{{QS_END}}; {{QS_CROSS}}: parent.{{QS_CROSS}} }
            anchors.{{QS_END}}Margin: {{BAR_PADDING}}
            spacing: {{BAR_SPACING}}
{{#if QS_R_CPU}}
            Text {
                id: qsBarCpu
                text: "CPU --%"
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_R_MEMORY}}
            Text {
                id: qsBarRam
                text: "RAM --%"
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_R_VOLUME}}
            Text {
                id: qsBarVol
                text: "VOL --"
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_R_NETWORK}}
            Text {
                id: qsBarNet
                text: "NET --"
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_R_BATTERY}}
            Text {
                id: qsBarBat
                // Without a battery (desktop) it stays empty and is hidden.
                text: ""
                visible: text !== ""
                color: "{{HEX_ACCENT}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_R_CLOCK}}
            Text {
                id: qsBarClockR
                text: Qt.formatDateTime(new Date(), "HH:mm")
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.bold: true
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
        }

        // The clock refreshes every second, telemetry every 3 seconds. Which
        // texts exist depends on the flags, so each assignment is made only
        // if it is defined.
        Timer {
            interval: 1000
            running: true
            repeat: true
            triggeredOnStart: true
            onTriggered: {
                var now = Qt.formatDateTime(new Date(), "HH:mm")
{{#if QS_L_CLOCK}}
                qsBarClockL.text = now
{{/if}}
{{#if QS_C_CLOCK}}
                qsBarClockC.text = now
{{/if}}
{{#if QS_R_CLOCK}}
                qsBarClockR.text = now
{{/if}}
            }
        }

        Timer {
            interval: 3000
            running: true
            repeat: true
            triggeredOnStart: true
            onTriggered: {
{{#if QS_R_CPU}}
                qsBarCpuProc.running = true
{{/if}}
{{#if QS_R_MEMORY}}
                qsBarRamProc.running = true
{{/if}}
{{#if QS_R_VOLUME}}
                qsBarVolProc.running = true
{{/if}}
{{#if QS_R_NETWORK}}
                qsBarNetProc.running = true
{{/if}}
{{#if QS_R_BATTERY}}
                qsBarBatProc.running = true
{{/if}}
            }
        }
{{#if QS_R_CPU}}
        Process {
            id: qsBarCpuProc
            command: ["bash", "-c",
                "top -bn1 | awk '/Cpu\\(s\\)/{printf \"%.0f\", 100-$8}'"]
            stdout: SplitParser { onRead: data => qsBarCpu.text = "CPU " + data + "%" }
        }
{{/if}}
{{#if QS_R_MEMORY}}
        Process {
            id: qsBarRamProc
            command: ["bash", "-c",
                "free | awk '/Mem:/{printf \"%.0f\", $3/$2*100}'"]
            stdout: SplitParser { onRead: data => qsBarRam.text = "RAM " + data + "%" }
        }
{{/if}}
{{#if QS_R_VOLUME}}
        Process {
            id: qsBarVolProc
            command: ["bash", "-c",
                "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%.0f\", $2*100}'"]
            stdout: SplitParser { onRead: data => qsBarVol.text = "VOL " + data }
        }
{{/if}}
{{#if QS_R_NETWORK}}
        Process {
            id: qsBarNetProc
            command: ["bash", "-c",
                "nmcli -t -f NAME connection show --active | head -n1"]
            stdout: SplitParser { onRead: data => qsBarNet.text = data }
        }
{{/if}}
{{#if QS_R_BATTERY}}
        Process {
            id: qsBarBatProc
            command: ["bash", "-c",
                "cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1"]
            stdout: SplitParser { onRead: data => qsBarBat.text = data ? "BAT " + data + "%" : "" }
        }
{{/if}}
    }
    }
{{/if}}
    // ---------------------------------------------------------- widgets ---
    // Every desktop widget is drawn through WidgetWindow + Card + WText/Meter,
    // and all of them read their look from the "ws" object below. Those
    // values come from the widget STYLE (presets/widget-style/, then the
    // WIDGET_* look settings one by one): changing a style changes every
    // widget in one place. Before this, each widget hard-coded its own plate
    // (dark box, 2 px accent border), so there was exactly one look.
    QtObject {
        id: ws
        readonly property real s: {{WIDGET_SCALE_VALUE}}
        readonly property bool box: {{WS_BOX}}
        readonly property color bg: "{{WS_BG}}"
        readonly property color border: "{{WS_BORDER_COLOR}}"
        readonly property int borderWidth: {{WS_BORDER_WIDTH}}
        readonly property int radius: {{WIDGET_RADIUS_VALUE}}
        readonly property bool shadow: {{WS_SHADOW}}
        readonly property int pad: {{WS_SHADOW_PAD}}
        readonly property bool textShadow: {{WS_TEXT_SHADOW}}
        readonly property string meter: "{{WS_METER}}"
        readonly property string music: "{{WS_MUSIC}}"
        readonly property string clock: "{{WS_CLOCK}}"
        readonly property string ns: "{{WS_NAMESPACE}}"
        readonly property color fg: "{{HEX_FG}}"
        readonly property color sub: "{{HEX_SUBTEXT}}"
        readonly property color accent: "{{HEX_ACCENT}}"
        readonly property color inkOnAccent: "{{HEX_BG}}"
        readonly property color track: "{{WS_TRACK}}"
        readonly property string font: "{{FONT_FAMILY}}"
        // Icons are Nerd Font glyphs: the UI font usually lacks them (they
        // showed up as boxes), the terminal font is a Nerd Font.
        readonly property string iconFont: "{{FONT_MONO}}"
        function px(n) { return Math.round(n * s) }
    }

    // Which screen the widgets live on. WIDGET_MONITOR: connector name
    // ("DP-1") or index; empty = the monitor focused when the shell starts.
    // Without a screen Quickshell used its first screen, which is often not
    // the one with the bar.
    property var widgetScreen: null
    Component.onCompleted: {
        const want = "{{WS_MONITOR}}"
        const screens = Quickshell.screens
        let name = want
        if (want === "" && Hyprland.focusedMonitor)
            name = Hyprland.focusedMonitor.name
        for (let i = 0; i < screens.length; i++)
            if (screens[i].name === name || String(i) === want) {
                widgetScreen = screens[i]
                return
            }
        widgetScreen = screens.length ? screens[0] : null
    }

    component WidgetWindow: PanelWindow {
        id: win
        property bool atTop
        property bool atBottom
        property bool atLeft
        property bool atRight
        property int mx
        property int my
        property int boxW
        property int boxH
        // A widget with nothing to show (no battery, no player…) hides.
        property bool hasData: true
        default property alias content: card.inner
        screen: shellRoot.widgetScreen
        visible: shellRoot.widgetsShown && hasData
        anchors { top: atTop; bottom: atBottom; left: atLeft; right: atRight }
        margins {
            top: Math.max(0, my - ws.pad); bottom: Math.max(0, my - ws.pad)
            left: Math.max(0, mx - ws.pad); right: Math.max(0, mx - ws.pad)
        }
        implicitWidth: boxW + 2 * ws.pad
        implicitHeight: boxH + 2 * ws.pad
        color: "transparent"
        exclusiveZone: 0
        // Bottom = on the desktop below windows, Top = above (WIDGET_LAYER).
        WlrLayershell.layer: {{WIDGET_LAYER_QML}}
        WlrLayershell.namespace: ws.ns
        focusable: false
        Card { id: card; anchors.fill: parent; anchors.margins: ws.pad }
    }

    component Card: Item {
        default property alias inner: body.data
        Rectangle {
            anchors.fill: parent
            visible: ws.box
            color: ws.bg
            radius: Math.min(ws.radius, height / 2)
            border.color: ws.border
            border.width: ws.borderWidth
            layer.enabled: ws.shadow
            layer.effect: MultiEffect {
                shadowEnabled: true
                shadowColor: "#90000000"
                shadowBlur: 0.9
                shadowVerticalOffset: 4
                autoPaddingEnabled: true
            }
        }
        Item {
            id: body
            anchors.fill: parent
            anchors.margins: ws.box ? ws.px(12) : 0
        }
    }

    component WText: Text {
        color: ws.fg
        font.family: ws.font
        font.pixelSize: ws.px(14)
        style: ws.textShadow ? Text.Raised : Text.Normal
        styleColor: "#a0000000"
        elide: Text.ElideRight
    }
    component WIcon: WText {
        font.family: ws.iconFont
        color: ws.accent
    }

    // One value as text ("CPU 39%"), a thin bar or a ring (WIDGET_METER).
    component Meter: Item {
        id: m
        property string icon
        property string label
        property real value: 0          // 0..1
        property string valueText: Math.round(value * 100) + "%"
        property real shown: value
        Behavior on shown { NumberAnimation { duration: 450; easing.type: Easing.OutCubic } }
        onShownChanged: ring.requestPaint()

        RowLayout {
            anchors.fill: parent
            visible: ws.meter === "text"
            spacing: ws.px(8)
            WIcon { text: m.icon; font.pixelSize: ws.px(16) }
            WText { text: m.label; color: ws.sub; Layout.fillWidth: true }
            WText { text: m.valueText; font.bold: true }
        }
        ColumnLayout {
            anchors.fill: parent
            visible: ws.meter === "bar"
            spacing: ws.px(6)
            RowLayout {
                Layout.fillWidth: true
                spacing: ws.px(8)
                WIcon { text: m.icon; font.pixelSize: ws.px(15) }
                WText { text: m.label; color: ws.sub; Layout.fillWidth: true }
                WText { text: m.valueText; font.bold: true }
            }
            Rectangle {
                Layout.fillWidth: true
                implicitHeight: ws.px(5)
                radius: height / 2
                color: ws.track
                Rectangle {
                    width: parent.width * Math.max(0, Math.min(m.shown, 1))
                    height: parent.height
                    radius: height / 2
                    color: ws.accent
                }
            }
        }
        Item {
            anchors.fill: parent
            visible: ws.meter === "ring"
            Canvas {
                id: ring
                width: Math.min(parent.width, parent.height - ws.px(16))
                height: width
                anchors.horizontalCenter: parent.horizontalCenter
                onPaint: {
                    const ctx = getContext("2d")
                    ctx.reset()
                    const lw = Math.max(3, ws.px(6))
                    const r = width / 2 - lw / 2 - 1
                    ctx.lineWidth = lw
                    ctx.lineCap = "round"
                    ctx.strokeStyle = ws.track
                    ctx.beginPath()
                    ctx.arc(width / 2, height / 2, r, 0, 2 * Math.PI)
                    ctx.stroke()
                    const v = Math.max(0, Math.min(m.shown, 1))
                    if (v > 0.005) {
                        ctx.strokeStyle = ws.accent
                        ctx.beginPath()
                        ctx.arc(width / 2, height / 2, r, -Math.PI / 2,
                                -Math.PI / 2 + 2 * Math.PI * v)
                        ctx.stroke()
                    }
                }
                WText {
                    anchors.centerIn: parent
                    text: m.valueText
                    font.bold: true
                    font.pixelSize: ws.px(15)
                }
            }
            WText {
                anchors.bottom: parent.bottom
                anchors.horizontalCenter: parent.horizontalCenter
                text: m.label
                color: ws.sub
                font.pixelSize: ws.px(11)
            }
        }
    }

{{#if HAS_QS_WIDGET_CLOCK}}
    WidgetWindow {
        atTop: {{WG_CLOCK_TOP}}; atBottom: {{WG_CLOCK_BOTTOM}}; atLeft: {{WG_CLOCK_LEFT}}; atRight: {{WG_CLOCK_RIGHT}}
        mx: {{WG_CLOCK_X}}; my: {{WG_CLOCK_Y}}; boxW: {{WG_CLOCK_W}}; boxH: {{WG_CLOCK_H}}

        Item {
            id: clockFace
            anchors.fill: parent
            property date now: new Date()
            Timer {
                interval: 1000; running: true; repeat: true
                onTriggered: clockFace.now = new Date()
            }
            // compact: time + date in one small card
            Column {
                anchors.centerIn: parent
                visible: ws.clock === "compact"
                spacing: ws.px(2)
                WText {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: Qt.formatTime(clockFace.now, "hh:mm:ss")
                    color: ws.accent
                    font.pixelSize: ws.px(28)
                    font.bold: true
                }
                WText {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: Qt.formatDate(clockFace.now, "dddd, d MMMM")
                    color: ws.sub
                    font.pixelSize: ws.px(13)
                }
            }
            // large: a big thin clock, the classic "text on the wallpaper"
            Column {
                anchors.centerIn: parent
                visible: ws.clock === "large"
                spacing: 0
                WText {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: Qt.formatTime(clockFace.now, "hh:mm")
                    font.pixelSize: ws.px(68)
                    font.weight: Font.Light
                    font.letterSpacing: ws.px(2)
                }
                WText {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: Qt.formatDate(clockFace.now, "dddd, d MMMM")
                    color: ws.accent
                    font.pixelSize: ws.px(15)
                    font.letterSpacing: ws.px(1)
                }
            }
            // stacked: hours over minutes
            Column {
                anchors.centerIn: parent
                visible: ws.clock === "stacked"
                spacing: -ws.px(14)
                WText {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: Qt.formatTime(clockFace.now, "hh")
                    font.pixelSize: ws.px(72)
                    font.bold: true
                }
                WText {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: Qt.formatTime(clockFace.now, "mm")
                    color: ws.accent
                    font.pixelSize: ws.px(72)
                    font.bold: true
                }
