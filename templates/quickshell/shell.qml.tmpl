{{! require: HAS_QUICKSHELL || HAS_QUICKSHELL_BAR }}
{{! target: quickshell/shell.qml }}
// generated by hyprsetup — only the PanelWindow blocks for the widgets you
// picked on the Widget Sets page are included here.
// To add a new widget, update templates/quickshell/shell.qml.tmpl instead of
// editing this file by hand — otherwise your change is lost on the next
// install.
//
// NOTE: This file is the Quickshell/QML counterpart of the 6 widgets in
// templates/eww/eww.yuck.tmpl (clock, sysinfo, battery, calendar, music,
// network) — it uses the same commands (playerctl, nmcli,
// /sys/class/power_supply) and sits in the same corners. It targets
// Quickshell's Process/SplitParser API (Quickshell.Io); if the signature
// differs in your installed Quickshell version (this project could not be
// tested with a real Quickshell session in this environment), to debug: run
// quickshell -p ~/.config/quickshell/shell.qml and check the QML error in
// the terminal.
//
// LAYERS: the desktop widgets' layer comes from the WIDGET_LAYER setting
// (Bottom = below windows, Top = above); the bar always stays on Top.
// Rationale: the note at the top of templates/eww/eww.yuck.tmpl.
//
// Old note: PanelWindow's default layer is WlrLayer.Top — i.e. if nothing is
// set, the widget is drawn *above* normal app windows and stays fixed on
// screen. So desktop widgets explicitly use WlrLayer.Bottom: above the
// wallpaper, below apps. Only the bar (QS_BAR) is on the Top layer.

import QtQuick
import QtQuick.Layouts
// MonthGrid (calendar widget) lives in QtQuick.Controls in Qt 6.
import QtQuick.Controls
import Quickshell
// WlrLayershell.layer: in Quickshell 0.3 the layer is not PanelWindow's own
// property but an attached property of the Wayland module (writing "layer:"
// kept the config from loading at all, and the bar never opened).
import Quickshell.Wayland
import Quickshell.Io
{{#if QS_BAR}}
import Quickshell.Hyprland
{{/if}}

ShellRoot {
{{#if QS_BAR}}
    // ------------------------------------------------------------- bar ---
    // Drawn when BAR=quickshell-bar is selected. Unlike the widgets, this
    // window reserves an exclusiveZone: windows do not go under the bar, they
    // are pushed away from the edge — that is what separates a status bar from
    // a desktop widget.
    // Modules come from the BAR_MODULES_{LEFT,CENTER,RIGHT} lists; render.py
    // turns them into QS_{L,C,R}_<NAME> flags (see QS_BAR_MODULES).
    // One bar per display (like Waybar); a single PanelWindow only opened on
    // the focused display.
    Variants {
        model: Quickshell.screens
    PanelWindow {
        id: qsBar
        required property var modelData
        screen: modelData
        anchors {
            top: {{QS_ANCHOR_TOP}}
            bottom: {{QS_ANCHOR_BOTTOM}}
            left: {{QS_ANCHOR_LEFT}}
            right: {{QS_ANCHOR_RIGHT}}
        }
        margins { top: {{BAR_MARGIN}}; bottom: {{BAR_MARGIN}}; left: {{BAR_MARGIN}}; right: {{BAR_MARGIN}} }
{{#if QS_BAR_AUTOHIDE}}
        // Auto-hide (BAR_AUTOHIDE): normally the bar is just a strip of
        // {{QS_BAR_PEEK}} pixels, and expands to full size when the pointer
        // touches it. Unlike its Waybar counterpart no helper process is
        // needed here — the window sees the pointer itself.
        //
        // HoverHandler is used, not MouseArea: modules have their own
        // MouseAreas and a MouseArea on top would swallow their pointer
        // events. HoverHandler is passive and takes events from no one.
        property bool revealed: false
        Item {
            anchors.fill: parent
            HoverHandler {
                onHoveredChanged: qsBar.revealed = hovered
            }
        }
{{/if}}
{{#if QS_BAR_VERTICAL}}
        implicitWidth: {{QS_BAR_SIZE_EXPR}}
{{/if}}
{{#unless QS_BAR_VERTICAL}}
        implicitHeight: {{QS_BAR_SIZE_EXPR}}
{{/unless}}
        // Reserving space while hidden is pointless: exclusiveZone is 0 with auto-hide.
        exclusiveZone: {{QS_BAR_EXCLUSIVE}}
        // The bar is not a widget: it stays on the top layer so non-fullscreen
        // windows do not cover it. Widgets do the opposite.
        WlrLayershell.layer: WlrLayer.Top
        color: "transparent"
        focusable: false

{{#if BAR_IS_CAELESTIA}}
        // caelestia — "dynamic island": the background covers not the whole bar
        // but a rounded rectangle floating in the middle. That is what sets the
        // source apart; with a full-width background it turns into a plain bar.
        Rectangle {
            anchors.fill: parent
            anchors.margins: {{BAR_MARGIN}}
            color: "{{HEX_BG}}"
            opacity: {{BAR_OPACITY}}
            radius: height / 2
        }
{{/if}}
{{#if BAR_IS_ILLOGICAL_IMPULSE}}
        // illogical-impulse — Material 3: full-width background, a wide but
        // restrained corner radius and a thin divider line above the background
        // (in M3 surfaces are separated by tone, not by shadow).
        Rectangle {
            anchors.fill: parent
            color: "{{HEX_BG}}"
            opacity: {{BAR_OPACITY}}
            radius: {{BAR_RADIUS}}
            Rectangle {
                anchors { left: parent.left; right: parent.right; bottom: parent.bottom }
                height: 1
                color: "{{HEX_SURFACE}}"
                opacity: 0.6
            }
        }
{{/if}}
{{#if BAR_QS_PLAIN}}
        Rectangle {
            anchors.fill: parent
            color: "{{HEX_BG}}"
            opacity: {{BAR_OPACITY}}
            radius: {{BAR_RADIUS}}
        }
{{/if}}

        // Three regions: start / center / end. The center region is always
        // centered, the other two hug their edges. On a horizontal bar these are
        // left/right and the regions a Row; on a vertical (left/right rail) bar
        // they are top/bottom and a Column — all driven by
        // QS_ZONE/QS_START/QS_END/QS_CROSS (see render.py:_quickshell_bar_vars).
        {{QS_ZONE}} {
            anchors { {{QS_START}}: parent.{{QS_START}}; {{QS_CROSS}}: parent.{{QS_CROSS}} }
            anchors.{{QS_START}}Margin: {{BAR_PADDING}}
            spacing: {{BAR_SPACING}}
{{#if QS_L_WORKSPACES}}
            {{QS_ZONE}} {
                spacing: 6
                Repeater {
                    model: Hyprland.workspaces
                    Rectangle {
                        // The active workspace is styled differently per
                        // preset: a stretching fully rounded capsule in
                        // caelestia, M3's expanding pill in illogical-impulse;
                        // both stand out at a glance from the "row of dots".
{{#if BAR_IS_CAELESTIA}}
                        width: modelData.active ? {{QS_WS_WIDTH}} * 2.5 : {{QS_WS_WIDTH}}
                        height: {{QS_WS_HEIGHT}}
                        radius: height / 2
                        Behavior on width { NumberAnimation { duration: 180 } }
{{/if}}
{{#if BAR_IS_ILLOGICAL_IMPULSE}}
                        width: modelData.active ? {{QS_WS_WIDTH}} * 2 : {{QS_WS_WIDTH}}
                        height: {{QS_WS_HEIGHT}}
                        radius: height / 2
                        Behavior on width { NumberAnimation { duration: 220 } }
{{/if}}
{{#if BAR_QS_PLAIN}}
                        width: {{QS_WS_WIDTH}}
                        height: {{QS_WS_HEIGHT}}
                        radius: 4
{{/if}}
                        color: modelData.active ? "{{HEX_ACCENT}}" : "{{HEX_SUBTEXT}}"
                        anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
                        MouseArea {
                            anchors.fill: parent
                            onClicked: Hyprland.dispatch("workspace " + modelData.id)
                        }
                    }
                }
            }
{{/if}}
{{#if QS_L_WINDOW}}
            Text {
                text: ToplevelManager.activeToplevel ? ToplevelManager.activeToplevel.title : ""
                color: "{{HEX_SUBTEXT}}"
                elide: Text.ElideRight
                width: Math.min(implicitWidth, {{QS_TEXT_MAX}})
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_L_CLOCK}}
            Text {
                id: qsBarClockL
                text: Qt.formatDateTime(new Date(), "HH:mm")
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
        }

        {{QS_ZONE}} {
            anchors.centerIn: parent
            spacing: {{BAR_SPACING}}
{{#if QS_C_WINDOW}}
            Text {
                text: ToplevelManager.activeToplevel ? ToplevelManager.activeToplevel.title : ""
                color: "{{HEX_SUBTEXT}}"
                elide: Text.ElideRight
                width: Math.min(implicitWidth, {{QS_TEXT_MAX}})
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_C_CLOCK}}
            Text {
                id: qsBarClockC
                text: Qt.formatDateTime(new Date(), "HH:mm")
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
        }

        {{QS_ZONE}} {
            anchors { {{QS_END}}: parent.{{QS_END}}; {{QS_CROSS}}: parent.{{QS_CROSS}} }
            anchors.{{QS_END}}Margin: {{BAR_PADDING}}
            spacing: {{BAR_SPACING}}
{{#if QS_R_CPU}}
            Text {
                id: qsBarCpu
                text: "CPU --%"
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_R_MEMORY}}
            Text {
                id: qsBarRam
                text: "RAM --%"
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_R_VOLUME}}
            Text {
                id: qsBarVol
                text: "VOL --"
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_R_NETWORK}}
            Text {
                id: qsBarNet
                text: "NET --"
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_R_BATTERY}}
            Text {
                id: qsBarBat
                // Without a battery (desktop) it stays empty and is hidden.
                text: ""
                visible: text !== ""
                color: "{{HEX_ACCENT}}"
                font.pixelSize: {{FONT_SIZE}}
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
{{#if QS_R_CLOCK}}
            Text {
                id: qsBarClockR
                text: Qt.formatDateTime(new Date(), "HH:mm")
                color: "{{HEX_FG}}"
                font.pixelSize: {{FONT_SIZE}}
                font.bold: true
                font.family: "{{FONT_FAMILY}}"
                anchors.{{QS_CROSS}}: parent.{{QS_CROSS}}
            }
{{/if}}
        }

        // The clock refreshes every second, telemetry every 3 seconds. Which
        // texts exist depends on the flags, so each assignment is made only
        // if it is defined.
        Timer {
            interval: 1000
            running: true
            repeat: true
            triggeredOnStart: true
            onTriggered: {
                var now = Qt.formatDateTime(new Date(), "HH:mm")
{{#if QS_L_CLOCK}}
                qsBarClockL.text = now
{{/if}}
{{#if QS_C_CLOCK}}
                qsBarClockC.text = now
{{/if}}
{{#if QS_R_CLOCK}}
                qsBarClockR.text = now
{{/if}}
            }
        }

        Timer {
            interval: 3000
            running: true
            repeat: true
            triggeredOnStart: true
            onTriggered: {
{{#if QS_R_CPU}}
                qsBarCpuProc.running = true
{{/if}}
{{#if QS_R_MEMORY}}
                qsBarRamProc.running = true
{{/if}}
{{#if QS_R_VOLUME}}
                qsBarVolProc.running = true
{{/if}}
{{#if QS_R_NETWORK}}
                qsBarNetProc.running = true
{{/if}}
{{#if QS_R_BATTERY}}
                qsBarBatProc.running = true
{{/if}}
            }
        }
{{#if QS_R_CPU}}
        Process {
            id: qsBarCpuProc
            command: ["bash", "-c",
                "top -bn1 | awk '/Cpu\\(s\\)/{printf \"%.0f\", 100-$8}'"]
            stdout: SplitParser { onRead: data => qsBarCpu.text = "CPU " + data + "%" }
        }
{{/if}}
{{#if QS_R_MEMORY}}
        Process {
            id: qsBarRamProc
            command: ["bash", "-c",
                "free | awk '/Mem:/{printf \"%.0f\", $3/$2*100}'"]
            stdout: SplitParser { onRead: data => qsBarRam.text = "RAM " + data + "%" }
        }
{{/if}}
{{#if QS_R_VOLUME}}
        Process {
            id: qsBarVolProc
            command: ["bash", "-c",
                "wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf \"%.0f\", $2*100}'"]
            stdout: SplitParser { onRead: data => qsBarVol.text = "VOL " + data }
        }
{{/if}}
{{#if QS_R_NETWORK}}
        Process {
            id: qsBarNetProc
            command: ["bash", "-c",
                "nmcli -t -f NAME connection show --active | head -n1"]
            stdout: SplitParser { onRead: data => qsBarNet.text = data }
        }
{{/if}}
{{#if QS_R_BATTERY}}
        Process {
            id: qsBarBatProc
            command: ["bash", "-c",
                "cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1"]
            stdout: SplitParser { onRead: data => qsBarBat.text = data ? "BAT " + data + "%" : "" }
        }
{{/if}}
    }
    }
{{/if}}
{{#if HAS_QS_WIDGET_CLOCK}}
    PanelWindow {
        anchors { top: {{WG_CLOCK_TOP}}; bottom: {{WG_CLOCK_BOTTOM}}; left: {{WG_CLOCK_LEFT}}; right: {{WG_CLOCK_RIGHT}} }
        margins { top: {{WG_CLOCK_Y}}; bottom: {{WG_CLOCK_Y}}; left: {{WG_CLOCK_X}}; right: {{WG_CLOCK_X}} }
        implicitWidth: {{WG_CLOCK_W}}
        implicitHeight: {{WG_CLOCK_H}}
        color: "transparent"
        exclusiveZone: 0
        // Desktop widget: bottom layer. With the default WlrLayer.Top the
        // window would stay above every app (see the note at the top of the file).
        WlrLayershell.layer: {{WIDGET_LAYER_QML}}
        focusable: false

        Rectangle {
            anchors.fill: parent
            color: "{{WIDGET_BG_QML}}"
            radius: {{WIDGET_RADIUS_VALUE}}
            border.color: "{{HEX_ACCENT}}"
            border.width: 2

            Column {
                anchors.centerIn: parent
                scale: {{WIDGET_SCALE_VALUE}}
                spacing: 4

                Text {
                    id: clockTime
                    text: Qt.formatTime(new Date(), "hh:mm:ss")
                    color: "{{HEX_ACCENT}}"
                    font.pixelSize: 28
                    font.bold: true
                    font.family: "{{FONT_FAMILY}}"
                }
                Text {
                    id: clockDate
                    text: Qt.formatDate(new Date(), "dddd, d MMMM")
                    color: "{{HEX_SUBTEXT}}"
                    font.pixelSize: 13
                    font.family: "{{FONT_FAMILY}}"
                }
            }
        }

        Timer {
            interval: 1000
            running: true
            repeat: true
            onTriggered: {
                clockTime.text = Qt.formatTime(new Date(), "hh:mm:ss")
                clockDate.text = Qt.formatDate(new Date(), "dddd, d MMMM")
            }
        }
    }
{{/if}}
{{#if HAS_QS_WIDGET_SYSINFO}}
    PanelWindow {
        anchors { top: {{WG_SYSINFO_TOP}}; bottom: {{WG_SYSINFO_BOTTOM}}; left: {{WG_SYSINFO_LEFT}}; right: {{WG_SYSINFO_RIGHT}} }
        margins { top: {{WG_SYSINFO_Y}}; bottom: {{WG_SYSINFO_Y}}; left: {{WG_SYSINFO_X}}; right: {{WG_SYSINFO_X}} }
        implicitWidth: {{WG_SYSINFO_W}}
        implicitHeight: {{WG_SYSINFO_H}}
        color: "transparent"
        exclusiveZone: 0
        // Desktop widget: bottom layer. With the default WlrLayer.Top the
        // window would stay above every app (see the note at the top of the file).
        WlrLayershell.layer: {{WIDGET_LAYER_QML}}
        focusable: false

        Rectangle {
            anchors.fill: parent
            color: "{{WIDGET_BG_QML}}"
            radius: {{WIDGET_RADIUS_VALUE}}
            border.color: "{{HEX_ACCENT}}"
            border.width: 2

            Column {
                anchors.centerIn: parent
                scale: {{WIDGET_SCALE_VALUE}}
                spacing: 6

                Text {
                    id: sysinfoCpu
                    text: "CPU  --%"
                    color: "{{HEX_FG}}"
                    font.pixelSize: 15
                    font.family: "{{FONT_FAMILY}}"
                }
                Text {
                    id: sysinfoRam
                    text: "RAM  --%"
                    color: "{{HEX_FG}}"
                    font.pixelSize: 15
                    font.family: "{{FONT_FAMILY}}"
                }
            }
        }

        // top's one-line total CPU usage; free -m for RAM.
        // The eww version used the built-in EWW_CPU/EWW_RAM "magic" variables
        // — Quickshell has no equivalent, so they are read directly with a
        // shell command.
        Timer {
            interval: 3000
            running: true
            repeat: true
            triggeredOnStart: true
            onTriggered: { cpuProc.running = true; ramProc.running = true }
        }

        Process {
            id: cpuProc
            command: ["bash", "-c",
                "top -bn1 | awk '/Cpu\\(s\\)/{printf \"%.0f\", 100-$8}'"]
            stdout: SplitParser {
                onRead: data => sysinfoCpu.text = "CPU  " + data + "%"
            }
        }

        Process {
            id: ramProc
            command: ["bash", "-c",
                "free | awk '/Mem:/{printf \"%.0f\", $3/$2*100}'"]
            stdout: SplitParser {
                onRead: data => sysinfoRam.text = "RAM  " + data + "%"
            }
        }
    }
{{/if}}
{{#if HAS_QS_WIDGET_BATTERY}}
    PanelWindow {
        anchors { top: {{WG_BATTERY_TOP}}; bottom: {{WG_BATTERY_BOTTOM}}; left: {{WG_BATTERY_LEFT}}; right: {{WG_BATTERY_RIGHT}} }
        margins { top: {{WG_BATTERY_Y}}; bottom: {{WG_BATTERY_Y}}; left: {{WG_BATTERY_X}}; right: {{WG_BATTERY_X}} }
        implicitWidth: {{WG_BATTERY_W}}
        implicitHeight: {{WG_BATTERY_H}}
        color: "transparent"
        exclusiveZone: 0
        // Desktop widget: bottom layer. With the default WlrLayer.Top the
        // window would stay above every app (see the note at the top of the file).
        WlrLayershell.layer: {{WIDGET_LAYER_QML}}
        focusable: false

        Rectangle {
            anchors.fill: parent
            color: "{{WIDGET_BG_QML}}"
            radius: {{WIDGET_RADIUS_VALUE}}
            border.color: "{{HEX_ACCENT}}"
            border.width: 2

            Text {
                id: batteryLabel
                anchors.centerIn: parent
                scale: {{WIDGET_SCALE_VALUE}}
                text: "🔋 --"
                color: "{{HEX_FG}}"
                font.pixelSize: 15
                font.family: "{{FONT_FAMILY}}"
            }
        }

        // On a desktop (no battery) the BAT0 path does not exist — the command
        // exits empty/failed, SplitParser never fires and the label quietly stays
        // at "--" (same fallback as EWW_BATTERY.BAT0 ?: 0 in the eww version).
        Timer {
            interval: 5000
            running: true
            repeat: true
            triggeredOnStart: true
            onTriggered: batteryProc.running = true
        }

        Process {
            id: batteryProc
            command: ["bash", "-c",
                "cat /sys/class/power_supply/BAT0/capacity 2>/dev/null; " +
                "s=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null); " +
                "[ -n \"$s\" ] && echo \" $s\""]
            stdout: SplitParser {
                onRead: data => batteryLabel.text = "🔋 " + data + "%"
            }
        }
    }
{{/if}}
{{#if HAS_QS_WIDGET_CALENDAR}}
    PanelWindow {
        anchors { top: {{WG_CALENDAR_TOP}}; bottom: {{WG_CALENDAR_BOTTOM}}; left: {{WG_CALENDAR_LEFT}}; right: {{WG_CALENDAR_RIGHT}} }
        margins { top: {{WG_CALENDAR_Y}}; bottom: {{WG_CALENDAR_Y}}; left: {{WG_CALENDAR_X}}; right: {{WG_CALENDAR_X}} }
        implicitWidth: {{WG_CALENDAR_W}}
        implicitHeight: {{WG_CALENDAR_H}}
        color: "transparent"
        exclusiveZone: 0
        // Desktop widget: bottom layer. With the default WlrLayer.Top the
        // window would stay above every app (see the note at the top of the file).
        WlrLayershell.layer: {{WIDGET_LAYER_QML}}
        focusable: false

        Rectangle {
            anchors.fill: parent
            color: "{{WIDGET_BG_QML}}"
            radius: {{WIDGET_RADIUS_VALUE}}
            border.color: "{{HEX_ACCENT}}"
            border.width: 2

            Column {
                anchors.fill: parent
                scale: {{WIDGET_SCALE_VALUE}}
                anchors.margins: 12
                spacing: 6

                Text {
                    text: Qt.formatDate(new Date(), "MMMM yyyy")
                    color: "{{HEX_ACCENT}}"
                    font.pixelSize: 15
                    font.bold: true
                    font.family: "{{FONT_FAMILY}}"
                }

                // Qt.labs.calendar's MonthGrid (a standard Qt Quick module, not a
                // Quickshell-specific component) — the closest match to eww's
                // built-in (calendar) widget.
                MonthGrid {
                    id: monthGrid
                    width: parent.width
                    height: parent.height - 30
                    month: new Date().getMonth()
                    year: new Date().getFullYear()
                    locale: Qt.locale("tr_TR")

                    delegate: Text {
                        required property var model
                        text: model.day
                        color: model.month === monthGrid.month
                               ? "{{HEX_FG}}" : "{{HEX_SUBTEXT}}"
                        font.pixelSize: 12
                        font.family: "{{FONT_FAMILY}}"
                        horizontalAlignment: Text.AlignHCenter
                        verticalAlignment: Text.AlignVCenter
                    }
                }
            }
        }
    }
{{/if}}
{{#if HAS_QS_WIDGET_MUSIC}}
    PanelWindow {
        anchors { top: {{WG_MUSIC_TOP}}; bottom: {{WG_MUSIC_BOTTOM}}; left: {{WG_MUSIC_LEFT}}; right: {{WG_MUSIC_RIGHT}} }
        margins { top: {{WG_MUSIC_Y}}; bottom: {{WG_MUSIC_Y}}; left: {{WG_MUSIC_X}}; right: {{WG_MUSIC_X}} }
        implicitWidth: {{WG_MUSIC_W}}
        implicitHeight: {{WG_MUSIC_H}}
        color: "transparent"
        exclusiveZone: 0
        // Desktop widget: bottom layer. With the default WlrLayer.Top the
        // window would stay above every app (see the note at the top of the file).
        WlrLayershell.layer: {{WIDGET_LAYER_QML}}
        focusable: false

        Rectangle {
            anchors.fill: parent
            color: "{{WIDGET_BG_QML}}"
            radius: {{WIDGET_RADIUS_VALUE}}
            border.color: "{{HEX_ACCENT}}"
            border.width: 2

            Text {
                id: musicLabel
                anchors.fill: parent
                scale: {{WIDGET_SCALE_VALUE}}
                anchors.margins: 10
                text: "▷ Nothing playing"
                color: "{{HEX_FG}}"
                font.pixelSize: 14
                font.family: "{{FONT_FAMILY}}"
                elide: Text.ElideRight
                verticalAlignment: Text.AlignVCenter
            }
        }

        Timer {
            interval: 3000
            running: true
            repeat: true
            triggeredOnStart: true
            onTriggered: musicProc.running = true
        }

        Process {
            id: musicProc
            command: ["bash", "-c",
                "a=$(playerctl metadata artist 2>/dev/null); " +
                "t=$(playerctl metadata title 2>/dev/null); " +
                "[ -n \"$t\" ] && echo \"$a - $t\" || echo '▷ Nothing playing'"]
            stdout: SplitParser {
                onRead: data => musicLabel.text = data
            }
        }
    }
{{/if}}
