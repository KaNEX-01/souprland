{{#if HAS_QS_WIDGET_CALENDAR}}
    WidgetWindow {
        atTop: {{WG_CALENDAR_TOP}}; atBottom: {{WG_CALENDAR_BOTTOM}}; atLeft: {{WG_CALENDAR_LEFT}}; atRight: {{WG_CALENDAR_RIGHT}}
        mx: {{WG_CALENDAR_X}}; my: {{WG_CALENDAR_Y}}; boxW: {{WG_CALENDAR_W}}; boxH: {{WG_CALENDAR_H}}

        // Own grid instead of MonthGrid: MonthGrid's delegate model gave odd
        // colours, today was not marked, and it ignored WIDGET_SCALE.
        ColumnLayout {
            id: cal
            anchors.fill: parent
            spacing: ws.px(4)
            property date today: new Date()
            readonly property var loc: Qt.locale()
            readonly property int first: loc.firstDayOfWeek % 7      // 0 = Sunday
            readonly property var cells: {
                const y = today.getFullYear(), mo = today.getMonth()
                const start = (new Date(y, mo, 1).getDay() - first + 7) % 7
                const out = []
                for (let i = 0; i < 42; i++) {
                    const d = new Date(y, mo, 1 - start + i)
                    out.push({ day: d.getDate(), inMonth: d.getMonth() === mo,
                               isToday: d.toDateString() === today.toDateString() })
                }
                return out
            }
            Timer {
                interval: 60000; running: true; repeat: true
                onTriggered: cal.today = new Date()
            }
            WText {
                text: cal.loc.standaloneMonthName(cal.today.getMonth()) + " " + cal.today.getFullYear()
                color: ws.accent
                font.bold: true
                font.pixelSize: ws.px(15)
            }
            GridLayout {
                Layout.fillWidth: true
                Layout.fillHeight: true
                columns: 7
                rowSpacing: 0
                columnSpacing: 0
                Repeater {
                    model: 7
                    WText {
                        required property int index
                        Layout.fillWidth: true
                        horizontalAlignment: Text.AlignHCenter
                        text: cal.loc.dayName((cal.first + index) % 7, Locale.NarrowFormat)
                        color: ws.sub
                        font.pixelSize: ws.px(11)
                        font.bold: true
                    }
                }
                Repeater {
                    model: cal.cells
                    Item {
                        required property var modelData
                        Layout.fillWidth: true
                        Layout.fillHeight: true
                        Rectangle {
                            anchors.centerIn: parent
                            width: Math.min(parent.width, parent.height) - 2
                            height: width
                            radius: width / 2
                            color: ws.accent
                            visible: modelData.isToday
                        }
                        WText {
                            anchors.centerIn: parent
                            text: modelData.day
                            font.pixelSize: ws.px(12)
                            font.bold: modelData.isToday
                            style: Text.Normal
                            color: modelData.isToday ? ws.inkOnAccent : ws.fg
                            opacity: modelData.inMonth ? 1 : 0.35
                        }
                    }
                }
            }
        }
    }
{{/if}}
{{#if HAS_QS_WIDGET_MUSIC}}
    WidgetWindow {
        id: musicWin
        atTop: {{WG_MUSIC_TOP}}; atBottom: {{WG_MUSIC_BOTTOM}}; atLeft: {{WG_MUSIC_LEFT}}; atRight: {{WG_MUSIC_RIGHT}}
        mx: {{WG_MUSIC_X}}; my: {{WG_MUSIC_Y}}; boxW: {{WG_MUSIC_W}}; boxH: {{WG_MUSIC_H}}
        // MPRIS through Quickshell's own service: updates at once instead of
        // polling playerctl every 3 s. The playing player wins, else the first.
        readonly property var player: {
            const list = Mpris.players.values
            for (let i = 0; i < list.length; i++)
                if (list[i].isPlaying) return list[i]
            return list.length ? list[0] : null
        }
        hasData: player !== null

        // Position is not pushed by MPRIS; ask for it while playing.
        Timer {
            interval: 1000
            running: musicWin.player !== null && musicWin.player.isPlaying && ws.music === "card"
            repeat: true
            onTriggered: musicWin.player.positionChanged()
        }

        RowLayout {
            anchors.fill: parent
            visible: ws.music === "line"
            spacing: ws.px(8)
            WIcon { text: musicWin.player && musicWin.player.isPlaying ? "󰏤" : "󰐊"; font.pixelSize: ws.px(15)
                MouseArea { anchors.fill: parent; onClicked: musicWin.player.togglePlaying() } }
            WText {
                Layout.fillWidth: true
                text: musicWin.player
                      ? (musicWin.player.trackArtist ? musicWin.player.trackArtist + " – " : "")
                        + musicWin.player.trackTitle
                      : ""
            }
        }

        RowLayout {
            anchors.fill: parent
            visible: ws.music === "card"
            spacing: ws.px(12)
            Rectangle {
                Layout.preferredWidth: parent.height
                Layout.preferredHeight: parent.height
                radius: Math.min(ws.radius, width / 2) * 0.7
                color: ws.track
                clip: true
                Image {
                    anchors.fill: parent
                    source: musicWin.player ? musicWin.player.trackArtUrl : ""
                    fillMode: Image.PreserveAspectCrop
                    asynchronous: true
                    sourceSize.width: 200
                    opacity: status === Image.Ready ? 1 : 0
                    Behavior on opacity { NumberAnimation { duration: 300 } }
                }
                WIcon {
                    anchors.centerIn: parent
                    text: "󰎆"
                    font.pixelSize: ws.px(30)
                    color: ws.sub
                    visible: !musicWin.player || !musicWin.player.trackArtUrl
                }
            }
            ColumnLayout {
                Layout.fillWidth: true
                Layout.fillHeight: true
                spacing: ws.px(2)
                WText {
                    Layout.fillWidth: true
                    text: musicWin.player ? musicWin.player.trackTitle : ""
                    font.bold: true
                    font.pixelSize: ws.px(15)
                }
                WText {
                    Layout.fillWidth: true
                    text: musicWin.player ? musicWin.player.trackArtist : ""
                    color: ws.sub
                    font.pixelSize: ws.px(12)
                }
                Item { Layout.fillHeight: true }
                Rectangle {
                    Layout.fillWidth: true
                    implicitHeight: ws.px(4)
                    radius: height / 2
                    color: ws.track
                    visible: musicWin.player !== null && musicWin.player.length > 0
                    Rectangle {
                        height: parent.height
                        radius: height / 2
                        color: ws.accent
                        width: musicWin.player && musicWin.player.length > 0
                               ? parent.width * Math.min(1, musicWin.player.position / musicWin.player.length) : 0
                        Behavior on width { NumberAnimation { duration: 900 } }
                    }
                }
                RowLayout {
                    Layout.alignment: Qt.AlignHCenter
                    spacing: ws.px(18)
                    Repeater {
                        model: [
                            { icon: "󰒮", act: "previous" },
                            { icon: "play", act: "toggle" },
                            { icon: "󰒭", act: "next" }
                        ]
                        WIcon {
                            required property var modelData
                            text: modelData.icon !== "play" ? modelData.icon
                                  : (musicWin.player && musicWin.player.isPlaying ? "󰏤" : "󰐊")
                            font.pixelSize: ws.px(modelData.icon === "play" ? 22 : 17)
                            color: modelData.icon === "play" ? ws.accent : ws.fg
                            scale: tap.pressed ? 0.85 : 1
                            Behavior on scale { NumberAnimation { duration: 120 } }
                            MouseArea {
                                id: tap
                                anchors.fill: parent
                                anchors.margins: -6
                                onClicked: {
                                    const p = musicWin.player
                                    if (!p) return
                                    if (modelData.act === "toggle") p.togglePlaying()
                                    else if (modelData.act === "next") p.next()
                                    else p.previous()
                                }
                            }
                        }
                    }
                }
            }
        }
    }
{{/if}}
