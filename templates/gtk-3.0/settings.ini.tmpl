# settings.ini — GTK3 · theme: {{THEME}} · generated by hyprsetup
#
# Wayland has no XSettings, so GTK reads its settings from this file and from
# gsettings; the script writes both with the same values. Changing them with
# nwg-look updates this file too, but it is overwritten the next time the
# script runs (the old version is backed up).

[Settings]
gtk-theme-name={{GTK_THEME_NAME}}
gtk-icon-theme-name={{ICON_THEME_NAME}}
gtk-cursor-theme-name={{CURSOR_THEME}}
gtk-cursor-theme-size={{CURSOR_SIZE}}
gtk-font-name={{FONT_FAMILY}} {{FONT_SIZE}}
{{#if SYSTEM_IS_LIGHT}}
gtk-application-prefer-dark-theme=0
{{/if}}
{{#unless SYSTEM_IS_LIGHT}}
gtk-application-prefer-dark-theme=1
{{/unless}}
gtk-enable-animations=1
gtk-primary-button-warps-slider=1
gtk-toolbar-style=GTK_TOOLBAR_ICONS
gtk-menu-images=0
gtk-button-images=0
gtk-decoration-layout=appmenu:none
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle=hintslight
gtk-xft-rgba=rgb
