{{! require: TERMINAL==alacritty && HAS_ALACRITTY }}
# alacritty.toml — theme: {{THEME}} · generated by hyprsetup

[window]
padding = { x = {{TERM_PADDING_VALUE}}, y = {{TERM_PADDING_VALUE}} }
decorations = "none"
opacity = {{TERM_OPACITY_VALUE}}
dynamic_padding = true

[scrolling]
history = {{TERM_SCROLLBACK_LINES}}
multiplier = 3

[font]
size = {{TERM_FONT_SIZE_VALUE}}.0
normal = { family = "{{FONT_MONO}}", style = "Regular" }
bold   = { family = "{{FONT_MONO}}", style = "Bold" }
italic = { family = "{{FONT_MONO}}", style = "Italic" }

[cursor]
style = { shape = "{{TERM_CURSOR_ALACRITTY}}", blinking = "{{TERM_BLINK_ALACRITTY}}" }

[colors.primary]
background = "{{HEX_BG}}"
foreground = "{{HEX_FG}}"

[colors.cursor]
text   = "{{HEX_BG}}"
cursor = "{{HEX_ACCENT}}"

[colors.selection]
text       = "{{HEX_BG}}"
background = "{{HEX_ACCENT}}"

[colors.normal]
black   = "{{HEX_SURFACE}}"
red     = "{{HEX_RED}}"
green   = "{{HEX_GREEN}}"
yellow  = "{{HEX_YELLOW}}"
blue    = "{{HEX_ACCENT}}"
magenta = "{{HEX_ACCENT2}}"
cyan    = "{{HEX_CYAN}}"
white   = "{{HEX_FG}}"

[colors.bright]
black   = "{{HEX_SUBTEXT}}"
red     = "{{HEX_RED}}"
green   = "{{HEX_GREEN}}"
yellow  = "{{HEX_YELLOW}}"
blue    = "{{HEX_ACCENT}}"
magenta = "{{HEX_ACCENT2}}"
cyan    = "{{HEX_CYAN}}"
white   = "{{HEX_FG}}"
